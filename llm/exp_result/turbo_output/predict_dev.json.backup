{
    "0": "SELECTMAX(`Percent (%) Eligible Free (K-12)`) \nFROM frpm \nWHERE `County Name` = 'Alameda County'\t----- bird -----\tcalifornia_schools",
    "1": "SELECT`School Name`, `Percent (%) Eligible Free (Ages 5-17)`\nFROM frpm\nWHERE `Educational Option Type` = 'Continuation School'\nORDER BY `Percent (%) Eligible Free (Ages 5-17)`\nLIMIT 3\t----- bird -----\tcalifornia_schools",
    "2": "SELECTschools.Zip\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE schools.County = 'Fresno County Office of Education'\nAND frpm.`Charter School (Y/N)` = 1\t----- bird -----\tcalifornia_schools",
    "3": "SELECTschools.MailStreet\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nORDER BY frpm.`FRPM Count (K-12)` DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "4": "SELECTschools.Phone\nFROM schools\nWHERE schools.FundingType = 'Charter'\nAND schools.OpenDate > '2000-01-01'\t----- bird -----\tcalifornia_schools",
    "5": "SELECTCOUNT(*) \nFROM schools s\nJOIN satscores ss ON s.CDSCode = ss.cds\nWHERE ss.AvgScrMath > 400\nAND s.Virtual = 'Yes'\t----- bird -----\tcalifornia_schools",
    "6": "SELECTs.School\nFROM schools s\nJOIN satscores ss ON s.CDSCode = ss.cds\nWHERE ss.NumTstTakr > 500\nAND (s.Magnet = 1 OR s.GSoffered LIKE '%Magnet%')\t----- bird -----\tcalifornia_schools",
    "7": "SELECTschools.Phone\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nWHERE satscores.NumGE1500 = (SELECT MAX(NumGE1500) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "8": "SELECTsatscores.NumTstTakr\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nJOIN satscores ON frpm.CDSCode = satscores.cds\nWHERE frpm.`FRPM Count (K-12)` = (SELECT MAX(`FRPM Count (K-12)`) FROM frpm)\t----- bird -----\tcalifornia_schools",
    "9": "SELECTCOUNT(*) \nFROM schools \nJOIN satscores ON schools.CDSCode = satscores.cds \nWHERE satscores.AvgScrMath > 560 AND schools.FundingType = 'Charter'\t----- bird -----\tcalifornia_schools",
    "10": "SELECTfrpm.`FRPM Count (Ages 5-17)`\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nJOIN frpm ON frpm.CDSCode = schools.CDSCode\nWHERE satscores.AvgScrRead = (SELECT MAX(AvgScrRead) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "11": "SELECTCDSCode\nFROM frpm\nWHERE `Enrollment (K-12)` > 500\t----- bird -----\tcalifornia_schools",
    "12": "SELECTMAX(`Percent (%) Eligible Free (Ages 5-17)`)\nFROM frpm\nWHERE CDSCode IN (\n    SELECT cds\n    FROM satscores\n    WHERE NumGE1500 / NumTstTakr > 0.3\n)\t----- bird -----\tcalifornia_schools",
    "13": "SELECTschools.Phone\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nORDER BY satscores.NumGE1500 DESC\nLIMIT 3\t----- bird -----\tcalifornia_schools",
    "14": "SELECTschools.`NCESchool`, schools.`School`\nFROM frpm\nJOIN schools ON frpm.`CDSCode` = schools.`CDSCode`\nORDER BY frpm.`Enrollment (Ages 5-17)` DESC\nLIMIT 5\t----- bird -----\tcalifornia_schools",
    "15": "SELECTsatscores.dname, MAX(satscores.AvgScrRead) AS HighestAvgReadingScore\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.StatusType = 'Active'\nGROUP BY satscores.dname\nORDER BY HighestAvgReadingScore DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "16": "SELECTCOUNT(*)\nFROM satscores s\nJOIN schools sc ON s.cds = sc.CDSCode\nWHERE sc.County = 'Alameda' AND s.NumTstTakr < 100\t----- bird -----\tcalifornia_schools",
    "17": "SELECTsatscores.sname, satscores.AvgScrWrite, schools.CharterNum\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.AvgScrWrite > 499\nORDER BY satscores.AvgScrWrite DESC\t----- bird -----\tcalifornia_schools",
    "18": "SELECTCOUNT(*)\nFROM schools s\nJOIN satscores ss ON s.CDSCode = ss.cds\nWHERE s.County = 'Fresno' AND s.FundingType = 'Directly funded' AND ss.NumTstTakr <= 250\t----- bird -----\tcalifornia_schools",
    "19": "SELECTschools.Phone\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.AvgScrMath = (SELECT MAX(AvgScrMath) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "20": "SELECTCOUNT(*) \nFROM frpm \nJOIN schools ON frpm.CDSCode = schools.CDSCode \nWHERE `County Name` = 'Amador' AND `Low Grade` = '9' AND `High Grade` = '12'\t----- bird -----\tcalifornia_schools",
    "21": "SELECTCOUNT(*) \nFROM frpm \nWHERE `County Name` = 'Los Angeles' \nAND `Free Meal Count (K-12)` > 500 \nAND `Free Meal Count (K-12)` < 700\t----- bird -----\tcalifornia_schools",
    "22": "SELECTsatscores.sname, satscores.NumTstTakr\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.County = 'Contra Costa'\nORDER BY satscores.NumTstTakr DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "23": "SELECTschools.School, schools.Street\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nWHERE ABS(frpm.\"Enrollment (K-12)\" - frpm.\"Enrollment (Ages 5-17)\") > 30\t----- bird -----\tcalifornia_schools",
    "24": "SELECTs.School\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nJOIN satscores ss ON f.CDSCode = ss.cds\nWHERE f.`Percent (%) Eligible Free (K-12)` > 0.1\nAND ss.NumGE1500 > 0\t----- bird -----\tcalifornia_schools",
    "25": "SELECTs.School\nFROM schools s\nJOIN satscores ss ON s.CDSCode = ss.cds\nWHERE s.County = 'Riverside'\nAND ss.AvgScrMath > 400\t----- bird -----\tcalifornia_schools",
    "26": "SELECTs.School, s.Street, s.City, s.Zip\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nWHERE f.`County Name` = 'Monterey'\nAND f.`School Type` = 'High'\nAND f.`Free Meal Count (Ages 5-17)` > 800\t----- bird -----\tcalifornia_schools",
    "27": "SELECTsatscores.sname, satscores.AvgScrWrite, schools.Phone\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.OpenDate > '1991-01-01' OR schools.ClosedDate < '2000-01-01'\t----- bird -----\tcalifornia_schools",
    "28": "SELECTs.School, s.DOCType\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nWHERE f.`Enrollment (K-12)` - f.`Enrollment (Ages 5-17)` > \n    (SELECT AVG(`Enrollment (K-12)` - `Enrollment (Ages 5-17)`)\n     FROM frpm\n     WHERE `Charter Funding Type` = 'Locally Funded')\t----- bird -----\tcalifornia_schools",
    "29": "SELECTMIN(OpenDate) \nFROM schools \nWHERE StatusType = 'Active' \nAND GSoffered LIKE '%12%' \nAND Enrollment = (SELECT MAX(Enrollment) FROM schools WHERE StatusType = 'Active' AND GSoffered LIKE '%12%')\t----- bird -----\tcalifornia_schools",
    "30": "SELECT schools.City\nFROM schools\nORDER BY schools.enroll12\nLIMIT 5\t----- bird -----\tcalifornia_schools",
    "31": "SELECTfrpm.`Percent (%) Eligible Free (K-12)`\nFROM frpm\nORDER BY frpm.`Enrollment (K-12)` DESC\nLIMIT 10, 2\t----- bird -----\tcalifornia_schools",
    "32": "SELECTfrpm.`School Name`, \n       frpm.`Percent (%) Eligible FRPM (K-12)` \nFROM frpm \nJOIN schools ON frpm.CDSCode = schools.CDSCode \nWHERE frpm.`School Type` = '1-12' \nAND frpm.`Charter School Number` = '66' \nORDER BY frpm.`FRPM Count (K-12)` DESC \nLIMIT 5\t----- bird -----\tcalifornia_schools",
    "33": "SELECTs.School, s.Website\nFROM frpm f\nJOIN schools s ON f.CDSCode = s.CDSCode\nWHERE f.`Free Meal Count (Ages 5-17)` >= 1900 AND f.`Free Meal Count (Ages 5-17)` <= 2000\t----- bird -----\tcalifornia_schools",
    "34": "SELECT`Percent (%) Eligible Free (Ages 5-17)` \nFROM frpm\nWHERE `School Name` = 'Kacey Gibson'\t----- bird -----\tcalifornia_schools",
    "35": "SELECTschools.AdmEmail1\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE schools.Charter = 1\nORDER BY frpm.Enrollment (K-12)\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "36": "SELECTsatscores.sname, satscores.dname, satscores.NumGE1500, schools.AdmFName1, schools.AdmLName1\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.NumGE1500 = (SELECT MAX(NumGE1500) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "37": "SELECTschools.Street, schools.City, schools.Zip, schools.State\nFROM schools\nWHERE schools.CDSCode = (\n    SELECT frpm.CDSCode\n    FROM frpm\n    ORDER BY frpm.`Percent (%) Eligible FRPM (Ages 5-17)` ASC\n    LIMIT 1\n)\t----- bird -----\tcalifornia_schools",
    "38": "SELECTschools.Website\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nWHERE schools.County = 'Los Angeles County'\nAND satscores.NumTstTakr BETWEEN 2000 AND 3000\t----- bird -----\tcalifornia_schools",
    "39": "SELECTAVG(NumTstTakr)\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.County = 'Fresno'\nAND schools.OpenDate BETWEEN '1980-01-01' AND '1980-12-31'\t----- bird -----\tcalifornia_schools",
    "40": "SELECTschools.Phone\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nWHERE schools.District = 'Fresno Unified'\nORDER BY satscores.AvgScrRead\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "41": "SELECTsatscores.sname\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.Virtual = 'Yes'\nAND satscores.rtype = 'County'\nAND satscores.AvgScrRead IS NOT NULL\nAND satscores.AvgScrRead > (\n    SELECT AVG(AvgScrRead)\n    FROM satscores\n    WHERE rtype = 'County'\n    AND AvgScrRead IS NOT NULL\n    AND satscores.cname = schools.County\n)\nORDER BY satscores.AvgScrRead DESC\nLIMIT 5\t----- bird -----\tcalifornia_schools",
    "42": "SELECT`School Type`\nFROM frpm\nWHERE CDSCode = (\n    SELECT cds\n    FROM satscores\n    WHERE AvgScrMath = (\n        SELECT MAX(AvgScrMath)\n        FROM satscores\n    )\n)\t----- bird -----\tcalifornia_schools",
    "43": "SELECTsatscores.AvgScrMath, schools.County\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.AvgScrMath = (SELECT MIN(AvgScrMath) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "44": "SELECTsatscores.AvgScrWrite, schools.City\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.NumTstTakr = (SELECT MAX(NumTstTakr) FROM satscores WHERE NumGE1500 > 0)\nAND satscores.NumGE1500 > 0\t----- bird -----\tcalifornia_schools",
    "45": "SELECTs.School, s.CDSCode, ss.AvgScrWrite\nFROM schools s\nJOIN satscores ss ON s.CDSCode = ss.cds\nWHERE s.AdmFName1 = 'Ricci' AND s.AdmLName1 = 'Ulrich'\t----- bird -----\tcalifornia_schools",
    "46": "SELECTschools.State, \n       SUM(satscores.enroll12) as Total_Enrollment\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nWHERE schools.StatusType = 'State Special'\nGROUP BY schools.State\nORDER BY Total_Enrollment DESC\t----- bird -----\tcalifornia_schools",
    "47": "SELECTCOUNT(School)\nFROM schools\nWHERE County = 'Alameda' AND District = 'Elementary School District' AND OpenDate LIKE '1980%'\t----- bird -----\tcalifornia_schools",
    "48": "SELECTCOUNT(DISTINCT schools.CDSCode) \nFROM schools \nWHERE schools.District LIKE '%Unified School District%' AND schools.County = 'Orange County'\t----- bird -----\tcalifornia_schools",
    "49": "SELECTschools.County, schools.School, schools.ClosedDate\nFROM schools\nWHERE schools.StatusType = 'Closed'\nGROUP BY schools.County\nORDER BY COUNT(schools.School) DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "50": "SELECTs.School, s.Street, s.City, s.Zip\nFROM satscores ss\nJOIN schools s ON ss.cds = s.CDSCode\nWHERE ss.AvgScrMath IS NOT NULL\nORDER BY ss.AvgScrMath DESC\nLIMIT 1 OFFSET 6\t----- bird -----\tcalifornia_schools",
    "51": "SELECTschools.MailStreet, satscores.sname\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.AvgScrRead = (SELECT MIN(AvgScrRead) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "52": "SELECTCOUNT(*) \nFROM satscores \nJOIN schools ON satscores.cds = schools.CDSCode \nWHERE NumGE1500 > 0 \nAND MailCity = 'Lakeport'\t----- bird -----\tcalifornia_schools",
    "53": "SELECTSUM(NumTstTakr)\nFROM satscores\nWHERE cds IN (SELECT CDSCode FROM schools WHERE MailCity = 'Fresno')\t----- bird -----\tcalifornia_schools",
    "54": "SELECTschools.School, schools.MailZip\nFROM schools\nWHERE schools.AdmFName1 = 'Avetik' AND schools.AdmLName1 = 'Atoian'\nOR schools.AdmFName2 = 'Avetik' AND schools.AdmLName2 = 'Atoian'\nOR schools.AdmFName3 = 'Avetik' AND schools.AdmLName3 = 'Atoian'\t----- bird -----\tcalifornia_schools",
    "55": "SELECTCOUNT(*) as Colusa_count\nFROM schools\nWHERE MailState = 'CA' AND County = 'Colusa';\t----- bird -----\tcalifornia_schools",
    "56": "SELECTCOUNT(*)\nFROM schools\nWHERE State = 'CA' \nAND City = 'San Joaquin'\nAND StatusType = 'Active'\t----- bird -----\tcalifornia_schools",
    "57": "SELECTschools.Phone, schools.Ext\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.AvgScrWrite = (\n    SELECT AvgScrWrite\n    FROM satscores\n    ORDER BY AvgScrWrite DESC\n    LIMIT 1 OFFSET 332\n)\t----- bird -----\tcalifornia_schools",
    "58": "SELECTschools.`Phone`, schools.`Ext`, schools.`School`\nFROM schools\nWHERE schools.`Zip` = '95203-3704'\t----- bird -----\tcalifornia_schools",
    "59": "SELECTWebsite\nFROM schools\nWHERE (AdmFName1 = 'Mike' AND AdmLName1 = 'Larson') OR (AdmFName2 = 'Mike' AND AdmLName2 = 'Larson') OR (AdmFName3 = 'Mike' AND AdmLName3 = 'Larson') OR (AdmFName1 = 'Dante' AND AdmLName1 = 'Alvarez') OR (AdmFName2 = 'Dante' AND AdmLName2 = 'Alvarez') OR (AdmFName3 = 'Dante' AND AdmLName3 = 'Alvarez')\t----- bird -----\tcalifornia_schools",
    "60": "SELECTschools.Website\nFROM schools\nWHERE schools.Virtual = 'Partially'\nAND schools.Charter = 1\nAND schools.County = 'San Joaquin'\t----- bird -----\tcalifornia_schools",
    "61": "SELECTCOUNT(*)\nFROM schools s\nJOIN frpm f ON s.CDSCode = f.CDSCode\nWHERE s.City = 'Hickman' \nAND s.Charter = 1 \nAND s.District = 'Elementary School District'\t----- bird -----\tcalifornia_schools",
    "62": "SELECTCOUNT(*) \nFROM schools s\nJOIN frpm f ON s.CDSCode = f.CDSCode\nWHERE s.County = 'Los Angeles' \nAND s.Charter = 0 \nAND f.`Percent (%) Eligible Free (K-12)` < 0.18\t----- bird -----\tcalifornia_schools",
    "63": "SELECTschools.School, schools.City, schools.AdmFName1, schools.AdmLName1, schools.AdmFName2, schools.AdmLName2, schools.AdmFName3, schools.AdmLName3\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE frpm.`Charter School (Y/N)` = 1 AND frpm.`Charter School Number` = '00D2'\t----- bird -----\tcalifornia_schools",
    "64": "SELECTCOUNT(*)\nFROM schools\nWHERE MailCity = 'Hickman' AND CharterNum = '00D4'\t----- bird -----\tcalifornia_schools",
    "65": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM schools WHERE County = 'Santa Clara' AND FundingType = 'Locally Funded') AS LocallyFundedRatio\nFROM schools\nWHERE County = 'Santa Clara' AND Charter = 1\t----- bird -----\tcalifornia_schools",
    "66": "SELECTCOUNT(*) \nFROM schools \nWHERE OpenDate BETWEEN '2000-01-01' AND '2005-12-31' \nAND County = 'Stanislaus' \nAND FundingType = 'Direct'\t----- bird -----\tcalifornia_schools",
    "67": "SELECTSUM(NumTstTakr)\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE schools.City = 'San Francisco'\nAND schools.StatusType = 'Closed'\nAND schools.DOCType = 'Community College District'\nAND schools.ClosedDate LIKE '%1989%'\t----- bird -----\tcalifornia_schools",
    "68": "SELECTschools.County, COUNT(schools.ClosedDate) AS NumSchoolClosures\nFROM schools\nWHERE schools.ClosedDate BETWEEN '1980-01-01' AND '1989-12-31'\nAND schools.SOC = 'CEA'\nGROUP BY schools.County\nORDER BY NumSchoolClosures DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "69": "SELECTschools.NCESDist\nFROM schools\nWHERE schools.SOC = '1' AND schools.SOCType = '1'\t----- bird -----\tcalifornia_schools",
    "70": "SELECTCOUNT(*)\nFROM schools\nWHERE County = 'Alpine'\nAND StatusType IN ('Active', 'Closed')\nAND School = 'District Community Day School'\t----- bird -----\tcalifornia_schools",
    "71": "SELECTfrpm.`District Code`\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nWHERE schools.City = 'Fresno' AND schools.GSoffered != 'Magnet'\t----- bird -----\tcalifornia_schools",
    "72": "SELECT`Enrollment (Ages 5-17)` \nFROM frpm\nWHERE `School Name` = 'State Special School'\nAND `City` = 'Fremont'\nAND `Academic Year` = '2014-2015'\t----- bird -----\tcalifornia_schools",
    "73": "SELECTfrpm.`Free Meal Count (Ages 5-17)`\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nWHERE schools.School = 'Youth Authority School' \nAND schools.MailStreet = 'PO Box 1040'\t----- bird -----\tcalifornia_schools",
    "74": "SELECT`Low Grade`\nFROM frpm\nWHERE `District Code` = 0613360\nAND `School Type` = 'District Special Education Consortia School'\nAND `District Type` = 'National Center for Educational Statistics'\t----- bird -----\tcalifornia_schools",
    "75": "SELECTschools.`School Name`, frpm.`Educational Option Type`\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE frpm.`NSLP Provision Status` = 'Breakfast Provision 2' AND frpm.`County Code` = '37'\t----- bird -----\tcalifornia_schools",
    "76": "SELECTschools.City\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE frpm.`School Type` = 'High School'\nAND frpm.`NSLP Provision Status` = 'Lunch Provision 2'\nAND frpm.`Low Grade` = '9'\nAND frpm.`High Grade` = '12'\nAND schools.County = 'Merced'\t----- bird -----\tcalifornia_schools",
    "77": "SELECTschools.`School`, frpm.`Percent (%) Eligible FRPM (Ages 5-17)`\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE schools.`County` = 'Los Angeles' \nAND schools.`GSserved` = 'KG-9'\t----- bird -----\tcalifornia_schools",
    "78": "SELECTschools.`City`, schools.`GSserved`, COUNT(schools.`GSserved`) AS `Count`\nFROM schools\nWHERE schools.`City` = 'Adelanto'\nGROUP BY schools.`GSserved`\nORDER BY `Count` DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "79": "SELECTCOUNT(*) AS NumVirtualSchools, County\nFROM schools\nWHERE Virtual = 'Yes' AND County IN ('San Diego', 'Santa Barbara')\nGROUP BY County\nORDER BY NumVirtualSchools DESC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "80": "SELECTSchoolType, SchoolName, Latitude\nFROM schools\nWHERE Latitude = (SELECT MAX(Latitude) FROM schools)\t----- bird -----\tcalifornia_schools",
    "81": "SELECTschools.City, schools.School, schools.`Low Grade`\nFROM schools\nWHERE schools.State = 'CA'\nORDER BY schools.Latitude ASC\nLIMIT 1\t----- bird -----\tcalifornia_schools",
    "82": "SELECTschools.`High Grade`\nFROM schools\nWHERE schools.Longitude = (SELECT MAX(Longitude) FROM schools)\t----- bird -----\tcalifornia_schools",
    "83": "SELECTCOUNT(DISTINCT CDSCode)\nFROM schools\nWHERE GSoffered = 'K-8'\nAND Magnet = 1\t----- bird -----\tcalifornia_schools",
    "84": "SELECTAdmFName1, COUNT(*) AS Count\nFROM schools\nGROUP BY AdmFName1\nORDER BY Count DESC\nLIMIT 2\t----- bird -----\tcalifornia_schools",
    "85": "SELECTfrpm.`Percent (%) Eligible Free (K-12)`, frpm.`District Code`\nFROM frpm\nJOIN schools ON frpm.CDSCode = schools.CDSCode\nWHERE schools.AdmFName1 = 'Alusine'\t----- bird -----\tcalifornia_schools",
    "86": "SELECTschools.AdmLName1, schools.District, schools.County, schools.School\nFROM schools\nJOIN satscores ON schools.CDSCode = satscores.cds\nWHERE schools.CharterNum = '40'\t----- bird -----\tcalifornia_schools",
    "87": "SELECTschools.AdmEmail1, schools.AdmEmail2, schools.AdmEmail3\nFROM schools\nJOIN frpm ON schools.CDSCode = frpm.CDSCode\nWHERE schools.County = 'San Bernardino' \nAND schools.City = 'San Bernardino'\nAND schools.District = 'San Bernardino City Unified'\nAND schools.OpenDate BETWEEN '2009-01-01' AND '2010-12-31'\nAND (schools.School = 'Intermediate/Middle Schools' OR schools.School = 'Unified Schools')\nAND schools.StatusType = 'Public'\t----- bird -----\tcalifornia_schools",
    "88": "SELECTsatscores.sname, schools.AdmEmail1\nFROM satscores\nJOIN schools ON satscores.cds = schools.CDSCode\nWHERE satscores.NumGE1500 = (SELECT MAX(NumGE1500) FROM satscores)\t----- bird -----\tcalifornia_schools",
    "89": "SELECTCOUNT(account.account_id)\nFROM account\nJOIN card ON account.account_id = card.account_id\nJOIN disp ON account.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nJOIN district ON account.district_id = district.district_id\nWHERE card.issued > account.date\nAND district.A2 = 'East Bohemia'\t----- bird -----\tfinancial",
    "90": "SELECTCOUNT(*) \nFROM account \nJOIN district ON account.district_id = district.district_id \nWHERE district.A6 = 'Prague'\t----- bird -----\tfinancial",
    "91": "SELECTAVG(A12) AS avg_unemployment_ratio_1995,\n       AVG(A13) AS avg_unemployment_ratio_1996\nFROM district\t----- bird -----\tfinancial",
    "92": "SELECTCOUNT(*) \nFROM district \nWHERE A2 = 'F' AND A11 > 6000 AND A11 < 10000\t----- bird -----\tfinancial",
    "93": "SELECTCOUNT(client_id)\nFROM client\nJOIN district ON client.district_id = district.district_id\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nWHERE client.gender = 'M'\nAND district.A2 = 'North Bohemia'\nAND district.A11 > 8000\t----- bird -----\tfinancial",
    "94": "SELECTaccount.account_id\nFROM account\nJOIN disp ON account.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nWHERE client.gender = 'F'\nGROUP BY client.client_id\nORDER BY client.birth_date ASC\nLIMIT 1\t----- bird -----\tfinancial",
    "95": "SELECTaccount_id\nFROM account\nJOIN disp ON account.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nWHERE client.birth_date = (SELECT MIN(birth_date) FROM client)\nGROUP BY account_id\nORDER BY AVG(A12) DESC\t----- bird -----\tfinancial",
    "96": "SELECTCOUNT(*) \nFROM disp \nJOIN card ON disp.disp_id = card.disp_id \nJOIN account ON disp.account_id = account.account_id \nWHERE account.frequency = 'weekly' AND disp.type = 'Owner'\t----- bird -----\tfinancial",
    "97": "SELECTclient.client_id\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE card.type = 'Disponent'\nAND disp.type = 'OWNER'\t----- bird -----\tfinancial",
    "98": "SELECTaccount_id, MIN(amount) as lowest_approved_amount\nFROM loan\nWHERE date LIKE '1997%'\nGROUP BY account_id\nHAVING frequency = 'weekly'\t----- bird -----\tfinancial",
    "99": "SELECTaccount_id, amount\nFROM loan\nJOIN account ON loan.account_id = account.account_id\nWHERE duration > 12\nAND date LIKE '1993%'\nORDER BY amount DESC\nLIMIT 1\t----- bird -----\tfinancial",
    "100": "SELECTCOUNT(client.client_id)\nFROM client\nJOIN district ON client.district_id = district.district_id\nWHERE client.gender = 'F' \nAND client.birth_date < '1950-01-01' \nAND district.A2 = 'Sokolov'\t----- bird -----\tfinancial",
    "101": "SELECTaccount_id\nFROM account\nWHERE date = (SELECT MIN(date) FROM account WHERE date LIKE '1995%')\t----- bird -----\tfinancial",
    "102": "SELECTaccount_id\nFROM account\nWHERE date < '1997-01-01' AND account_id IN (\n    SELECT account_id\n    FROM trans\n    WHERE amount > 3000\n)\t----- bird -----\tfinancial",
    "103": "SELECTclient_id\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE card.issued = '1994-03-03'\t----- bird -----\tfinancial",
    "104": "SELECTMIN(date) AS account_opened_date\nFROM account\nWHERE account_id IN (SELECT account_id FROM trans WHERE amount = 840 AND date = '1998-10-14')\t----- bird -----\tfinancial",
    "105": "SELECTdistrict_id\nFROM account\nWHERE account_id IN (\n    SELECT account_id\n    FROM loan\n    WHERE date = '1994-08-25'\n)\t----- bird -----\tfinancial",
    "106": "SELECTMAX(amount) \nFROM trans \nWHERE account_id IN \n    (SELECT account_id \n     FROM disp \n     WHERE disp_id IN \n         (SELECT disp_id \n          FROM card \n          WHERE issued = '1996-10-21'))\t----- bird -----\tfinancial",
    "107": "SELECTc.gender\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN district dis ON c.district_id = dis.district_id\nWHERE c.birth_date = (SELECT MIN(birth_date) FROM client)\nAND dis.A11 = (SELECT MAX(A11) FROM district)\t----- bird -----\tfinancial",
    "108": "SELECTtrans.amount\nFROM loan\nJOIN account ON loan.account_id = account.account_id\nJOIN disp ON account.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nJOIN trans ON account.account_id = trans.account_id\nWHERE loan.amount = (SELECT MAX(amount) FROM loan)\nORDER BY trans.date\nLIMIT 1\t----- bird -----\tfinancial",
    "109": "SELECTCOUNT(client_id) \nFROM client \nWHERE district_id = (SELECT district_id FROM district WHERE A2 = 'Jesenik') \nAND gender = 'F'\t----- bird -----\tfinancial",
    "110": "SELECTdisp_id\nFROM trans\nWHERE amount = 5100\nAND date = '1998-09-02'\t----- bird -----\tfinancial",
    "111": "SELECTCOUNT(account_id) \nFROM account \nWHERE district_id = (SELECT district_id FROM district WHERE A2 = 'Litomerice') \nAND date >= '1996-01-01' \nAND date <= '1996-12-31'\t----- bird -----\tfinancial",
    "112": "SELECTd.A2\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN district dis ON a.district_id = dis.district_id\nWHERE c.gender = 'F' AND c.birth_date = '1976-01-29'\t----- bird -----\tfinancial",
    "113": "SELECTc.birth_date\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN loan l ON a.account_id = l.account_id\nWHERE l.amount = 98832 AND l.date = '1996-01-03'\t----- bird -----\tfinancial",
    "114": "SELECTaccount_id\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nJOIN district ON client.district_id = district.district_id\nWHERE district.A3 = 'Prague'\nORDER BY account.date\nLIMIT 1\t----- bird -----\tfinancial",
    "115": "SELECT\n    COUNT(client_id) AS total_clients,\n    SUM(CASE WHEN gender = 'M' THEN 1 ELSE 0 END) AS male_clients\nFROM client\nWHERE district_id IN (\n    SELECT district_id\n    FROM district\n    WHERE A2 = 'south Bohemia'\n    ORDER BY A9 DESC\n    LIMIT 1\n)\t----- bird -----\tfinancial",
    "116": "SELECTc.client_id, \n       AVG(t.balance) AS avg_balance,\n       (MAX(t.balance) - MIN(t.balance)) / MIN(t.balance) AS increase_rate\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN trans t ON a.account_id = t.account_id\nJOIN loan l ON a.account_id = l.account_id\nWHERE l.date = '1993-07-05'\n      AND t.date BETWEEN '1993-03-22' AND '1998-12-27'\nGROUP BY c.client_id\t----- bird -----\tfinancial",
    "117": "SELECTSUM(amount) as total_loan_amount,\n       SUM(CASE WHEN status = 'A' THEN amount ELSE 0 END) as fully_paid_amount\nFROM loan\nWHERE status = 'A'\t----- bird -----\tfinancial",
    "118": "SELECT\nCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM loan WHERE amount < 100000 AND status = 'A') \nFROM loan \nWHERE amount < 100000 AND status = 'A'\t----- bird -----\tfinancial",
    "119": "SELECTaccount.account_id, district.A2, district.A3\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE account.date >= '1993-01-01'\nAND account.frequency = 'monthly'\t----- bird -----\tfinancial",
    "120": "SELECTaccount.account_id, account.frequency\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE district.A2 = 'east Bohemia'\nAND account.date BETWEEN '1995-01-01' AND '2000-12-31'\t----- bird -----\tfinancial",
    "121": "SELECTaccount_id, date\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE district.A2 = 'Prachatice'\t----- bird -----\tfinancial",
    "122": "SELECTd.A2, d.A3\nFROM loan l\nJOIN account a ON l.account_id = a.account_id\nJOIN district d ON a.district_id = d.district_id\nWHERE l.loan_id = 4990\t----- bird -----\tfinancial",
    "123": "SELECTaccount.account_id, district.A2, district.A3\nFROM loan\nJOIN account ON loan.account_id = account.account_id\nJOIN district ON account.district_id = district.district_id\nWHERE loan.amount > 300000\t----- bird -----\tfinancial",
    "124": "SELECTloan.loan_id, district.A2, district.A11\nFROM loan\nJOIN account ON loan.account_id = account.account_id\nJOIN district ON account.district_id = district.district_id\nWHERE loan.duration = 60\t----- bird -----\tfinancial",
    "125": "SELECTd.A2 AS district,\n    ((d.A12 - d.A11) / d.A11) * 100 AS unemployment_rate_increment\nFROM loan l\nJOIN account a ON l.account_id = a.account_id\nJOIN disp dp ON a.account_id = dp.account_id\nJOIN client c ON dp.client_id = c.client_id\nJOIN district d ON c.district_id = d.district_id\nWHERE l.status = 'A' \nAND l.date >= '1995-01-01' \nAND l.date <= '1996-12-31' \nAND l.amount > 0\t----- bird -----\tfinancial",
    "126": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM account WHERE district_id = (SELECT district_id FROM district WHERE A2 = 'Decin')) \nFROM account \nWHERE date >= '1993-01-01' AND date <= '1993-12-31' AND district_id = (SELECT district_id FROM district WHERE A2 = 'Decin')\t----- bird -----\tfinancial",
    "127": "SELECTaccount_id\nFROM account\nWHERE frequency = 'POPLATEK MESICNE'\t----- bird -----\tfinancial",
    "128": "SELECTd.A2 AS district_name, \n       COUNT(c.client_id) AS female_account_holders\nFROM district d\nJOIN client c ON d.district_id = c.district_id\nJOIN disp dp ON c.client_id = dp.client_id\nJOIN account a ON dp.account_id = a.account_id\nWHERE c.gender = 'F'\nGROUP BY d.district_id\nORDER BY female_account_holders DESC\nLIMIT 9\t----- bird -----\tfinancial",
    "129": "SELECTd.A2 AS district_name, SUM(t.amount) AS total_withdrawals\nFROM trans t\nJOIN account a ON t.account_id = a.account_id\nJOIN district d ON a.district_id = d.district_id\nWHERE t.type = 'Withdrawal' AND t.date BETWEEN '1996-01-01' AND '1996-01-31'\nGROUP BY d.A2\nORDER BY total_withdrawals DESC\nLIMIT 10\t----- bird -----\tfinancial",
    "130": "SELECTCOUNT(account.account_id)\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE district.A6 = 'South Bohemia'\nAND account.account_id NOT IN (SELECT disp.account_id FROM disp WHERE disp.type = 'OWNER')\t----- bird -----\tfinancial",
    "131": "SELECTA2\nFROM district\nWHERE district_id = (\n    SELECT district_id\n    FROM account\n    WHERE account_id = (\n        SELECT account_id\n        FROM loan\n        WHERE status = 'A'\n        GROUP BY account_id\n        ORDER BY COUNT(account_id) DESC\n        LIMIT 1\n    )\n)\t----- bird -----\tfinancial",
    "132": "SELECTAVG(amount) \nFROM loan \nJOIN account ON loan.account_id = account.account_id \nJOIN disp ON account.account_id = disp.account_id \nJOIN client ON disp.client_id = client.client_id \nWHERE client.gender = 'M'\t----- bird -----\tfinancial",
    "133": "SELECTdistrict.A2 AS branch_location, district.A3 AS district_name\nFROM district\nWHERE district.A11 = (\n    SELECT MAX(A11)\n    FROM district\n    WHERE A11 <> 0\n)\nORDER BY district.A11 DESC\t----- bird -----\tfinancial",
    "134": "SELECTCOUNT(account_id) \nFROM account \nWHERE district_id IN \n    (SELECT district_id \n     FROM district \n     WHERE district_id IN \n         (SELECT district_id \n          FROM trans \n          WHERE date BETWEEN '1996-01-01' AND '1996-12-31' \n          GROUP BY district_id \n          ORDER BY COUNT(trans_id) DESC \n          LIMIT 1)\n    )\t----- bird -----\tfinancial",
    "135": "SELECTCOUNT(account.account_id)\nFROM account\nJOIN disp ON account.account_id = disp.account_id\nJOIN card ON disp.disp_id = card.disp_id\nJOIN trans ON account.account_id = trans.account_id\nWHERE card.type = 'credit' \nAND trans.type = 'withdrawal' \nAND account.frequency = 'monthly' \nAND trans.balance < 0\t----- bird -----\tfinancial",
    "136": "SELECTCOUNT(*) \nFROM loan \nJOIN account ON loan.account_id = account.account_id \nWHERE date BETWEEN '1995-01-01' AND '1997-12-31' \nAND amount >= 250000 \nAND frequency = 'monthly' \nAND status = 'approved'\t----- bird -----\tfinancial",
    "137": "SELECTCOUNT(*) \nFROM account \nWHERE district_id = 1\t----- bird -----\tfinancial",
    "138": "SELECTCOUNT(client_id) \nFROM client \nWHERE district_id = (\n    SELECT district_id \n    FROM (\n        SELECT district_id, \n               RANK() OVER (ORDER BY A15 DESC) as rnk \n        FROM district \n        WHERE A11 = 1995\n    ) \n    WHERE rnk = 2\n) \nAND gender = 'M'\t----- bird -----\tfinancial",
    "139": "SELECTCOUNT(*) \nFROM card \nJOIN disp ON card.disp_id = disp.disp_id \nWHERE disp.type = 'OWNER' \nAND card.type = 'credit card'\t----- bird -----\tfinancial",
    "140": "SELECTCOUNT(*) \nFROM account \nWHERE district_id = (SELECT district_id FROM district WHERE A2 = 'Pisek')\t----- bird -----\tfinancial",
    "141": "SELECTd.A2, SUM(t.amount) as total_transactions\nFROM district d\nJOIN account a ON d.district_id = a.district_id\nJOIN trans t ON a.account_id = t.account_id\nWHERE t.date BETWEEN '1997-01-01' AND '1997-12-31'\nGROUP BY d.A2\nHAVING total_transactions > 10000\t----- bird -----\tfinancial",
    "142": "SELECTaccount.account_id\nFROM account\nJOIN `order` ON account.account_id = `order`.account_id\nWHERE `order`.k_symbol = 'household'\nAND account.district_id = (SELECT district_id FROM district WHERE A2 = 'Pisek')\t----- bird -----\tfinancial",
    "143": "SELECTaccount.account_id\nFROM account\nJOIN disp ON account.account_id = disp.account_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE card.type = 'gold'\t----- bird -----\tfinancial",
    "144": "SELECTAVG(amount) \nFROM card\nWHERE issued >= '2021-01-01' AND issued < '2022-01-01'\t----- bird -----\tfinancial",
    "145": "SELECTdisp.client_id\nFROM disp\nJOIN account ON disp.account_id = account.account_id\nJOIN trans ON account.account_id = trans.account_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE card.type = 'credit'\nAND trans.amount < (SELECT AVG(trans.amount) FROM trans WHERE strftime('%Y', trans.date) = '1998')\nAND strftime('%Y', trans.date) = '1998'\t----- bird -----\tfinancial",
    "146": "SELECTclient.client_id, client.gender\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nJOIN account ON disp.account_id = account.account_id\nJOIN loan ON account.account_id = loan.account_id\nWHERE client.gender = 'FEMALE'\t----- bird -----\tfinancial",
    "147": "SELECTCOUNT(*) \nFROM client \nWHERE gender = 'F' \nAND district_id IN (SELECT district_id FROM district WHERE A2 = 'South Bohemia')\t----- bird -----\tfinancial",
    "148": "SELECTaccount.account_id\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE district.A2 = 'Tabor'\t----- bird -----\tfinancial",
    "149": "SELECTDISTINCT type\nFROM disp\nWHERE type NOT IN ('OWNER', 'DISPONENT')\nAND account_id IN (\n    SELECT account_id\n    FROM account\n    WHERE district_id IN (\n        SELECT district_id\n        FROM district\n        WHERE A10 > 8000 AND A10 <= 9000\n    )\n)\t----- bird -----\tfinancial",
    "150": "SELECTCOUNT(DISTINCT account_id)\nFROM account\nJOIN trans ON account.account_id = trans.account_id\nJOIN district ON account.district_id = district.district_id\nWHERE district.A2 = 'North Bohemia' AND trans.bank = 'AB'\t----- bird -----\tfinancial",
    "151": "SELECTDISTINCT A2\nFROM district\nWHERE district_id IN\n    (SELECT district_id\n     FROM account\n     WHERE account_id IN\n         (SELECT account_id\n          FROM trans\n          WHERE type = 'Withdrawal')\t----- bird -----\tfinancial",
    "152": "SELECTAVG(A11) \nFROM district \nWHERE A11 > 4000 \nAND district_id IN \n    (SELECT district_id \n     FROM account \n     WHERE strftime('%Y', date) >= '1997') \nAND district_id IN \n    (SELECT district_id \n     FROM loan \n     WHERE strftime('%Y', date) = '1995')\t----- bird -----\tfinancial",
    "153": "SELECTCOUNT(*)\nFROM card\nWHERE type = 'classic'\t----- bird -----\tfinancial",
    "154": "SELECTCOUNT(*)\nFROM client\nJOIN district ON client.district_id = district.district_id\nWHERE district.A2 = 'Hl.m. Praha' AND client.gender = 'M'\t----- bird -----\tfinancial",
    "155": "SELECT\n    COUNT(*) * 100.0 / (SELECT COUNT(*) FROM card WHERE type = 'Gold') AS percentage\nFROM card\nWHERE type = 'Gold' AND issued < '1998-01-01'\t----- bird -----\tfinancial",
    "156": "SELECTclient.client_id, client.gender, client.birth_date\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nJOIN loan ON account.account_id = loan.account_id\nWHERE loan.amount = (SELECT MAX(amount) FROM loan)\t----- bird -----\tfinancial",
    "157": "SELECTSUM(A11) \nFROM district \nWHERE district_id = (\n    SELECT district_id \n    FROM account \n    WHERE account_id = 532\n)\t----- bird -----\tfinancial",
    "158": "SELECTdistrict_id\nFROM account\nWHERE account_id = 33333\t----- bird -----\tfinancial",
    "159": "SELECTtrans.trans_id, trans.date, trans.amount\nFROM trans\nJOIN disp ON trans.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nWHERE client.client_id = 3356\nAND trans.type = 'withdrawal'\nAND trans.operation = 'cash'\t----- bird -----\tfinancial",
    "160": "SELECTCOUNT(account_id)\nFROM account\nWHERE frequency = 'weekly'\nAND account_id IN (SELECT account_id FROM loan WHERE amount < 200000)\t----- bird -----\tfinancial",
    "161": "SELECTcard.type\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE client.client_id = 13539\t----- bird -----\tfinancial",
    "162": "SELECTd.A2\nFROM client c\nJOIN district d ON c.district_id = d.district_id\nWHERE c.client_id = 3541\t----- bird -----\tfinancial",
    "163": "SELECTd.A2 AS district_name, COUNT(l.account_id) AS num_accounts\nFROM district d\nJOIN account a ON d.district_id = a.district_id\nJOIN loan l ON a.account_id = l.account_id\nWHERE l.status = 'A'\nGROUP BY d.district_id\nORDER BY num_accounts DESC\nLIMIT 1\t----- bird -----\tfinancial",
    "164": "SELECTclient.client_id, client.gender, client.birth_date\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nJOIN \"order\" ON account.account_id = \"order\".account_id\nWHERE \"order\".order_id = 32423\t----- bird -----\tfinancial",
    "165": "SELECTtrans.trans_id, trans.account_id, trans.date, trans.type, trans.operation, trans.amount, trans.balance, trans.k_symbol, trans.bank, trans.account\nFROM trans\nJOIN account ON trans.account_id = account.account_id\nJOIN district ON account.district_id = district.district_id\nWHERE district.A5 = '5'\t----- bird -----\tfinancial",
    "166": "SELECTCOUNT(*)\nFROM account\nWHERE district_id IN (SELECT district_id FROM district WHERE A2 = 'Jesenik')\t----- bird -----\tfinancial",
    "167": "SELECTclient_id\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE card.type = 'junior' AND card.issued > '1996-01-01'\t----- bird -----\tfinancial",
    "168": "SELECTCOUNT(DISTINCT c.client_id) * 100.0 / (SELECT COUNT(DISTINCT c.client_id) \nFROM client c \nJOIN account a ON c.client_id = a.account_id \nJOIN district d ON c.district_id = d.district_id \nWHERE d.A10 > 10000) AS percentage_of_women\nFROM client c \nJOIN account a ON c.client_id = a.account_id \nJOIN district d ON c.district_id = d.district_id \nWHERE d.A10 > 10000 \nAND c.gender = 'F'\t----- bird -----\tfinancial",
    "169": "SELECTSUM(l.amount) AS total_loan_amount\nFROM loan l\nJOIN account a ON l.account_id = a.account_id\nJOIN disp d ON a.account_id = d.account_id\nJOIN client c ON d.client_id = c.client_id\nWHERE c.gender = 'M'\nAND l.date BETWEEN '1996-01-01' AND '1997-12-31'\t----- bird -----\tfinancial",
    "170": "SELECTCOUNT(*)\nFROM trans\nWHERE type = 'credit card withdrawal' AND date > '1995-01-01'\t----- bird -----\tfinancial",
    "171": "SELECTSUM(A11) AS East_Bohemia_Crimes, \n       SUM(A12) AS North_Bohemia_Crimes\nFROM district\nWHERE A2 = 'East Bohemia' OR A2 = 'North Bohemia' \nAND A16 = 1996\t----- bird -----\tfinancial",
    "172": "SELECTCOUNT(*) \nFROM disp \nWHERE account_id BETWEEN 1 AND 10\t----- bird -----\tfinancial",
    "173": "SELECTfrequency\nFROM account\nWHERE account_id = 3\t----- bird -----\tfinancial",
    "174": "SELECTbirth_date\nFROM client\nWHERE client_id = 130\t----- bird -----\tfinancial",
    "175": "SELECTCOUNT(*) \nFROM disp \nWHERE type = 'OWNER' \nAND disp_id IN (SELECT disp_id FROM card WHERE type = 'OWNER' AND issued = 'statement')\t----- bird -----\tfinancial",
    "176": "SELECTSUM(amount) AS total_debt, status\nFROM loan\nWHERE account_id IN (SELECT account_id FROM disp WHERE client_id = 992)\nGROUP BY status\t----- bird -----\tfinancial",
    "177": "SELECTSUM(balance) \nFROM trans \nWHERE account_id = (SELECT account_id FROM disp WHERE client_id = 4) AND trans_id <= 851;\t----- bird -----\tfinancial",
    "178": "SELECTcard.type\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nWHERE client.client_id = 9\t----- bird -----\tfinancial",
    "179": "SELECTSUM(amount) AS total_payment\nFROM trans\nWHERE account_id IN (SELECT account_id FROM disp WHERE client_id = 617)\nAND date BETWEEN '1998-01-01' AND '1998-12-31'\t----- bird -----\tfinancial",
    "180": "SELECTclient_id\nFROM client\nJOIN district ON client.district_id = district.district_id\nWHERE birth_date BETWEEN '1983-01-01' AND '1987-12-31'\nAND district.A2 = 'East Bohemia'\t----- bird -----\tfinancial",
    "181": "SELECTclient_id\nFROM client\nWHERE gender = 'F'\nORDER BY client_id DESC\nLIMIT 3\t----- bird -----\tfinancial",
    "182": "SELECTCOUNT(DISTINCT c.client_id)\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN loan l ON a.account_id = l.account_id\nJOIN trans t ON a.account_id = t.account_id\nWHERE c.gender = 'M'\nAND c.birth_date BETWEEN '1974-01-01' AND '1976-12-31'\nAND l.amount > 4000\nAND t.k_symbol = 'household'\t----- bird -----\tfinancial",
    "183": "SELECTCOUNT(*)\nFROM account\nJOIN district ON account.district_id = district.district_id\nWHERE district.A2 = 'Beroun' AND account.date > '1996-01-01'\t----- bird -----\tfinancial",
    "184": "SELECTCOUNT(*) \nFROM client \nJOIN disp ON client.client_id = disp.client_id \nJOIN card ON disp.disp_id = card.disp_id \nWHERE client.gender = 'F' AND card.type = 'junior'\t----- bird -----\tfinancial",
    "185": "SELECT\n    COUNT(DISTINCT c.client_id) AS total_customers,\n    COUNT(DISTINCT c.client_id) FILTER (WHERE c.gender = 'F') AS female_customers,\n    ROUND(CAST(COUNT(DISTINCT c.client_id) FILTER (WHERE c.gender = 'F') AS REAL) / COUNT(DISTINCT c.client_id), 2) AS female_proportion\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nJOIN district dis ON c.district_id = dis.district_id\nWHERE dis.A2 = 'Prague'\t----- bird -----\tfinancial",
    "186": "SELECT\n    COUNT(DISTINCT c.client_id) * 100.0 / (SELECT COUNT(DISTINCT client_id) FROM client WHERE gender = 'M') AS percentage\nFROM client c\nJOIN disp d ON c.client_id = d.client_id\nJOIN account a ON d.account_id = a.account_id\nWHERE a.frequency = 'WEEKLY'\nAND c.gender = 'M'\t----- bird -----\tfinancial",
    "187": "SELECTCOUNT(client.client_id)\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nWHERE account.frequency = 'weekly' AND disp.type = 'Owner'\t----- bird -----\tfinancial",
    "188": "SELECTaccount_id, amount\nFROM loan\nJOIN account ON loan.account_id = account.account_id\nWHERE duration > 24\nAND date < '1997-01-01'\nORDER BY amount\nLIMIT 1\t----- bird -----\tfinancial",
    "189": "SELECTaccount_id\nFROM account\nJOIN disp ON account.account_id = disp.account_id\nJOIN client ON disp.client_id = client.client_id\nWHERE client.gender = 'F'\nGROUP BY client.client_id\nORDER BY client.birth_date ASC, client.client_id ASC\t----- bird -----\tfinancial",
    "190": "SELECTCOUNT(*) \nFROM client \nJOIN district ON client.district_id = district.district_id \nWHERE client.birth_date LIKE '1920%' \nAND district.A6 = 'east Bohemia'\t----- bird -----\tfinancial",
    "191": "SELECTCOUNT(*) \nFROM loan \nJOIN account ON loan.account_id = account.account_id\nWHERE duration = 24 AND frequency = 'weekly' AND status = 'pre-payment'\t----- bird -----\tfinancial",
    "192": "SELECTAVG(amount) \nFROM loan \nWHERE status = 'running' \nAND date > (SELECT MAX(date) FROM trans)\t----- bird -----\tfinancial",
    "193": "SELECTclient.client_id, district.A2\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN account ON disp.account_id = account.account_id\nJOIN district ON client.district_id = district.district_id\nWHERE disp.type = 'OWNER'\nAND (account.frequency = 'POPLATEK MESICNE' OR account.frequency = 'POPLATEK PO OBRATU')\nAND (account_id NOT IN (SELECT account_id FROM loan) OR account_id NOT IN (SELECT account_id FROM `order`))\nGROUP BY client.client_id, district.A2\t----- bird -----\tfinancial",
    "194": "SELECTclient.client_id, client.birth_date\nFROM client\nJOIN disp ON client.client_id = disp.client_id\nJOIN card ON disp.disp_id = card.disp_id\nJOIN account ON disp.account_id = account.account_id\nJOIN loan ON account.account_id = loan.account_id\nWHERE card.type = 'credit' AND loan.status = 'A'\t----- bird -----\tfinancial",
    "195": "SELECT`bond_type`, COUNT(*) AS `count`\nFROM `bond`\nGROUP BY `bond_type`\nORDER BY `count` DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "196": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'Cl'\t----- bird -----\ttoxicology",
    "197": "SELECTAVG(oxygen_count) AS average_oxygen_atoms\nFROM (\n  SELECT COUNT(*) AS oxygen_count\n  FROM atom a\n  JOIN molecule m ON a.molecule_id = m.molecule_id\n  WHERE a.element = 'O' AND a.atom_id IN (\n    SELECT atom_id\n    FROM connected c\n    JOIN bond b ON c.bond_id = b.bond_id\n    WHERE b.bond_type = 'single'\n  )\n  GROUP BY m.molecule_id\n) subquery\t----- bird -----\ttoxicology",
    "198": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE b.bond_type = 'single'\t----- bird -----\ttoxicology",
    "199": "SELECTCOUNT(*) \nFROM atom \nWHERE element = 'sodium' \nAND molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'non-carcinogenic')\t----- bird -----\ttoxicology",
    "200": "SELECTm.molecule_id, m.label\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE b.bond_type = 'triple'\nAND m.label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "201": "SELECT\n(SELECT COUNT(DISTINCT m.molecule_id) FROM molecule m \nJOIN bond b ON m.molecule_id = b.molecule_id \nWHERE b.bond_type = 'double') / \n(SELECT COUNT(DISTINCT m.molecule_id) FROM molecule m) * 100 as percentage_carbon_double_bond\nFROM molecule m \nJOIN atom a ON m.molecule_id = a.molecule_id \nWHERE a.element = 'carbon'\t----- bird -----\ttoxicology",
    "202": "SELECTCOUNT(*) \nFROM bond \nWHERE bond_type = 'triple'\t----- bird -----\ttoxicology",
    "203": "SELECTCOUNT(*) \nFROM atom\nWHERE element != 'Bromine'\t----- bird -----\ttoxicology",
    "204": "SELECTCOUNT(*) \nFROM molecule \nWHERE molecule_id <= 100 \nAND label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "205": "SELECTmolecule_id\nFROM atom\nWHERE element = 'carbon'\t----- bird -----\ttoxicology",
    "206": "SELECTelement\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nJOIN bond ON connected.bond_id = bond.bond_id\nWHERE bond.bond_id = 'TR004_8_9'\t----- bird -----\ttoxicology",
    "207": "SELECTDISTINCT element\nFROM atom\nWHERE atom_id IN (\n    SELECT atom_id\n    FROM connected\n    WHERE bond_id IN (\n        SELECT bond_id\n        FROM bond\n        WHERE bond_type = 'double'\n    )\n)\t----- bird -----\ttoxicology",
    "208": "SELECTelement, COUNT(*) AS count\nFROM atom\nWHERE element = 'hydrogen'\nGROUP BY element\nORDER BY count DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "209": "SELECTbond.bond_type\nFROM bond\nJOIN molecule ON bond.molecule_id = molecule.molecule_id\nJOIN atom ON molecule.molecule_id = atom.molecule_id\nWHERE atom.element = 'Chlorine'\t----- bird -----\ttoxicology",
    "210": "SELECTa.atom_id, c.atom_id2\nFROM connected c\nJOIN atom a ON c.atom_id = a.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nWHERE b.bond_type = 'single'\t----- bird -----\ttoxicology",
    "211": "SELECTa.atom_id, c.atom_id2\nFROM connected c\nJOIN atom a ON c.atom_id = a.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE b.bond_type != 'carcinogenic'\t----- bird -----\ttoxicology",
    "212": "SELECTelement, COUNT(*) AS num_molecules\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nWHERE molecule.label != 'carcinogenic'\nGROUP BY element\nORDER BY num_molecules\nLIMIT 1\t----- bird -----\ttoxicology",
    "213": "SELECTbond.bond_type\nFROM connected\nJOIN bond ON connected.bond_id = bond.bond_id\nWHERE (connected.atom_id = 'TR004_8' AND connected.atom_id2 = 'TR004_20')\nOR (connected.atom_id = 'TR004_20' AND connected.atom_id2 = 'TR004_8')\t----- bird -----\ttoxicology",
    "214": "SELECTDISTINCT label\nFROM molecule\nWHERE molecule_id IN (\n    SELECT molecule_id\n    FROM atom\n    WHERE element = 'tin'\n)\t----- bird -----\ttoxicology",
    "215": "SELECTCOUNT(DISTINCT a.atom_id)\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE a.element IN ('iodine', 'sulfur')\nAND b.bond_type = 'single'\t----- bird -----\ttoxicology",
    "216": "SELECTa.atom_id, c.atom_id2\nFROM connected c\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN atom a ON c.atom_id = a.atom_id\nJOIN atom a2 ON c.atom_id2 = a2.atom_id\nWHERE b.bond_type = 'triple'\t----- bird -----\ttoxicology",
    "217": "SELECTa.atom_id, c.atom_id2\nFROM atom a\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE m.label = 'TR181'\t----- bird -----\ttoxicology",
    "218": "SELECTCOUNT(DISTINCT m.molecule_id) * 100.0 / (SELECT COUNT(DISTINCT m2.molecule_id) FROM molecule m2 WHERE m2.label = 'carcinogenic' AND m2.molecule_id NOT IN (SELECT m3.molecule_id FROM molecule m3 JOIN atom a ON m3.molecule_id = a.molecule_id WHERE a.element = 'Fluorine')) AS percentage\nFROM molecule m\nWHERE m.label = 'carcinogenic' AND m.molecule_id NOT IN (SELECT m2.molecule_id FROM molecule m2 JOIN atom a ON m2.molecule_id = a.molecule_id WHERE a.element = 'Fluorine')\t----- bird -----\ttoxicology",
    "219": "SELECT\n(SELECT COUNT(DISTINCT molecule_id) FROM bond WHERE bond_type = 'triple') AS total_triple_bonds,\n(SELECT COUNT(DISTINCT molecule_id) FROM bond WHERE bond_type = 'triple' AND molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic')) AS carcinogenic_triple_bonds,\n(SELECT COUNT(DISTINCT molecule_id) FROM bond WHERE bond_type = 'triple') AS total_triple_bonds,\n(SELECT COUNT(DISTINCT molecule_id) FROM bond WHERE bond_type = 'triple' AND molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic')) AS carcinogenic_triple_bonds,\nROUND((carcinogenic_triple_bonds * 100.0) / total_triple_bonds, 2) AS percentage_carcinogenic_triple_bonds\t----- bird -----\ttoxicology",
    "220": "SELECTelement\nFROM atom\nWHERE molecule_id = 'TR000'\nORDER BY element\nLIMIT 3\t----- bird -----\ttoxicology",
    "221": "SELECTatom.atom_id, connected.atom_id2\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nJOIN bond ON connected.bond_id = bond.bond_id\nJOIN molecule ON bond.molecule_id = molecule.molecule_id\nWHERE molecule.label = 'TR001' AND bond.bond_id = 'TR001_2_6'\t----- bird -----\ttoxicology",
    "222": "SELECTCOUNT(DISTINCT molecule_id) AS carcinogenic_molecules\nFROM molecule\nWHERE label = 'carcinogenic';\t----- bird -----\ttoxicology",
    "223": "SELECT`atom_id`\nFROM `connected`\nWHERE `bond_id` = 'TR000_2_5'\t----- bird -----\ttoxicology",
    "224": "SELECT`bond_id`\nFROM `connected`\nWHERE `atom_id2` = 'TR000_2'\t----- bird -----\ttoxicology",
    "225": "SELECTmolecule_id\nFROM bond\nWHERE bond_type = 'double'\nORDER BY molecule_id\nLIMIT 5\t----- bird -----\ttoxicology",
    "226": "SELECTROUND((SELECT COUNT(*) FROM bond WHERE molecule_id = 'TR008' AND bond_type = 'double') * 100.0 / (SELECT COUNT(*) FROM bond WHERE molecule_id = 'TR008'), 5) AS percentage_of_double_bonds\nFROM bond\nWHERE molecule_id = 'TR008'\t----- bird -----\ttoxicology",
    "227": "SELECTROUND((COUNT(DISTINCT molecule_id) * 100.0 / (SELECT COUNT(DISTINCT molecule_id) FROM molecule)), 3) AS percentage_carcinogenic\nFROM molecule\nWHERE label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "228": "SELECTROUND((COUNT(DISTINCT a.atom_id) * 100.0 / \n        (SELECT COUNT(DISTINCT atom_id) \n         FROM atom \n         WHERE molecule_id = 'TR206')), 4) AS percentage_hydrogen_accounted_for\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE m.label = 'TR206'\nAND a.element = 'hydrogen'\t----- bird -----\ttoxicology",
    "229": "SELECTbond.bond_type\nFROM bond\nWHERE bond.molecule_id = 'TR000'\t----- bird -----\ttoxicology",
    "230": "SELECTatom.element, molecule.label\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nWHERE molecule.label = 'TR060'\t----- bird -----\ttoxicology",
    "231": "SELECTbond_type, COUNT(*) AS bond_count\nFROM bond\nWHERE molecule_id = 'TR010'\nGROUP BY bond_type\nORDER BY bond_count DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "232": "SELECTm1.label AS molecule_label\nFROM molecule m1\nJOIN bond b ON m1.molecule_id = b.molecule_id\nJOIN connected c ON b.bond_id = c.bond_id\nJOIN atom a1 ON c.atom_id = a1.atom_id\nJOIN atom a2 ON c.atom_id2 = a2.atom_id\nWHERE b.bond_type = 'single'\nAND NOT EXISTS (\n    SELECT 1\n    FROM molecule m2\n    WHERE m2.molecule_id = m1.molecule_id\n    AND m2.label LIKE '%carcinogenic%'\n)\nORDER BY m1.label\nLIMIT 3\t----- bird -----\ttoxicology",
    "233": "SELECT`bond`.`bond_id`, `bond`.`bond_type`\nFROM `bond`\nWHERE `bond`.`molecule_id` = 'TR006'\nORDER BY `bond`.`bond_type` ASC\nLIMIT 2\t----- bird -----\ttoxicology",
    "234": "SELECTCOUNT(*) \nFROM connected c\nJOIN atom a ON c.atom_id = a.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE a.atom_id = '12' AND m.label = 'TR009'\t----- bird -----\ttoxicology",
    "235": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE m.label = 'carcinogenic' AND a.element = 'bromine'\t----- bird -----\ttoxicology",
    "236": "SELECT`bond_type`, `atom_id`, `atom_id2`\nFROM `bond`\nJOIN `connected` ON `bond`.`bond_id` = `connected`.`bond_id`\nWHERE `bond`.`bond_id` = 'TR001_6_9'\t----- bird -----\ttoxicology",
    "237": "SELECTm.label, m.carcinogenic\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.atom_id = 'TR001_10'\t----- bird -----\ttoxicology",
    "238": "SELECTCOUNT(DISTINCT molecule_id)\nFROM bond\nWHERE bond_type = 'triple'\t----- bird -----\ttoxicology",
    "239": "SELECTCOUNT(*) \nFROM connected \nWHERE atom_id = '19' OR atom_id2 = '19'\t----- bird -----\ttoxicology",
    "240": "SELECTa.element\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE m.label = 'TR004'\t----- bird -----\ttoxicology",
    "241": "SELECTCOUNT(*) \nFROM molecule \nWHERE label != 'carcinogenic'\t----- bird -----\ttoxicology",
    "242": "SELECTDISTINCT m.molecule_id\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.atom_id BETWEEN '21' AND '25'\nAND m.label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "243": "SELECTb.bond_id, b.bond_type\nFROM bond b\nJOIN molecule m ON b.molecule_id = m.molecule_id\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'phosphorus' OR a.element = 'nitrogen'\t----- bird -----\ttoxicology",
    "244": "SELECTmolecule_id, COUNT(*) AS double_bonds\nFROM bond\nWHERE bond_type = 'double'\nGROUP BY molecule_id\nORDER BY double_bonds DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "245": "SELECTAVG(bonds_per_atom) AS average_bonds\nFROM (\n    SELECT a.atom_id, COUNT(c.bond_id) AS bonds_per_atom\n    FROM atom a\n    JOIN connected c ON a.atom_id = c.atom_id\n    WHERE a.element = 'iodine'\n    GROUP BY a.atom_id\n) subquery\t----- bird -----\ttoxicology",
    "246": "SELECT`bond`.`bond_type`, `bond`.`bond_id`\nFROM `connected`\nJOIN `atom` ON `connected`.`atom_id` = `atom`.`atom_id`\nJOIN `bond` ON `connected`.`bond_id` = `bond`.`bond_id`\nWHERE `connected`.`atom_id` = '45'\t----- bird -----\ttoxicology",
    "247": "SELECTDISTINCT element\nFROM atom\nWHERE atom_id NOT IN (\n    SELECT atom_id\n    FROM connected\n)\t----- bird -----\ttoxicology",
    "248": "SELECTa.atom_id\nFROM atom a\nJOIN bond b ON a.molecule_id = b.molecule_id\nJOIN connected c ON a.atom_id = c.atom_id\nWHERE b.bond_type = \"triple\"\nAND b.molecule_id = \"TR041\"\t----- bird -----\ttoxicology",
    "249": "SELECTelement\nFROM atom\nWHERE molecule_id = 'TR144_8_19'\t----- bird -----\ttoxicology",
    "250": "SELECTmolecule_id, COUNT(*) AS double_bonds\nFROM bond\nWHERE bond_type = 'double'\nAND molecule_id IN (\n    SELECT molecule_id\n    FROM molecule\n    WHERE label = 'carcinogenic'\n)\nGROUP BY molecule_id\nORDER BY double_bonds DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "251": "SELECTelement\nFROM atom\nWHERE molecule_id IN (\n    SELECT molecule_id\n    FROM molecule\n    WHERE label = 'carcinogenic'\n)\nGROUP BY element\nORDER BY COUNT(*) ASC\nLIMIT 1\t----- bird -----\ttoxicology",
    "252": "SELECTatom.atom_id, atom.element\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nJOIN atom AS a2 ON connected.atom_id2 = a2.atom_id\nWHERE a2.element = 'lead'\t----- bird -----\ttoxicology",
    "253": "SELECTDISTINCT a1.element\nFROM atom a1\nJOIN connected c ON a1.atom_id = c.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN connected c2 ON c.atom_id = c2.atom_id\nJOIN atom a2 ON c2.atom_id2 = a2.atom_id\nWHERE b.bond_type = 'triple'\t----- bird -----\ttoxicology",
    "254": "SELECTCOUNT(*) AS total_bonds,\n       COUNT(*) * 100.0 / (SELECT COUNT(*) FROM bond) AS percentage\nFROM bond\nJOIN connected ON bond.molecule_id = connected.bond_id\nJOIN atom ON connected.atom_id = atom.atom_id\nGROUP BY atom.element\nORDER BY COUNT(*) DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "255": "SELECT\n(SELECT COUNT(*) FROM bond WHERE bond_type = 'single' AND molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic')) / (SELECT COUNT(*) FROM bond WHERE bond_type = 'single') * 100.00000 as proportion_of_carcinogenic_single_bonds\t----- bird -----\ttoxicology",
    "256": "SELECTCOUNT(*) AS total_atoms\nFROM atom\nWHERE element IN ('carbon', 'hydrogen')\t----- bird -----\ttoxicology",
    "257": "SELECTconnected.atom_id2\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nWHERE atom.element = 'sulfur'\t----- bird -----\ttoxicology",
    "258": "SELECTbond.bond_type\nFROM atom\nJOIN bond ON atom.molecule_id = bond.molecule_id\nWHERE atom.element = 'Tin'\t----- bird -----\ttoxicology",
    "259": "SELECTCOUNT(DISTINCT a.element)\nFROM atom a\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE b.bond_type = 'single'\t----- bird -----\ttoxicology",
    "260": "SELECTCOUNT(DISTINCT a.atom_id)\nFROM atom a\nJOIN bond b ON a.molecule_id = b.molecule_id\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN atom a2 ON c.atom_id2 = a2.atom_id\nJOIN bond b2 ON a2.molecule_id = b2.molecule_id\nJOIN atom a3 ON c.atom_id2 = a3.atom_id\nJOIN bond b3 ON a3.molecule_id = b3.molecule_id\nWHERE (a.element = 'phosphorus' OR a.element = 'bromine')\nAND b.bond_type = 'triple'\nAND b2.bond_type = 'triple'\nAND b3.bond_type = 'triple'\t----- bird -----\ttoxicology",
    "261": "SELECT`bond_id`\nFROM `bond`\nWHERE `molecule_id` IN (\n    SELECT `molecule_id`\n    FROM `molecule`\n    WHERE `label` = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "262": "SELECTDISTINCT m.molecule_id\nFROM molecule m\nLEFT JOIN bond b ON m.molecule_id = b.molecule_id\nWHERE b.bond_type = 'single'\nAND m.molecule_id NOT IN (\n    SELECT m2.molecule_id\n    FROM molecule m2\n    JOIN bond b2 ON m2.molecule_id = b2.molecule_id\n    WHERE b2.bond_type = 'single' AND m2.label = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "263": "SELECTelement, COUNT(*) * 100.0 / (SELECT COUNT(*) FROM bond WHERE bond_type = 'single') AS percentage\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nJOIN bond ON molecule.molecule_id = bond.molecule_id\nWHERE element = 'chlorine' AND bond_type = 'single'\nGROUP BY element\t----- bird -----\ttoxicology",
    "264": "SELECT`label` FROM `molecule` WHERE `molecule_id` IN ('TR000', 'TR001', 'TR002')\t----- bird -----\ttoxicology",
    "265": "SELECTmolecule_id\nFROM molecule\nWHERE molecule_id NOT IN (\n    SELECT molecule_id\n    FROM molecule\n    JOIN atom ON molecule.molecule_id = atom.molecule_id\n    JOIN connected ON atom.atom_id = connected.atom_id\n    JOIN bond ON connected.bond_id = bond.bond_id\n    WHERE element = 'C'\n)\t----- bird -----\ttoxicology",
    "266": "SELECTCOUNT(DISTINCT m.molecule_id) AS total_carcinogenic_molecules\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nJOIN connected c ON b.bond_id = c.bond_id\nJOIN atom a ON c.atom_id = a.atom_id\nWHERE m.molecule_id LIKE 'TR00%' OR m.molecule_id LIKE 'TR01%' OR m.molecule_id LIKE 'TR02%' or m.molecule_id LIKE 'TR03%'\nAND a.element = 'C'\t----- bird -----\ttoxicology",
    "267": "SELECT`bond_type`\nFROM `bond`\nWHERE `molecule_id` BETWEEN 'TR000' AND 'TR050'\t----- bird -----\ttoxicology",
    "268": "SELECT`element`\nFROM `atom`\nWHERE `molecule_id` = 'TR001_10_11'\t----- bird -----\ttoxicology",
    "269": "SELECTCOUNT(bond.bond_id)\nFROM bond\nJOIN molecule ON bond.molecule_id = molecule.molecule_id\nJOIN atom ON atom.molecule_id = molecule.molecule_id\nWHERE atom.element = 'iodine'\t----- bird -----\ttoxicology",
    "270": "SELECTm.molecule_id, m.label\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'Calcium'\t----- bird -----\ttoxicology",
    "271": "SELECTa.element\nFROM atom a\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nWHERE b.bond_id = 'TR001_1_8'\nAND a.element IN ('chlorine', 'carbon')\t----- bird -----\ttoxicology",
    "272": "SELECTm.molecule_id\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE b.bond_type = 'triple bond'\nAND a.element = 'carbon'\nAND m.label != 'carcinogenic'\nLIMIT 2\t----- bird -----\ttoxicology",
    "273": "SELECT\n(SELECT COUNT(DISTINCT a.molecule_id) FROM atom a WHERE a.element = 'Cl' AND a.molecule_id IN (SELECT m.molecule_id FROM molecule m WHERE m.label = 'carcinogenic')) * 100.0 / (SELECT COUNT(DISTINCT m.molecule_id) FROM molecule m WHERE m.label = 'carcinogenic') AS percentage_cl_in_carcinogenic_molecules\t----- bird -----\ttoxicology",
    "274": "SELECTelement\nFROM atom\nWHERE molecule_id = 'TR001'\t----- bird -----\ttoxicology",
    "275": "SELECT`molecule_id`\nFROM `bond`\nWHERE `bond_type` = 'double bond'\t----- bird -----\ttoxicology",
    "276": "SELECTa1.atom_id, a2.atom_id\nFROM connected c\nJOIN bond b ON c.bond_id = b.bond_id\nJOIN atom a1 ON c.atom_id = a1.atom_id\nJOIN atom a2 ON c.atom_id2 = a2.atom_id\nWHERE b.bond_type = 'triple'\t----- bird -----\ttoxicology",
    "277": "SELECTelement\nFROM atom\nWHERE atom_id IN (\n    SELECT atom_id\n    FROM connected\n    WHERE bond_id = 'TR000_1_2'\n)\t----- bird -----\ttoxicology",
    "278": "SELECTCOUNT(*) \nFROM bond \nJOIN molecule ON bond.molecule_id = molecule.molecule_id \nWHERE bond.bond_type = 'single' \nAND molecule.label != 'carcinogenic'\t----- bird -----\ttoxicology",
    "279": "SELECT`label` \nFROM `molecule` \nWHERE `molecule_id` = (\n    SELECT `molecule_id` \n    FROM `bond` \n    WHERE `bond_id` = 'TR001_10_11'\n)\t----- bird -----\ttoxicology",
    "280": "SELECT`bond_id`\nFROM `bond`\nWHERE `bond_type` = 'triple'\nAND `molecule_id` IN (\n  SELECT `molecule_id`\n  FROM `molecule`\n  WHERE `label` = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "281": "SELECTatom.element\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nJOIN bond ON bond.molecule_id = molecule.molecule_id\nJOIN connected ON connected.atom_id = atom.atom_id\nWHERE molecule.label = 'carcinogenic'\nAND connected.atom_id = (\n    SELECT atom_id\n    FROM atom\n    WHERE molecule_id = molecule.molecule_id\n    LIMIT 1 OFFSET 3\n)\t----- bird -----\ttoxicology",
    "282": "SELECTCOUNT(*) AS hydrogen_count,\n       (SELECT COUNT(*) FROM atom WHERE molecule_id = 'TR006') AS total_atoms,\n       (SELECT label FROM molecule WHERE molecule_id = 'TR006') AS molecule_label\nFROM atom\nWHERE molecule_id = 'TR006' AND element = 'Hydrogen'\t----- bird -----\ttoxicology",
    "283": "SELECTmolecule_id, label\nFROM molecule\nWHERE molecule_id IN (\n    SELECT molecule_id\n    FROM atom\n    WHERE element = 'Ca'\n)\t----- bird -----\ttoxicology",
    "284": "SELECTDISTINCT bond.bond_type\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nJOIN bond ON bond.molecule_id = molecule.molecule_id\nWHERE atom.element = 'Carbon'\t----- bird -----\ttoxicology",
    "285": "SELECTDISTINCT a.element\nFROM atom a\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nWHERE b.bond_id = 'TR001_10_11'\t----- bird -----\ttoxicology",
    "286": "SELECTROUND((COUNT(DISTINCT molecule_id) * 100.0) / (SELECT COUNT(DISTINCT molecule_id) FROM bond WHERE bond_type = 'triple-bond'), 2) AS percentage_of_compounds_with_triple_bond\nFROM bond\nWHERE bond_type = 'triple-bond'\t----- bird -----\ttoxicology",
    "287": "SELECT\n(SELECT COUNT(DISTINCT m.molecule_id) \nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE m.label = 'TR047' AND b.bond_type = 'double') * 100.0 / \n(SELECT COUNT(DISTINCT m.molecule_id) \nFROM molecule m\nWHERE m.label = 'TR047') AS percentage_double_bond\nFROM molecule m\nWHERE m.label = 'TR047'\t----- bird -----\ttoxicology",
    "288": "SELECTm.label\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.atom_id = 'TR001_1'\t----- bird -----\ttoxicology",
    "289": "SELECT`label` \nFROM `molecule` \nWHERE `molecule_id` = 'TR151' \nAND `label` = 'carcinogenic'\t----- bird -----\ttoxicology",
    "290": "SELECTa.element\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE m.label = 'TR151'\nAND a.element = 'toxic'\t----- bird -----\ttoxicology",
    "291": "SELECTCOUNT(DISTINCT molecule_id)\nFROM molecule\nWHERE label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "292": "SELECTa.atom_id\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE m.molecule_id BETWEEN 'TR010' AND 'TR050'\nAND a.element = 'carbon'\t----- bird -----\ttoxicology",
    "293": "SELECTCOUNT(*) \nFROM atom \nWHERE molecule_id = (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic compounds')\t----- bird -----\ttoxicology",
    "294": "SELECT`bond_id`\nFROM `bond`\nWHERE `molecule_id` IN (\n    SELECT `molecule_id`\n    FROM `molecule`\n    WHERE `label` = 'carcinogenic'\n) AND `bond_type` = 'double-bond'\t----- bird -----\ttoxicology",
    "295": "SELECTCOUNT(*) \nFROM atom \nJOIN molecule ON atom.molecule_id = molecule.molecule_id \nWHERE element = 'hydrogen' AND label = 'carcinogenic compound'\t----- bird -----\ttoxicology",
    "296": "SELECTmolecule.molecule_id\nFROM molecule\nJOIN bond ON molecule.molecule_id = bond.molecule_id\nJOIN connected ON bond.bond_id = connected.bond_id\nJOIN atom ON connected.atom_id = atom.atom_id\nWHERE atom.element = 'TR000_1'\nAND bond.bond_type = 'TR000_1_2'\t----- bird -----\ttoxicology",
    "297": "SELECTa.atom_id\nFROM atom a\nLEFT JOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE a.element = 'carbon' AND (m.label IS NULL OR m.label != 'carcinogenic')\t----- bird -----\ttoxicology",
    "298": "SELECTCOUNT(DISTINCT m.molecule_id) * 100.0 / (SELECT COUNT(DISTINCT molecule_id) FROM molecule) AS percentage\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'hydrogen' \nAND EXISTS (\n    SELECT 1\n    FROM bond b\n    WHERE b.molecule_id = m.molecule_id\n    AND b.bond_type = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "299": "SELECTlabel\nFROM molecule\nWHERE molecule_id = 'TR124'\t----- bird -----\ttoxicology",
    "300": "SELECTatom_id, element\nFROM atom\nWHERE molecule_id = 'TR186'\t----- bird -----\ttoxicology",
    "301": "SELECT`bond_type` \nFROM `bond`\nWHERE `molecule_id` = 'TR007_4_19'\t----- bird -----\ttoxicology",
    "302": "SELECTelement\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nJOIN bond ON connected.bond_id = bond.bond_id\nWHERE bond.bond_id = 'TR001_2_4'\t----- bird -----\ttoxicology",
    "303": "SELECTCOUNT(*) AS double_bonds, \n       m.label AS carcinogenic\nFROM bond b\nJOIN molecule m ON b.molecule_id = m.molecule_id\nWHERE b.bond_type = 'double'\nAND m.label = 'TR006'\t----- bird -----\ttoxicology",
    "304": "SELECTm.label, a.element\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE m.label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "305": "SELECT`bond_id`, `atom_id`, `atom_id2`\nFROM `connected`\nJOIN `bond` ON `connected`.`bond_id` = `bond`.`bond_id`\nWHERE `bond`.`bond_type` = 'single'\t----- bird -----\ttoxicology",
    "306": "SELECTmolecule.label, atom.element\nFROM molecule\nJOIN bond ON molecule.molecule_id = bond.molecule_id\nJOIN connected ON bond.bond_id = connected.bond_id\nJOIN atom ON connected.atom_id = atom.atom_id\nWHERE bond.bond_type = 'triple'\t----- bird -----\ttoxicology",
    "307": "SELECTelement\nFROM atom\nJOIN connected ON atom.atom_id = connected.atom_id\nJOIN bond ON connected.bond_id = bond.bond_id\nWHERE bond.bond_id = 'TR000_2_3'\t----- bird -----\ttoxicology",
    "308": "SELECTCOUNT(*) \nFROM atom a\nJOIN connected c ON a.atom_id = c.atom_id\nJOIN bond b ON c.bond_id = b.bond_id\nWHERE a.element = 'chlorine'\t----- bird -----\ttoxicology",
    "309": "SELECT`atom_id`\nFROM `atom`\nWHERE `molecule_id` = 'TR346';\t----- bird -----\ttoxicology",
    "310": "SELECTCOUNT(DISTINCT b.molecule_id) AS molecules_with_double_bond_and_carcinogenic_label\nFROM bond b\nJOIN molecule m ON b.molecule_id = m.molecule_id\nWHERE b.bond_type = 'double'\nAND m.label = 'carcinogenic compound'\t----- bird -----\ttoxicology",
    "311": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nLEFT JOIN atom a ON m.molecule_id = a.molecule_id\nLEFT JOIN bond b ON m.molecule_id = b.molecule_id\nLEFT JOIN connected c ON a.atom_id = c.atom_id\nWHERE a.element != 'Sulphur' OR b.bond_type != 'Double' OR b.bond_type IS NULL\t----- bird -----\ttoxicology",
    "312": "SELECT`label` \nFROM `molecule` \nWHERE `molecule_id` = (\n    SELECT `molecule_id` \n    FROM `bond` \n    WHERE `bond_id` = 'TR001_2_4'\n)\t----- bird -----\ttoxicology",
    "313": "SELECTCOUNT(*) \nFROM atom \nWHERE molecule_id = 'TR001'\t----- bird -----\ttoxicology",
    "314": "SELECTCOUNT(*) \nFROM bond \nWHERE bond_type = 'single'\t----- bird -----\ttoxicology",
    "315": "SELECTm.molecule_id, m.label\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'cl'\nAND m.molecule_id IN (\n  SELECT m2.molecule_id\n  FROM molecule m2\n  WHERE m2.label = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "316": "SELECTDISTINCT m.molecule_id\nFROM atom a\nJOIN molecule m ON a.molecule_id = m.molecule_id\nWHERE a.element = 'c'\nAND m.molecule_id NOT IN (\n    SELECT m2.molecule_id\n    FROM molecule m2\n    JOIN atom a2 ON m2.molecule_id = a2.molecule_id\n    JOIN connected c ON a2.atom_id = c.atom_id OR a2.atom_id = c.atom_id2\n    JOIN bond b ON c.bond_id = b.bond_id\n    WHERE b.bond_type = 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "317": "SELECT\n(SELECT COUNT(DISTINCT molecule_id) FROM molecule WHERE label = 'carcinogenic') AS carcinogenic_molecules,\n(SELECT COUNT(DISTINCT molecule_id) FROM atom WHERE element = 'Chlorine') AS molecules_with_chlorine,\n(SELECT COUNT(DISTINCT molecule_id) FROM molecule WHERE label = 'carcinogenic' AND molecule_id IN \n(SELECT DISTINCT molecule_id FROM atom WHERE element = 'Chlorine')) AS carcinogenic_molecules_with_chlorine,\nROUND((carcinogenic_molecules_with_chlorine * 100.0) / carcinogenic_molecules, 2) AS percentage_carcinogenic_molecules_with_chlorine\t----- bird -----\ttoxicology",
    "318": "SELECT`molecule_id` \nFROM `bond` \nWHERE `bond_id` = 'TR001_1_7'\t----- bird -----\ttoxicology",
    "319": "SELECTCOUNT(*) \nFROM connected \nWHERE bond_id = 'TR001_3_4'\t----- bird -----\ttoxicology",
    "320": "SELECTbond.bond_type\nFROM connected\nJOIN bond ON connected.bond_id = bond.bond_id\nWHERE connected.atom_id = 'TR000_1' AND connected.atom_id2 = 'TR000_2'\t----- bird -----\ttoxicology",
    "321": "SELECTm1.label AS molecule_of_atom_id_TR000_2, m2.label AS molecule_of_atom_id_TR000_4\nFROM atom a1\nJOIN atom a2 ON a1.molecule_id = a2.molecule_id\nJOIN molecule m1 ON a1.molecule_id = m1.molecule_id\nJOIN molecule m2 ON a2.molecule_id = m2.molecule_id\nWHERE a1.atom_id = 'TR000_2' AND a2.atom_id = 'TR000_4'\t----- bird -----\ttoxicology",
    "322": "SELECTelement\nFROM atom\nWHERE atom_id = 'TR000_1'\t----- bird -----\ttoxicology",
    "323": "SELECTm.label\nFROM molecule m\nWHERE m.molecule_id = 'TR000'\t----- bird -----\ttoxicology",
    "324": "SELECT\n(SELECT COUNT(DISTINCT atom_id) FROM atom) AS total_atoms,\n(SELECT COUNT(DISTINCT atom_id) FROM connected WHERE bond_id IS NOT NULL) AS atoms_with_bond,\n((SELECT COUNT(DISTINCT atom_id) FROM connected WHERE bond_id IS NOT NULL) / (SELECT COUNT(DISTINCT atom_id) FROM atom)) * 100 AS percentage_atoms_with_single_bond\t----- bird -----\ttoxicology",
    "325": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN atom a ON m.molecule_id = a.molecule_id\nWHERE a.element = 'Nitrogen'\t----- bird -----\ttoxicology",
    "326": "SELECTmolecule_id\nFROM atom\nWHERE element = 'Sulphur' AND atom_id IN (\n  SELECT atom_id\n  FROM bond\n  WHERE bond_type = 'double'\n)\t----- bird -----\ttoxicology",
    "327": "SELECTmolecule_id, COUNT(atom_id) AS num_atoms\nFROM atom\nGROUP BY molecule_id\nHAVING num_atoms > 5\t----- bird -----\ttoxicology",
    "328": "SELECTatom.element\nFROM atom\nJOIN bond ON atom.molecule_id = bond.molecule_id\nJOIN connected ON atom.atom_id = connected.atom_id\nWHERE bond.bond_type = 'double'\nAND bond.molecule_id = 'TR024'\t----- bird -----\ttoxicology",
    "329": "SELECTmolecule_id, COUNT(atom_id) AS num_atoms\nFROM atom\nWHERE molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic')\nGROUP BY molecule_id\nORDER BY num_atoms DESC\nLIMIT 1\t----- bird -----\ttoxicology",
    "330": "SELECT\n(SELECT COUNT(DISTINCT m.molecule_id) \nFROM molecule m \nJOIN bond b ON m.molecule_id = b.molecule_id \nJOIN connected c ON b.bond_id = c.bond_id \nJOIN atom a ON c.atom_id = a.atom_id \nWHERE a.element = 'H' AND b.bond_type = 'triple') \n/ \n(SELECT COUNT(DISTINCT m.molecule_id) \nFROM molecule m \nJOIN bond b ON m.molecule_id = b.molecule_id \nJOIN connected c ON b.bond_id = c.bond_id \nJOIN atom a ON c.atom_id = a.atom_id \nWHERE m.label = 'carcinogenic') * 100 as percentage\t----- bird -----\ttoxicology",
    "331": "SELECTCOUNT(*) \nFROM molecule \nWHERE label = 'carcinogenic'\t----- bird -----\ttoxicology",
    "332": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE m.molecule_id BETWEEN 'TR004' AND 'TR010'\nAND b.bond_type = 'single'\t----- bird -----\ttoxicology",
    "333": "SELECTCOUNT(*) \nFROM atom \nWHERE molecule_id = 'TR008' \nAND element = 'carbon'\t----- bird -----\ttoxicology",
    "334": "SELECTelement\nFROM atom\nWHERE atom_id = 'TR004_7'\nAND molecule_id IN (\n    SELECT molecule_id\n    FROM molecule\n    WHERE label != 'carcinogenic'\n)\t----- bird -----\ttoxicology",
    "335": "SELECTCOUNT(DISTINCT molecule_id)\nFROM bond\nWHERE bond_type = 'double' \nAND molecule_id IN (\n    SELECT molecule_id\n    FROM atom\n    WHERE element = 'O'\n)\t----- bird -----\ttoxicology",
    "336": "SELECTCOUNT(DISTINCT m.molecule_id)\nFROM molecule m\nJOIN bond b ON m.molecule_id = b.molecule_id\nWHERE b.bond_type = 'triple'\nAND m.label != 'carcinogenic'\t----- bird -----\ttoxicology",
    "337": "SELECTa.element, b.bond_type\nFROM atom a\nJOIN bond b ON a.molecule_id = b.molecule_id\nWHERE a.molecule_id = 'TR002'\t----- bird -----\ttoxicology",
    "338": "SELECTatom.atom_id\nFROM atom\nJOIN molecule ON atom.molecule_id = molecule.molecule_id\nJOIN bond ON bond.molecule_id = molecule.molecule_id\nWHERE molecule.label = 'TR012' AND atom.element = 'C' AND bond.bond_type = 'double'\t----- bird -----\ttoxicology",
    "339": "SELECTatom_id\nFROM atom\nWHERE molecule_id IN (SELECT molecule_id FROM molecule WHERE label = 'carcinogenic') AND element = 'oxygen'\t----- bird -----\ttoxicology",
    "340": "SELECTname\nFROM cards\nWHERE hasFoil = 1\nAND convertedManaCost > 5\t----- bird -----\tcard_games",
    "341": "SELECTname\nFROM cards\nWHERE borderColor = 'borderless' AND hasFoil = 0\t----- bird -----\tcard_games",
    "342": "SELECTname\nFROM cards\nWHERE convertedManaCost > faceConvertedManaCost\t----- bird -----\tcard_games",
    "343": "SELECTname\nFROM cards\nWHERE frameVersion = '2015'\nAND edhrecRank < 100\t----- bird -----\tcard_games",
    "344": "SELECTc.name\nFROM cards c\nJOIN legalities l ON c.uuid = l.uuid\nWHERE l.format = 'gladiator'\nAND c.rarity = 'mythic'\nAND l.status = 'banned'\t----- bird -----\tcard_games",
    "345": "SELECTlegalities.status\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.types LIKE '%Artifact%'\nAND cards.faceName IS NULL\nAND legalities.format = 'Vintage'\t----- bird -----\tcard_games",
    "346": "SELECTcards.id, cards.artist\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.power = 'Unknown' AND legalities.format = 'Commander'\t----- bird -----\tcard_games",
    "347": "SELECTcards.name, rulings.text\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.artist = \"Stephen Daniel\"\t----- bird -----\tcard_games",
    "348": "SELECT* \nFROM cards \nWHERE name = 'Sublime Epiphany' AND number = '74s'\t----- bird -----\tcard_games",
    "349": "SELECTcards.name, cards.artist, COUNT(rulings.id) AS ruling_count\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nGROUP BY cards.name, cards.artist\nORDER BY ruling_count DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "350": "SELECTlanguage\nFROM foreign_data\nWHERE name = 'Annul' AND uuid = '29'\t----- bird -----\tcard_games",
    "351": "SELECTcards.name\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE foreign_data.language = 'Japanese'\t----- bird -----\tcard_games",
    "352": "SELECT\n(SELECT COUNT(DISTINCT uuid) FROM cards) AS total_cards,\n(SELECT COUNT(DISTINCT uuid) FROM foreign_data WHERE language = 'Chinese Simplified') AS chinese_cards,\nROUND((chinese_cards * 100.0) / total_cards, 2) AS percentage_chinese_cards\t----- bird -----\tcard_games",
    "353": "SELECTsets.name, COUNT(cards.uuid) AS total_cards\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nJOIN cards ON sets.code = cards.setCode\nWHERE set_translations.language = 'Italian'\nGROUP BY sets.name\t----- bird -----\tcard_games",
    "354": "SELECTCOUNT(DISTINCT name) \nFROM cards \nWHERE artist = 'Aaron Boyd'\t----- bird -----\tcard_games",
    "355": "SELECTkeywords\nFROM cards\nWHERE name = 'Angel of Mercy'\t----- bird -----\tcard_games",
    "356": "SELECTCOUNT(*)\nFROM cards\nWHERE power = '\u221e'\t----- bird -----\tcard_games",
    "357": "SELECTpromoTypes\nFROM cards\nWHERE name = 'Duress'\t----- bird -----\tcard_games",
    "358": "SELECTborderColor\nFROM cards\nWHERE name = \"Ancestor's Chosen\"\t----- bird -----\tcard_games",
    "359": "SELECTtype\nFROM cards\nWHERE name = \"Ancestor's Chosen\"\t----- bird -----\tcard_games",
    "360": "SELECTlanguage\nFROM set_translations\nWHERE setCode = (SELECT code FROM sets WHERE id = (SELECT id FROM cards WHERE name = 'Angel of Mercy'))\t----- bird -----\tcard_games",
    "361": "SELECTCOUNT(DISTINCT cards.uuid)\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.status = 'restricted'\nAND cards.text IS NOT NULL\t----- bird -----\tcard_games",
    "362": "SELECTr.text\nFROM rulings r\nJOIN cards c ON r.uuid = c.uuid\nWHERE c.name = \"Condemn\"\t----- bird -----\tcard_games",
    "363": "SELECTCOUNT(*) \nFROM cards \nJOIN legalities ON cards.uuid = legalities.uuid \nWHERE legalities.status = 'restricted' \nAND cards.isStarter = 1\t----- bird -----\tcard_games",
    "364": "SELECTlegalities.status\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.name = \"Cloudchaser Eagle\"\t----- bird -----\tcard_games",
    "365": "SELECTtype\nFROM cards\nWHERE name = \"Benalish Knight\"\t----- bird -----\tcard_games",
    "366": "SELECTr.text\nFROM rulings r\nJOIN cards c ON r.uuid = c.uuid\nWHERE c.name = \"Benalish Knight\"\t----- bird -----\tcard_games",
    "367": "SELECTartist\nFROM cards\nWHERE name = 'Phyrexian'\t----- bird -----\tcard_games",
    "368": "SELECT\n    COUNT(*) * 100.0 / (SELECT COUNT(*) FROM cards) AS borderless_percentage\nFROM cards\nWHERE borderColor = 'borderless'\t----- bird -----\tcard_games",
    "369": "SELECTCOUNT(DISTINCT c.uuid)\nFROM cards c\nJOIN foreign_data f ON c.uuid = f.uuid\nWHERE f.language = 'German'\nAND c.isReprint = 1\t----- bird -----\tcard_games",
    "370": "SELECTCOUNT(*) \nFROM cards \nWHERE borderColor = 'borderless' \nAND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Russian')\t----- bird -----\tcard_games",
    "371": "SELECT\n(SELECT COUNT(*) FROM cards WHERE isStorySpotlight = 1) AS total_story_spotlight_cards,\n(SELECT COUNT(*) FROM foreign_data WHERE language = 'French' AND uuid IN (SELECT uuid FROM cards WHERE isStorySpotlight = 1)) AS french_story_spotlight_cards,\n(SELECT COUNT(*) FROM cards WHERE isStorySpotlight = 1) AS total_story_spotlight_cards,\n(SELECT COUNT(*) FROM foreign_data WHERE uuid IN (SELECT uuid FROM cards WHERE isStorySpotlight = 1)) AS total_story_spotlight_foreign_data_cards,\n(CAST((SELECT COUNT(*) FROM foreign_data WHERE language = 'French' AND uuid IN (SELECT uuid FROM cards WHERE isStorySpotlight = 1)) AS REAL) / CAST((SELECT COUNT(*) FROM foreign_data WHERE uuid IN (SELECT uuid FROM cards WHERE isStorySpotlight = 1)) AS REAL)) * 100 AS percentage_french_story_spotlight_cards\t----- bird -----\tcard_games",
    "372": "SELECTCOUNT(*)\nFROM cards\nWHERE toughness = '99'\t----- bird -----\tcard_games",
    "373": "SELECTname\nFROM cards\nWHERE artist = 'Aaron Boyd'\t----- bird -----\tcard_games",
    "374": "SELECTCOUNT(*)\nFROM cards\nWHERE borderColor = 'black' AND availability = 'mtgo'\t----- bird -----\tcard_games",
    "375": "SELECTid\nFROM cards\nWHERE convertedManaCost = 0\t----- bird -----\tcard_games",
    "376": "SELECTlayout\nFROM cards\nWHERE keywords LIKE '%flying%'\t----- bird -----\tcard_games",
    "377": "SELECTCOUNT(*)\nFROM cards\nWHERE originalType = \"Summon - Angel\" AND subtypes != \"Angel\"\t----- bird -----\tcard_games",
    "378": "SELECTcards.id\nFROM cards\nWHERE cards.hasFoil = 1\nAND cards.hasNonFoil = 1\t----- bird -----\tcard_games",
    "379": "SELECTid\nFROM cards\nWHERE duelDeck = 'a'\t----- bird -----\tcard_games",
    "380": "SELECTedhrecRank\nFROM cards\nWHERE frameVersion = '2015'\t----- bird -----\tcard_games",
    "381": "SELECTcards.artist\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE foreign_data.language = 'Chinese Simplified'\t----- bird -----\tcard_games",
    "382": "SELECTc.name\nFROM cards c\nJOIN foreign_data fd ON c.uuid = fd.uuid\nWHERE c.availability = 'paper' AND fd.language = 'Japanese'\t----- bird -----\tcard_games",
    "383": "SELECTCOUNT(*) \nFROM cards \nJOIN legalities ON cards.uuid = legalities.uuid \nWHERE legalities.status = 'banned' \nAND cards.borderColor = 'white'\t----- bird -----\tcard_games",
    "384": "SELECTcards.uuid, foreign_data.language\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.format = 'legacy'\t----- bird -----\tcard_games",
    "385": "SELECTr.text\nFROM rulings r\nJOIN cards c ON r.uuid = c.uuid\nWHERE c.name = 'Beacon of Immortality'\t----- bird -----\tcard_games",
    "386": "SELECTCOUNT(*) AS num_cards, l.status\nFROM cards c\nJOIN legalities l ON c.uuid = l.uuid\nWHERE c.frameVersion = 'future'\t----- bird -----\tcard_games",
    "387": "SELECTc.name, c.colors\nFROM cards c\nJOIN sets s ON c.setCode = s.code\nWHERE s.code = 'OGW'\t----- bird -----\tcard_games",
    "388": "SELECTcards.name, set_translations.language\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE sets.name = '10E' AND cards.convertedManaCost = 5\t----- bird -----\tcard_games",
    "389": "SELECTcards.name, rulings.date\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.originalType = 'Creature - Elf'\t----- bird -----\tcard_games",
    "390": "SELECTcolors, format\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.id BETWEEN 1 AND 20\t----- bird -----\tcard_games",
    "391": "SELECTcards.name\nFROM cards\nJOIN colorIdentity ON cards.uuid = colorIdentity.uuid\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE colorIdentity = 'B'\t----- bird -----\tcard_games",
    "392": "SELECTc.name\nFROM cards c\nJOIN rulings r ON c.uuid = r.uuid\nWHERE c.rarity = 'uncommon'\nORDER BY r.date ASC\nLIMIT 3\t----- bird -----\tcard_games",
    "393": "SELECTCOUNT(*)\nFROM cards\nWHERE artist = 'John Avon' AND hasFoil = 1 AND isPromo = 0\t----- bird -----\tcard_games",
    "394": "SELECTCOUNT(*)\nFROM cards\nWHERE borderColor = 'white'\nAND power >= 4\t----- bird -----\tcard_games",
    "395": "SELECTCOUNT(*)\nFROM cards\nWHERE artist = 'UDON'\nAND availability = 'mtgo'\nAND hand = '-1'\t----- bird -----\tcard_games",
    "396": "SELECTCOUNT(*)\nFROM cards\nWHERE frameVersion = '1993'\nAND availability LIKE '%paper%'\nAND hasContentWarning = 1\t----- bird -----\tcard_games",
    "397": "SELECTmanaCost\nFROM cards\nWHERE layout = 'normal'\nAND frameVersion = '2003'\nAND borderColor = 'black'\nAND availability = 'paper, mtgo'\t----- bird -----\tcard_games",
    "398": "SELECTSUM(convertedManaCost) \nFROM cards \nWHERE artist = 'Rob Alexander'\t----- bird -----\tcard_games",
    "399": "SELECT DISTINCT type\nFROM cards\nWHERE mtgArenaId IS NOT NULL\t----- bird -----\tcard_games",
    "400": "SELECTsets.code\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE set_translations.language = 'Spanish'\t----- bird -----\tcard_games",
    "401": "SELECT\n    COUNT(*) * 100.0 / (SELECT COUNT(*) FROM cards WHERE frameEffects LIKE '%legendary%' AND isOnlineOnly = 1) \n    FROM cards \n    WHERE frameEffects LIKE '%legendary%' AND isOnlineOnly = 1\t----- bird -----\tcard_games",
    "402": "SELECTcards.id\nFROM cards\nWHERE isStorySpotlight = 1\nAND (text IS NULL OR text = '')\nORDER BY cards.id\t----- bird -----\tcard_games",
    "403": "SELECT\n(SELECT COUNT(*) FROM foreign_data WHERE language = 'Spanish') * 100.0 / (SELECT COUNT(*) FROM foreign_data) AS percentage,\n(SELECT name FROM cards WHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'Spanish')) AS card_names\t----- bird -----\tcard_games",
    "404": "SELECTlanguage\nFROM set_translations\nWHERE setCode = (SELECT code FROM sets WHERE totalSetSize = 309)\t----- bird -----\tcard_games",
    "405": "SELECTCOUNT(*) \nFROM set_translations \nWHERE language = 'Brazilian Portuguese' \nAND setCode IN \n    (SELECT code \n     FROM sets \n     WHERE block = 'Commander')\t----- bird -----\tcard_games",
    "406": "SELECTcards.id, cards.name\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.types LIKE '%Creature%'\nAND legalities.format = 'Legal'\t----- bird -----\tcard_games",
    "407": "SELECTDISTINCT type\nFROM cards\nWHERE uuid IN (SELECT uuid FROM foreign_data WHERE language = 'German')\t----- bird -----\tcard_games",
    "408": "SELECTCOUNT(*) \nFROM cards \nWHERE power = 'Unknown' \nAND text LIKE '%triggered ability%'\t----- bird -----\tcard_games",
    "409": "SELECTCOUNT(*) \nFROM cards \nJOIN legalities ON cards.uuid = legalities.uuid \nJOIN rulings ON cards.uuid = rulings.uuid \nWHERE legalities.format = 'pre-modern' \nAND rulings.text = 'This is a triggered mana ability.' \nAND cards.faceName IS NULL\t----- bird -----\tcard_games",
    "410": "SELECTcards.id\nFROM cards\nWHERE artist = 'Erica Yang'\nAND legalities.format = 'pauper'\nAND availability = 'paper'\t----- bird -----\tcard_games",
    "411": "SELECTartist\nFROM cards\nWHERE flavorText = \"Das perfekte Gegenmittel zu einer dichten Formation\"\t----- bird -----\tcard_games",
    "412": "SELECTcards.name\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE foreign_data.language = 'French'\nAND cards.type LIKE '%Creature%'\nAND cards.layout = 'normal'\nAND cards.borderColor = 'black'\nAND cards.artist = 'Matthew D. Wilson'\t----- bird -----\tcard_games",
    "413": "SELECTCOUNT(*) \nFROM cards \nJOIN rulings ON cards.uuid = rulings.uuid \nWHERE cards.rarity = 'Print' \nAND rulings.date = '01/02/2007'\t----- bird -----\tcard_games",
    "414": "SELECTset_translations.translation\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE sets.totalSetSize = 180\nAND sets.block = 'Ravnica'\t----- bird -----\tcard_games",
    "415": "SELECTROUND((COUNT(DISTINCT c.uuid) - COUNT(DISTINCT c.uuid) * SUM(l.status = 'legal' AND l.format = 'commander' AND c.hasContentWarning = 1) / COUNT(DISTINCT c.uuid)) / COUNT(DISTINCT c.uuid) * 100, 2) AS percentage_no_content_warning\nFROM cards c\nJOIN legalities l ON c.uuid = l.uuid\t----- bird -----\tcard_games",
    "416": "SELECT\n(SELECT COUNT(*) FROM cards WHERE power IS NULL AND uuid IN (SELECT uuid FROM foreign_data WHERE language = 'French')) * 100.0 / (SELECT COUNT(*) FROM cards WHERE power IS NULL) as percentage_without_power_in_french\t----- bird -----\tcard_games",
    "417": "SELECT\n(SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese') AS total_japanese_sets,\n(SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese' \nAND setCode IN (SELECT code FROM sets WHERE type = 'expansion')) AS expansion_japanese_sets_percentage,\nROUND((CAST((SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese' \nAND setCode IN (SELECT code FROM sets WHERE type = 'expansion')) AS FLOAT) / \nCAST((SELECT COUNT(*) FROM set_translations WHERE language = 'Japanese') AS FLOAT)) * 100, 2) AS percentage_expansion_japanese_sets\t----- bird -----\tcard_games",
    "418": "SELECTcards.printings\nFROM cards\nWHERE cards.artist = 'Daren Bader'\t----- bird -----\tcard_games",
    "419": "SELECTCOUNT(*)\nFROM cards\nWHERE borderColor = 'none'\nAND colorIdentity IS NOT NULL\nAND edhrecRank > 12000\t----- bird -----\tcard_games",
    "420": "SELECTCOUNT(*) \nFROM cards \nWHERE isOversized = 1 OR isReprint = 1 OR isPromo = 1\t----- bird -----\tcard_games",
    "421": "SELECTc.name\nFROM cards c\nWHERE c.promoTypes LIKE '%arena league%'\nORDER BY c.name\nLIMIT 3\t----- bird -----\tcard_games",
    "422": "SELECTlanguage\nFROM foreign_data\nWHERE multiverseid = 149934\t----- bird -----\tcard_games",
    "423": "SELECTcards.cardKingdomFoilId, cards.cardKingdomId\nFROM cards\nORDER BY cards.cardKingdomFoilId ASC, cards.cardKingdomId ASC\nLIMIT 3\t----- bird -----\tcard_games",
    "424": "SELECTCOUNT(*) \nFROM cards \nWHERE layout != 'normal' OR layout IS NULL\t----- bird -----\tcard_games",
    "425": "SELECTcards.number\nFROM cards\nWHERE cards.number NOT IN (\n    SELECT cards.number\n    FROM cards\n    WHERE cards.number IN (\n        SELECT cards.number\n        FROM cards\n        WHERE cards.types LIKE '%//%'\n    )\n)\nAND cards.subtypes LIKE '%Angel%'\nAND cards.subtypes LIKE '%Wizard%'\t----- bird -----\tcard_games",
    "426": "SELECTsets.name\nFROM sets\nWHERE sets.isOnlineOnly = 0\nORDER BY sets.name ASC\nLIMIT 3\t----- bird -----\tcard_games",
    "427": "SELECTlanguage\nFROM set_translations\nWHERE setCode = 'ARC'\t----- bird -----\tcard_games",
    "428": "SELECTsets.name, set_translations.translation\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE sets.id = 5\t----- bird -----\tcard_games",
    "429": "SELECTsets.name, sets.type\nFROM sets\nWHERE sets.id = 206\t----- bird -----\tcard_games",
    "430": "SELECTsets.name, sets.id\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE set_translations.language = 'Italian'\nAND sets.block = 'Shadowmoor'\nORDER BY sets.name\nLIMIT 2\t----- bird -----\tcard_games",
    "431": "SELECTsets.id\nFROM sets\nWHERE sets.isForeignOnly = 1\nAND sets.isFoilOnly = 1\nAND sets.code IN (SELECT setCode FROM set_translations WHERE language = 'Japanese')\t----- bird -----\tcard_games",
    "432": "SELECTsets.name, COUNT(cards.name) AS card_count\nFROM sets\nJOIN cards ON sets.code = cards.setCode\nWHERE sets.code IN (SELECT setCode FROM set_translations WHERE language = 'Russian')\nGROUP BY sets.name\nORDER BY card_count DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "433": "SELECT\n    COUNT(DISTINCT c.uuid) * 100.0 / (SELECT COUNT(DISTINCT uuid) FROM foreign_data WHERE language = 'Chinese Simplified') AS percentage\nFROM cards c\nJOIN foreign_data fd ON c.uuid = fd.uuid\nJOIN sets s ON c.setCode = s.code\nWHERE fd.language = 'Chinese Simplified' AND s.isOnlineOnly = 1\t----- bird -----\tcard_games",
    "434": "SELECTCOUNT(*) \nFROM sets \nWHERE isOnlineOnly = 0 \nAND isForeignOnly = 1\t----- bird -----\tcard_games",
    "435": "SELECTCOUNT(id) AS border_black_count, id\nFROM cards\nWHERE borderColor = 'black'\t----- bird -----\tcard_games",
    "436": "SELECTid\nFROM cards\nWHERE frameEffects = 'extendedart'\t----- bird -----\tcard_games",
    "437": "SELECTname\nFROM cards\nWHERE borderColor = 'black' AND isFullArt = 1\t----- bird -----\tcard_games",
    "438": "SELECTlanguage\nFROM sets\nWHERE id = 174\t----- bird -----\tcard_games",
    "439": "SELECTname\nFROM sets\nWHERE code = \"ALL\"\t----- bird -----\tcard_games",
    "440": "SELECTlanguage\nFROM foreign_data\nWHERE name = \"A Pedra Fellwar\"\t----- bird -----\tcard_games",
    "441": "SELECTcode\nFROM sets\nWHERE releaseDate = '2007-07-13'\t----- bird -----\tcard_games",
    "442": "SELECTsets.baseSetSize, sets.code\nFROM sets\nWHERE sets.block = \"Masques\" OR sets.block = \"Mirage\"\t----- bird -----\tcard_games",
    "443": "SELECTsets.code\nFROM sets\nWHERE sets.type = 'expansion'\t----- bird -----\tcard_games",
    "444": "SELECTcards.name AS foreign_name, cards.type\nFROM cards\nWHERE cards.watermark = 'Boros'\t----- bird -----\tcard_games",
    "445": "SELECTcards.language, cards.flavorText, cards.type\nFROM cards\nWHERE cards.watermark = \"colorpie\"\t----- bird -----\tcard_games",
    "446": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM cards WHERE convertedManaCost = 10 AND setCode = 'Abyssal Horror') \nFROM cards \nWHERE convertedManaCost = 10 AND setCode = 'Abyssal Horror'\t----- bird -----\tcard_games",
    "447": "SELECTsets.code\nFROM sets\nWHERE sets.type = 'expansion commander'\t----- bird -----\tcard_games",
    "448": "SELECTcards.name, cards.type\nFROM cards\nWHERE cards.watermark = 'abzan'\t----- bird -----\tcard_games",
    "449": "SELECTcards.language, cards.type\nFROM cards\nWHERE cards.watermark = 'Azorius'\t----- bird -----\tcard_games",
    "450": "SELECTCOUNT(*)\nFROM cards\nWHERE artist = 'Aaron Miller'\nAND power >= 5\t----- bird -----\tcard_games",
    "451": "SELECTCOUNT(*) \nFROM cards \nWHERE hand > 0 \nAND availability = 'paper'\t----- bird -----\tcard_games",
    "452": "SELECTname\nFROM cards\nWHERE text IS NOT NULL\t----- bird -----\tcard_games",
    "453": "SELECTconvertedManaCost\nFROM cards\nWHERE name = \"Ancestor's Chosen\"\t----- bird -----\tcard_games",
    "454": "SELECTCOUNT(*)\nFROM cards\nWHERE borderColor = 'white' AND power = 'unknown'\t----- bird -----\tcard_games",
    "455": "SELECTname\nFROM cards\nWHERE isPromo = 1\nAND layout = 'transform'\t----- bird -----\tcard_games",
    "456": "SELECTtypes\nFROM cards\nWHERE name = \"Molimo, Maro-Sorcerer\"\t----- bird -----\tcard_games",
    "457": "SELECTpurchaseUrls\nFROM cards\nWHERE promoTypes LIKE '%bundle%'\t----- bird -----\tcard_games",
    "458": "SELECTCOUNT(DISTINCT artist)\nFROM cards\nWHERE borderColor = 'black'\nAND availability LIKE '%arena%'\nAND availability LIKE '%mtgo%'\t----- bird -----\tcard_games",
    "459": "SELECTname, convertedManaCost\nFROM cards\nWHERE name = 'Serra Angel' OR name = 'Shrine Keeper'\t----- bird -----\tcard_games",
    "460": "SELECTartist\nFROM cards\nWHERE name = \"Battra, Dark Destroyer\"\t----- bird -----\tcard_games",
    "461": "SELECTname\nFROM cards\nWHERE frameVersion = '2003'\nORDER BY convertedManaCost DESC\nLIMIT 3\t----- bird -----\tcard_games",
    "462": "SELECTsets.name\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = \"Ancestor's Chosen\" AND sets.language = \"Italian\"\t----- bird -----\tcard_games",
    "463": "SELECTCOUNT(*) \nFROM set_translations \nWHERE setCode IN \n    (SELECT code \n     FROM sets \n     WHERE id IN \n         (SELECT id \n          FROM cards \n          WHERE name = \"Angel of Mercy\"))\t----- bird -----\tcard_games",
    "464": "SELECTname\nFROM cards\nWHERE setCode = (SELECT code FROM sets WHERE name = \"Hauptset Zehnte Edition\")\t----- bird -----\tcard_games",
    "465": "SELECTcards.name, foreign_data.language\nFROM cards\nJOIN foreign_data ON cards.uuid = foreign_data.uuid\nWHERE cards.name = \"Ancestor's Chosen\" AND foreign_data.language = \"Korean\"\t----- bird -----\tcard_games",
    "466": "SELECTCOUNT(*)\nFROM cards\nWHERE setCode = (SELECT code FROM sets WHERE name = \"Hauptset Zehnte Edition\")\nAND artist = \"Adam Rex\"\t----- bird -----\tcard_games",
    "467": "SELECTCOUNT(*)\nFROM cards\nWHERE setCode = '10E'\t----- bird -----\tcard_games",
    "468": "SELECTtranslation\nFROM set_translations\nJOIN sets ON set_translations.setCode = sets.code\nWHERE sets.name = \"Eighth Edition\"\nAND set_translations.language = \"Simplified Chinese\"\t----- bird -----\tcard_games",
    "469": "SELECTisOnlineOnly\nFROM cards\nWHERE name = \"Angel of Mercy\"\t----- bird -----\tcard_games",
    "470": "SELECTreleaseDate\nFROM sets\nWHERE code = (SELECT setCode FROM cards WHERE name = \"Ancestor's Chosen\")\t----- bird -----\tcard_games",
    "471": "SELECTtype\nFROM sets\nWHERE name = \"Hauptset Zehnte Edition\"\t----- bird -----\tcard_games",
    "472": "SELECTCOUNT(*) \nFROM sets \nWHERE block = 'Ice Age' \nAND code IN (SELECT setCode FROM set_translations WHERE language = 'Italian')\t----- bird -----\tcard_games",
    "473": "SELECTcards.name, sets.name, sets.isForeignOnly\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = 'Adarkar Valkyrie'\t----- bird -----\tcard_games",
    "474": "SELECTCOUNT(*)\nFROM sets\nWHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Italian')\nAND baseSetSize < 100\t----- bird -----\tcard_games",
    "475": "SELECTCOUNT(*)\nFROM cards\nWHERE borderColor = 'black'\nAND setCode = 'CSP'\t----- bird -----\tcard_games",
    "476": "SELECTcards.name\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE sets.name = 'Coldsnap'\nORDER BY cards.convertedManaCost DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "477": "SELECTartist\nFROM cards\nWHERE setCode = 'CSP' \nAND (artist = 'Jeremy Jarvis' OR artist = 'Aaron Miller' OR artist = 'Chippy')\t----- bird -----\tcard_games",
    "478": "SELECTcards.name, cards.number\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE sets.name = \"Coldsnap\"\nAND cards.number = \"4\"\t----- bird -----\tcard_games",
    "479": "SELECTCOUNT(*)\nFROM cards\nWHERE convertedManaCost > 5\nAND setCode = 'CSP'\nAND power = 'Unknown'\t----- bird -----\tcard_games",
    "480": "SELECTforeign_data.flavorText\nFROM foreign_data\nJOIN cards ON foreign_data.uuid = cards.uuid\nWHERE cards.name = \"Ancestor's Chosen\" AND foreign_data.language = \"Italian\"\t----- bird -----\tcard_games",
    "481": "SELECTlanguage\nFROM foreign_data\nWHERE name = 'Ancestor\\'s Chosen' AND flavorText IS NOT NULL\t----- bird -----\tcard_games",
    "482": "SELECTtypes\nFROM cards\nWHERE name = \"Ancestor's Chosen\"\t----- bird -----\tcard_games",
    "483": "SELECTrulings.text\nFROM rulings\nJOIN cards ON rulings.uuid = cards.uuid\nJOIN sets ON cards.setCode = sets.code\nWHERE sets.name = 'Coldsnap'\nAND rulings.language = 'Italian'\t----- bird -----\tcard_games",
    "484": "SELECTcards.name\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE sets.name = 'Coldsnap'\nORDER BY cards.convertedManaCost DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "485": "SELECTr.date\nFROM rulings r\nJOIN cards c ON r.uuid = c.uuid\nWHERE c.name = 'Reminisce'\t----- bird -----\tcard_games",
    "486": "SELECT\n(SELECT COUNT(*) FROM cards WHERE convertedManaCost = 7 AND setCode = 'CSP') * 100.0 / (SELECT COUNT(*) FROM cards WHERE setCode = 'CSP') as percentage\t----- bird -----\tcard_games",
    "487": "SELECT\n(SELECT COUNT(*) \nFROM cards \nWHERE setCode = 'CSP' \nAND convertedManaCost >= 6) * 100.0 / \n(SELECT COUNT(*) \nFROM cards \nWHERE setCode = 'CSP') as percentage_powerful_cards\t----- bird -----\tcard_games",
    "488": "SELECTcode\nFROM sets\nWHERE releaseDate = '2017-07-14'\t----- bird -----\tcard_games",
    "489": "SELECTkeyruneCode\nFROM sets\nWHERE code = 'PKHC'\t----- bird -----\tcard_games",
    "490": "SELECTmcmId\nFROM sets\nWHERE code = 'SS2'\t----- bird -----\tcard_games",
    "491": "SELECTsets.mcmName\nFROM sets\nWHERE sets.releaseDate = '2017-06-09'\t----- bird -----\tcard_games",
    "492": "SELECTtype\nFROM sets\nWHERE name = \"From the Vault: Lore\"\t----- bird -----\tcard_games",
    "493": "SELECTparentCode\nFROM sets\nWHERE name = \"Commander 2014 Oversized\"\t----- bird -----\tcard_games",
    "494": "SELECTcards.name, cards.artist, rulings.text\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.artist = 'Jim Pavelec'\t----- bird -----\tcard_games",
    "495": "SELECTsets.releaseDate\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = \"Evacuation\"\t----- bird -----\tcard_games",
    "496": "SELECTCOUNT(*)\nFROM sets\nWHERE name = \"Rinascita di Alara\"\t----- bird -----\tcard_games",
    "497": "SELECTtype\nFROM sets\nWHERE name = \"Huiti\u00e8me \u00e9dition\"\t----- bird -----\tcard_games",
    "498": "SELECTsets.name\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = \"Tendo Ice Bridge\"\t----- bird -----\tcard_games",
    "499": "SELECTCOUNT(translation) \nFROM set_translations \nWHERE setCode = (SELECT code FROM sets WHERE name = \"Tenth Edition\")\t----- bird -----\tcard_games",
    "500": "SELECTsets.name\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = \"Fellwar Stone\" AND sets.language = \"Japanese\"\t----- bird -----\tcard_games",
    "501": "SELECTname\nFROM cards\nWHERE setCode = 'JOU'\nORDER BY convertedManaCost DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "502": "SELECTreleaseDate\nFROM sets\nWHERE name = \"Ola de fr\u00edo\"\t----- bird -----\tcard_games",
    "503": "SELECTsets.type\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nWHERE cards.name = \"Samite Pilgrim\"\t----- bird -----\tcard_games",
    "504": "SELECTCOUNT(*)\nFROM cards\nWHERE setCode = 'World Championship Decks 2004'\nAND convertedManaCost = 3\t----- bird -----\tcard_games",
    "505": "SELECTtranslation\nFROM set_translations\nWHERE setCode = \"Mirrodin\"\nAND language = \"Simplified Chinese\"\t----- bird -----\tcard_games",
    "506": "SELECT\n(SELECT COUNT(DISTINCT s.code)\nFROM sets s\nJOIN set_translations st ON s.code = st.setCode\nWHERE st.language = 'Japanese' AND s.isNonFoilOnly = 1) * 100.0 / \n(SELECT COUNT(DISTINCT s.code)\nFROM sets s\nJOIN set_translations st ON s.code = st.setCode\nWHERE st.language = 'Japanese') as percentage_non_foil_only\t----- bird -----\tcard_games",
    "507": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM set_translations WHERE language = 'Brazil Portuguese') \nFROM sets \nWHERE code IN (SELECT setCode FROM set_translations WHERE language = 'Brazil Portuguese') \nAND isOnlineOnly = 1\t----- bird -----\tcard_games",
    "508": "SELECTDISTINCT printings\nFROM cards\nWHERE artist != 'Aleksi Briclot'\nAND text IS NULL\t----- bird -----\tcard_games",
    "509": "SELECTsets.id\nFROM sets\nORDER BY baseSetSize DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "510": "SELECTcards.artist\nFROM cards\nWHERE cards.faceName IS NULL\nORDER BY cards.convertedManaCost DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "511": "SELECTframeEffects, COUNT(*) AS count\nFROM cards\nWHERE hasFoil = 1\nGROUP BY frameEffects\nORDER BY count DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "512": "SELECTCOUNT(*)\nFROM cards\nWHERE power = 'unknown' \nAND hasFoil = 0 \nAND duelDeck = 'A'\t----- bird -----\tcard_games",
    "513": "SELECTsets.id\nFROM sets\nWHERE sets.type = 'Commander'\nORDER BY sets.totalSetSize DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "514": "SELECTname, convertedManaCost\nFROM cards\nORDER BY convertedManaCost DESC\nLIMIT 10\t----- bird -----\tcard_games",
    "515": "SELECTMIN(originalReleaseDate) AS oldest_mythic_release_date, legalities.format\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE rarity = 'mythic'\nORDER BY originalReleaseDate\nLIMIT 1\t----- bird -----\tcard_games",
    "516": "SELECTCOUNT(*) \nFROM cards \nJOIN foreign_data ON cards.uuid = foreign_data.uuid \nWHERE artist = 'Volkan Ba\u00c7\u00b5a' AND language = 'French'\t----- bird -----\tcard_games",
    "517": "SELECTCOUNT(*) \nFROM cards \nJOIN legalities ON cards.uuid = legalities.uuid \nWHERE rarity = 'Rare' \nAND type LIKE '%Enchantment%' \nAND name = 'Abundance' \nAND status = 'Legal'\t----- bird -----\tcard_games",
    "518": "SELECTlegalities.format, COUNT(legalities.status) AS banned_count\nFROM legalities\nWHERE legalities.status = 'banned'\nGROUP BY legalities.format\nORDER BY banned_count DESC\nLIMIT 1\t----- bird -----\tcard_games",
    "519": "SELECTlanguage\nFROM sets\nWHERE name = \"Battlebond\"\t----- bird -----\tcard_games",
    "520": "SELECTartist, COUNT(*) AS card_count, format\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nGROUP BY artist\nORDER BY card_count\nLIMIT 1\t----- bird -----\tcard_games",
    "521": "SELECTlegalities.status\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.frameVersion = '1997'\nAND cards.artist = 'D. Alexander Gregory'\nAND legalities.format = 'legacy'\nAND (cards.hasContentWarning = 1 OR cards.artist = 'Wizards of the Coast')\t----- bird -----\tcard_games",
    "522": "SELECTcards.name, legalities.format\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE cards.edhrecRank = 1\t----- bird -----\tcard_games",
    "523": "SELECTCOUNT(*) / 4 AS annual_average_sets_released, language\nFROM sets\nJOIN set_translations ON sets.code = set_translations.setCode\nWHERE releaseDate BETWEEN '2012-01-01' AND '2015-12-31'\nGROUP BY language\t----- bird -----\tcard_games",
    "524": "SELECTcards.artist\nFROM cards\nWHERE cards.borderColor = 'black'\nAND cards.availability = 'arena'\t----- bird -----\tcard_games",
    "525": "SELECTcards.uuid\nFROM cards\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE legalities.format = 'oldschool'\nAND (legalities.status = 'restricted' OR legalities.status = 'banned')\t----- bird -----\tcard_games",
    "526": "SELECTCOUNT(*)\nFROM cards\nWHERE artist = 'Matthew D. Wilson'\nAND availability = 'paper'\t----- bird -----\tcard_games",
    "527": "SELECTrulings.text, rulings.date\nFROM cards\nJOIN rulings ON cards.uuid = rulings.uuid\nWHERE cards.artist = 'Kev Walker'\nORDER BY rulings.date DESC\t----- bird -----\tcard_games",
    "528": "SELECTcards.name, legalities.format\nFROM cards\nJOIN sets ON cards.setCode = sets.code\nJOIN legalities ON cards.uuid = legalities.uuid\nWHERE sets.name = \"Hour of Devastation\"\t----- bird -----\tcard_games",
    "529": "SELECTs.name\nFROM sets s\nLEFT JOIN set_translations st ON s.code = st.setCode\nWHERE st.language = 'Korean' AND st.language <> 'Japanese'\t----- bird -----\tcard_games",
    "530": "SELECTframeVersion, name\nFROM cards\nWHERE artist = 'Allen Williams';\t----- bird -----\tcard_games",
    "531": "SELECTDisplayName, Reputation\nFROM users\nWHERE DisplayName = 'Harlan' OR DisplayName = 'Jarrod Dixon'\t----- bird -----\tcodebase_community",
    "532": "SELECTDisplayName\nFROM users\nWHERE strftime('%Y', CreationDate) = '2011'\t----- bird -----\tcodebase_community",
    "533": "SELECTCOUNT(*)\nFROM users\nWHERE LastAccessDate > '2014-09-01'\t----- bird -----\tcodebase_community",
    "534": "SELECTDisplayName\nFROM users\nWHERE Views = (SELECT MAX(Views) FROM users)\t----- bird -----\tcodebase_community",
    "535": "SELECTCOUNT(*) \nFROM users \nWHERE UpVotes > 100 AND DownVotes > 1\t----- bird -----\tcodebase_community",
    "536": "SELECTCOUNT(*)\nFROM users\nWHERE Views > 10\nAND CreationDate > '2013-01-01'\t----- bird -----\tcodebase_community",
    "537": "SELECTCOUNT(*)\nFROM posts\nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\t----- bird -----\tcodebase_community",
    "538": "SELECTTitle\nFROM posts\nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\t----- bird -----\tcodebase_community",
    "539": "SELECTusers.DisplayName\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE posts.Title = \"Eliciting priors from experts\"\t----- bird -----\tcodebase_community",
    "540": "SELECTp.Title\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE u.DisplayName = 'csgillespie'\nORDER BY p.ViewCount DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "541": "SELECTOwnerDisplayName\nFROM posts\nWHERE Score = (SELECT MAX(Score) FROM posts)\t----- bird -----\tcodebase_community",
    "542": "SELECTCOUNT(*) AS TotalComments\nFROM comments\nWHERE UserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\t----- bird -----\tcodebase_community",
    "543": "SELECTposts.Id, posts.Title, posts.AnswerCount\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE users.DisplayName = 'csgillespie'\nORDER BY posts.AnswerCount DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "544": "SELECTLastEditorDisplayName\nFROM posts\nWHERE Title = 'Examples for teaching: Correlation does not mean causation'\t----- bird -----\tcodebase_community",
    "545": "SELECTCOUNT(*)\nFROM posts\nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\nAND ParentId IS NULL\t----- bird -----\tcodebase_community",
    "546": "SELECTusers.DisplayName\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE posts.LastEditorUserId IS NOT NULL\t----- bird -----\tcodebase_community",
    "547": "SELECTCOUNT(*)\nFROM posts\nWHERE OwnerUserId IN (SELECT Id FROM users WHERE Age > 60)\nAND Score > 19\t----- bird -----\tcodebase_community",
    "548": "SELECTLocation\nFROM users\nWHERE Id = (SELECT OwnerUserId FROM posts WHERE Title = 'Eliciting priors from experts')\t----- bird -----\tcodebase_community",
    "549": "SELECTposts.Body\nFROM tags\nJOIN posts ON tags.ExcerptPostId = posts.Id\nWHERE tags.TagName = \"bayesian\"\t----- bird -----\tcodebase_community",
    "550": "SELECTposts.Body\nFROM tags\nJOIN posts ON tags.ExcerptPostId = posts.Id\nORDER BY tags.Count DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "551": "SELECTCOUNT(*)\nFROM badges\nWHERE UserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\t----- bird -----\tcodebase_community",
    "552": "SELECTName\nFROM badges\nWHERE UserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\t----- bird -----\tcodebase_community",
    "553": "SELECTCOUNT(*)\nFROM badges\nWHERE UserId = (SELECT Id FROM users WHERE DisplayName = 'csgillespie')\nAND strftime('%Y', Date) = '2011'\t----- bird -----\tcodebase_community",
    "554": "SELECTu.DisplayName\nFROM users u\nJOIN badges b ON u.Id = b.UserId\nGROUP BY u.Id\nORDER BY COUNT(b.Id) DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "555": "SELECTAVG(p.Score)\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE u.DisplayName = 'csgillespie'\t----- bird -----\tcodebase_community",
    "556": "SELECTAVG(badges.Name) \nFROM badges \nJOIN users ON badges.UserId = users.Id \nJOIN posts ON users.Id = posts.OwnerUserId \nWHERE posts.ViewCount > 200\t----- bird -----\tcodebase_community",
    "557": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM posts WHERE Score > 5) \nFROM posts \nJOIN users ON posts.OwnerUserId = users.Id \nWHERE users.Age >= 60 AND posts.Score > 5\t----- bird -----\tcodebase_community",
    "558": "SELECTCOUNT(*)\nFROM votes\nWHERE UserId = 58\nAND CreationDate = '2010-07-19'\t----- bird -----\tcodebase_community",
    "559": "SELECTMAX(CreationDate) AS MaxCreationDate\nFROM votes\t----- bird -----\tcodebase_community",
    "560": "SELECTCOUNT(*)\nFROM badges\nWHERE Name = 'Revival'\t----- bird -----\tcodebase_community",
    "561": "SELECTposts.Title\nFROM posts\nJOIN comments ON posts.Id = comments.PostId\nORDER BY comments.Score DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "562": "SELECTposts.Id, posts.ViewCount, COUNT(comments.Id) AS CommentCount\nFROM posts\nLEFT JOIN comments ON posts.Id = comments.PostId\nWHERE posts.ViewCount = 1910\nGROUP BY posts.Id, posts.ViewCount\t----- bird -----\tcodebase_community",
    "563": "SELECTposts.FavoriteCount\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE comments.UserId = 3025\nAND comments.CreationDate = '2014-04-23 20:29:39'\t----- bird -----\tcodebase_community",
    "564": "SELECTcomments.Text\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE posts.ParentId = 107829\t----- bird -----\tcodebase_community",
    "565": "SELECTp.Title, p.LastEditDate\nFROM posts p\nJOIN comments c ON p.Id = c.PostId\nJOIN users u ON c.UserId = u.Id\nWHERE u.Id = 23853\nAND c.CreationDate = '2013-07-12 09:08:18'\t----- bird -----\tcodebase_community",
    "566": "SELECTReputation\nFROM users\nWHERE Id = (SELECT OwnerUserId FROM posts WHERE Id = 65041)\t----- bird -----\tcodebase_community",
    "567": "SELECTCOUNT(*) \nFROM posts \nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = \"Tiago Pasqualini\")\t----- bird -----\tcodebase_community",
    "568": "SELECTDisplayName\nFROM users\nWHERE Id = (SELECT UserId FROM votes WHERE Id = 6347)\t----- bird -----\tcodebase_community",
    "569": "SELECTCOUNT(*)\nFROM votes\nWHERE PostId = (SELECT Id FROM posts WHERE Title = 'Data Visualization')\t----- bird -----\tcodebase_community",
    "570": "SELECTb.Name\nFROM users u\nJOIN badges b ON u.Id = b.UserId\nWHERE u.DisplayName = \"DatEpicCoderGuyWhoPrograms\"\t----- bird -----\tcodebase_community",
    "571": "SELECT(SELECT COUNT(*) FROM posts WHERE OwnerUserId = 24) / (SELECT COUNT(*) FROM votes WHERE UserId = 24) as Post_Vote_Ratio\t----- bird -----\tcodebase_community",
    "572": "SELECTViewCount\nFROM posts\nWHERE Title = 'Integration of Weka and/or RapidMiner into Informatica PowerCenter/Developer'\t----- bird -----\tcodebase_community",
    "573": "SELECT* \nFROM comments\nWHERE Score = 17\t----- bird -----\tcodebase_community",
    "574": "SELECTDisplayName\nFROM users\nWHERE WebsiteUrl = 'http://stackoverflow.com'\t----- bird -----\tcodebase_community",
    "575": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.DisplayName = 'SilentGhost'\t----- bird -----\tcodebase_community",
    "576": "SELECTusers.DisplayName\nFROM comments\nJOIN users ON comments.UserId = users.Id\nWHERE comments.Text = 'thank you user93!'\t----- bird -----\tcodebase_community",
    "577": "SELECTcomments.Text\nFROM comments\nJOIN users ON comments.UserId = users.Id\nWHERE users.DisplayName = 'A Lion'\t----- bird -----\tcodebase_community",
    "578": "SELECTusers.DisplayName, users.Reputation\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE posts.Title = 'Understanding what Dassault iSight is doing?'\t----- bird -----\tcodebase_community",
    "579": "SELECTcomments.Text\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE posts.Title = 'How does gentle boosting differ from AdaBoost?'\t----- bird -----\tcodebase_community",
    "580": "SELECTusers.DisplayName\nFROM users\nJOIN badges ON users.Id = badges.UserId\nWHERE badges.Name = 'Necromancer'\nLIMIT 10\t----- bird -----\tcodebase_community",
    "581": "SELECTu.DisplayName\nFROM posts p\nJOIN users u ON p.LastEditorUserId = u.Id\nWHERE p.Title = 'Open source tools for visualizing multi-dimensional data'\t----- bird -----\tcodebase_community",
    "582": "SELECTposts.Title\nFROM posts\nJOIN users ON posts.LastEditorUserId = users.Id\nWHERE users.DisplayName = 'Vebjorn Ljosa'\t----- bird -----\tcodebase_community",
    "583": "SELECTSUM(p.Score) AS TotalScore, u.WebsiteUrl\nFROM posts p\nJOIN users u ON p.LastEditorUserId = u.Id\nWHERE u.DisplayName = 'Yevgeny'\t----- bird -----\tcodebase_community",
    "584": "SELECTcomments.Text\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE posts.Title = 'Why square the difference instead of taking the absolute value in standard deviation?'\t----- bird -----\tcodebase_community",
    "585": "SELECTSUM(BountyAmount)\nFROM votes\nWHERE PostId IN (SELECT Id FROM posts WHERE Title = 'data')\t----- bird -----\tcodebase_community",
    "586": "SELECTusers.DisplayName\nFROM users\nJOIN votes ON users.Id = votes.UserId\nJOIN posts ON votes.PostId = posts.Id\nWHERE posts.Title = 'variance' AND votes.BountyAmount = 50\t----- bird -----\tcodebase_community",
    "587": "SELECTposts.Title, comments.Text\nFROM posts\nJOIN postLinks ON posts.Id = postLinks.PostId\nJOIN tags ON postLinks.RelatedPostId = tags.Id\nJOIN comments ON posts.Id = comments.PostId\nWHERE tags.TagName = 'humor'\nGROUP BY posts.Id\nORDER BY AVG(posts.ViewCount)\t----- bird -----\tcodebase_community",
    "588": "SELECTCOUNT(*)\nFROM comments\nWHERE UserId = 13\t----- bird -----\tcodebase_community",
    "589": "SELECTId, DisplayName, Reputation\nFROM users\nORDER BY Reputation DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "590": "SELECTId\nFROM users\nORDER BY Views\nLIMIT 1\t----- bird -----\tcodebase_community",
    "591": "SELECTCOUNT(*)\nFROM badges\nWHERE Name = 'supporter' AND strftime('%Y', Date) = '2011'\t----- bird -----\tcodebase_community",
    "592": "SELECTCOUNT(*)\nFROM badges\nGROUP BY UserId\nHAVING COUNT(*) > 5\t----- bird -----\tcodebase_community",
    "593": "SELECTCOUNT(*) \nFROM users \nWHERE Location = 'New York' \nAND Id IN (SELECT UserId FROM badges WHERE Name = 'Teacher' OR Name = 'Supporter')\t----- bird -----\tcodebase_community",
    "594": "SELECTusers.DisplayName, users.Reputation\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE posts.Id = 1\t----- bird -----\tcodebase_community",
    "595": "SELECTu.Id, u.DisplayName\nFROM users u\nJOIN posts p ON u.Id = p.OwnerUserId\nJOIN postHistory ph ON p.Id = ph.PostId\nWHERE p.ViewCount >= 1000\nGROUP BY u.Id\nHAVING COUNT(DISTINCT ph.Id) = 1\t----- bird -----\tcodebase_community",
    "596": "SELECTusers.Id, users.DisplayName, badges.Name\nFROM users\nJOIN comments ON users.Id = comments.UserId\nJOIN badges ON users.Id = badges.UserId\nGROUP BY users.Id\nORDER BY COUNT(comments.Id) DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "597": "SELECTCOUNT(*) \nFROM users \nWHERE Location = 'India' \nAND Id IN \n    (SELECT UserId \n     FROM badges \n     WHERE Name = 'Teacher')\t----- bird -----\tcodebase_community",
    "598": "SELECT\n    COUNT(*) AS TotalBadges,\n    SUM(CASE WHEN strftime('%Y', Date) = '2010' THEN 1 ELSE 0 END) AS Badges2010,\n    SUM(CASE WHEN strftime('%Y', Date) = '2011' THEN 1 ELSE 0 END) AS Badges2011,\n    (Badges2011 - Badges2010) * 100.0 / TotalBadges AS PercentageDifference\nFROM badges\nWHERE strftime('%Y', Date) IN ('2010', '2011')\t----- bird -----\tcodebase_community",
    "599": "SELECTDISTINCT UserId\nFROM postHistory\nWHERE PostId = 3720\t----- bird -----\tcodebase_community",
    "600": "SELECT* \nFROM posts\nWHERE Id = 61217\t----- bird -----\tcodebase_community",
    "601": "SELECTScore, LinkTypeId\nFROM posts\nJOIN postLinks ON posts.Id = postLinks.PostId\nWHERE posts.Id = 395\t----- bird -----\tcodebase_community",
    "602": "SELECTposts.Id\nFROM posts\nWHERE posts.Score > 60\t----- bird -----\tcodebase_community",
    "603": "SELECTSUM(FavoriteCount) \nFROM posts \nWHERE OwnerUserId = 686 \nAND strftime('%Y', CreaionDate) = '2011'\t----- bird -----\tcodebase_community",
    "604": "SELECTAVG(u.UpVotes) AS AvgUpVotes, AVG(u.Age) AS AvgAge\nFROM users u\nJOIN posts p ON u.Id = p.OwnerUserId\nGROUP BY u.Id\nHAVING COUNT(p.Id) > 10\t----- bird -----\tcodebase_community",
    "605": "SELECTCOUNT(*)\nFROM badges\nWHERE Name = 'Announcer'\t----- bird -----\tcodebase_community",
    "606": "SELECTName\nFROM badges\nWHERE Date = '2010-07-19 19:39:08'\t----- bird -----\tcodebase_community",
    "607": "SELECTCOUNT(*)\nFROM comments\nWHERE Score > 0\t----- bird -----\tcodebase_community",
    "608": "SELECTText\nFROM comments\nWHERE CreationDate = '2010-07-19 19:25:47'\t----- bird -----\tcodebase_community",
    "609": "SELECTCOUNT(*)\nFROM posts\nWHERE Score = 10\t----- bird -----\tcodebase_community",
    "610": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.Reputation = (SELECT MAX(Reputation) FROM users)\t----- bird -----\tcodebase_community",
    "611": "SELECTusers.Reputation\nFROM badges\nJOIN users ON badges.UserId = users.Id\nWHERE badges.Date = '2010-07-19 19:39:08'\t----- bird -----\tcodebase_community",
    "612": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.DisplayName = \"Pierre\"\t----- bird -----\tcodebase_community",
    "613": "SELECTb.Date\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.Location = 'Rochester, NY'\t----- bird -----\tcodebase_community",
    "614": "SELECTCOUNT(DISTINCT UserId) * 100.0 / (SELECT COUNT(DISTINCT Id) FROM users) AS Percentage\nFROM badges\nWHERE Name = 'Teacher'\t----- bird -----\tcodebase_community",
    "615": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM badges WHERE Name = 'Organizer') \nFROM users \nWHERE Id IN (SELECT UserId FROM badges WHERE Name = 'Organizer' AND Age < 20)\t----- bird -----\tcodebase_community",
    "616": "SELECTc.Score\nFROM comments c\nJOIN posts p ON c.PostId = p.Id\nWHERE p.CreaionDate = '2010-07-19 19:19:56'\t----- bird -----\tcodebase_community",
    "617": "SELECTcomments.Text\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE posts.CreationDate = '2010-07-19 19:37:33'\t----- bird -----\tcodebase_community",
    "618": "SELECTAge\nFROM users\nWHERE Location = 'Vienna, Austria'\t----- bird -----\tcodebase_community",
    "619": "SELECTCOUNT(*) \nFROM badges \nWHERE Name = 'Supporter' \nAND UserId IN (SELECT Id FROM users WHERE Age >= 18)\t----- bird -----\tcodebase_community",
    "620": "SELECTusers.Views\nFROM users\nJOIN badges ON users.Id = badges.UserId\nWHERE badges.Date = '2010-07-19 19:39:08'\t----- bird -----\tcodebase_community",
    "621": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.Reputation = (SELECT MIN(Reputation) FROM users)\t----- bird -----\tcodebase_community",
    "622": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.DisplayName = \"Sharpie\"\t----- bird -----\tcodebase_community",
    "623": "SELECTCOUNT(*)\nFROM badges\nWHERE Name = 'Supporter'\t----- bird -----\tcodebase_community",
    "624": "SELECTDisplayName\nFROM users\nWHERE Id = 30\t----- bird -----\tcodebase_community",
    "625": "SELECTCOUNT(*)\nFROM users\nWHERE Location = 'New York'\t----- bird -----\tcodebase_community",
    "626": "SELECTCOUNT(*)\nFROM votes\nWHERE CreationDate BETWEEN '2010-01-01' AND '2010-12-31'\t----- bird -----\tcodebase_community",
    "627": "SELECTCOUNT(*)\nFROM users\nWHERE Age >= 18\t----- bird -----\tcodebase_community",
    "628": "SELECTDisplayName\nFROM users\nORDER BY Views DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "629": "SELECT\n    (SELECT COUNT(*) FROM votes WHERE CreationDate BETWEEN '2010-01-01' AND '2010-12-31') AS votes_2010,\n    (SELECT COUNT(*) FROM votes WHERE CreationDate BETWEEN '2011-01-01' AND '2011-12-31') AS votes_2011,\n    (SELECT COUNT(*) FROM votes WHERE CreationDate BETWEEN '2010-01-01' AND '2011-12-31') AS total_votes,\n    (CAST((SELECT COUNT(*) FROM votes WHERE CreationDate BETWEEN '2010-01-01' AND '2010-12-31') AS FLOAT) / \n    CAST((SELECT COUNT(*) FROM votes WHERE CreationDate BETWEEN '2011-01-01' AND '2011-12-31') AS FLOAT)) AS ratio_2010_to_2011\t----- bird -----\tcodebase_community",
    "630": "SELECTTagName\nFROM tags\nWHERE Id = (SELECT Id FROM users WHERE DisplayName = 'John Salvatier')\t----- bird -----\tcodebase_community",
    "631": "SELECTCOUNT(*) \nFROM posts \nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'Daniel Vassallo')\t----- bird -----\tcodebase_community",
    "632": "SELECTCOUNT(*)\nFROM votes\nJOIN users ON votes.UserId = users.Id\nWHERE users.DisplayName = 'Harlan'\t----- bird -----\tcodebase_community",
    "633": "SELECTId\nFROM posts\nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'slashnick')\nORDER BY AnswerCount DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "634": "SELECTu.DisplayName, SUM(p.Score) as Popularity\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE u.DisplayName = 'Harvey Motulsky' OR u.DisplayName = 'Noah Snyder'\nGROUP BY u.DisplayName\nORDER BY Popularity DESC\t----- bird -----\tcodebase_community",
    "635": "SELECTCOUNT(*) \nFROM posts \nWHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'Matt Parker') \nAND Id IN (SELECT PostId FROM votes GROUP BY PostId HAVING COUNT(*) > 4)\t----- bird -----\tcodebase_community",
    "636": "SELECTCOUNT(*) \nFROM comments \nWHERE UserId = (SELECT Id FROM users WHERE DisplayName = 'Neil McGuigan') \nAND Score < 0\t----- bird -----\tcodebase_community",
    "637": "SELECTtags.TagName\nFROM tags\nJOIN posts ON tags.Id = posts.Tags\nLEFT JOIN comments ON posts.Id = comments.PostId\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE users.DisplayName = 'Mark Meckes'\nAND comments.Id IS NULL\t----- bird -----\tcodebase_community",
    "638": "SELECTusers.DisplayName\nFROM users\nJOIN badges ON users.Id = badges.UserId\nWHERE badges.Name = 'Organizer'\t----- bird -----\tcodebase_community",
    "639": "SELECT\n    COUNT(*) * 100.0 / (SELECT COUNT(*) FROM posts WHERE Tags LIKE '%<r>%') AS Percentage_R_Language\nFROM posts\nWHERE Tags LIKE '%<r>%'\t----- bird -----\tcodebase_community",
    "640": "SELECT\n    (SELECT SUM(ViewCount) FROM posts WHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'Mornington')) - \n    (SELECT SUM(ViewCount) FROM posts WHERE OwnerUserId = (SELECT Id FROM users WHERE DisplayName = 'Amos')) as ViewCountDifference\t----- bird -----\tcodebase_community",
    "641": "SELECTCOUNT(DISTINCT UserId)\nFROM badges\nWHERE Name = 'Commentator' AND strftime('%Y', Date) = '2014'\t----- bird -----\tcodebase_community",
    "642": "SELECTCOUNT(*)\nFROM posts\nWHERE CreaionDate = '2010-07-21'\t----- bird -----\tcodebase_community",
    "643": "SELECTDisplayName, Age\nFROM users\nWHERE Views = (SELECT MAX(Views) FROM users)\t----- bird -----\tcodebase_community",
    "644": "SELECTLastEditDate, LastEditorUserId\nFROM posts\nWHERE Title = \"Detecting a given face in a database of facial images\"\t----- bird -----\tcodebase_community",
    "645": "SELECTCOUNT(*)\nFROM comments\nWHERE UserId = 13\nAND Score < 0\t----- bird -----\tcodebase_community",
    "646": "SELECTposts.Title, comments.UserDisplayName\nFROM posts\nJOIN comments ON posts.Id = comments.PostId\nWHERE comments.Score > 0\t----- bird -----\tcodebase_community",
    "647": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE b.Date >= '2011-01-01' AND b.Date <= '2011-12-31'\nAND u.Location = 'North Pole'\t----- bird -----\tcodebase_community",
    "648": "SELECTusers.DisplayName, users.WebsiteUrl\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE posts.FavoriteCount > 150\t----- bird -----\tcodebase_community",
    "649": "SELECTCOUNT(*) AS PostHistoryCounts, MAX(LastEditDate) AS LastEditDate\nFROM postHistory\nWHERE PostId = (SELECT Id FROM posts WHERE Title = \"What is the best introductory Bayesian statistics textbook?\")\t----- bird -----\tcodebase_community",
    "650": "SELECTLastAccessDate, Location\nFROM users\nWHERE Id IN (SELECT UserId FROM badges WHERE Name = 'Outliers')\t----- bird -----\tcodebase_community",
    "651": "SELECTposts.Title\nFROM posts\nWHERE posts.Id = (\n    SELECT PostId\n    FROM postLinks\n    WHERE RelatedPostId = (\n        SELECT Id\n        FROM posts\n        WHERE Title = \"How to tell if something happened in a data set which monitors a value over time\"\n    )\n)\t----- bird -----\tcodebase_community",
    "652": "SELECTposts.Id, badges.Name\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nJOIN badges ON badges.UserId = users.Id\nWHERE users.DisplayName = 'Samuel' AND strftime('%Y', badges.Date) = '2013'\t----- bird -----\tcodebase_community",
    "653": "SELECTOwnerDisplayName\nFROM posts\nWHERE Score = (SELECT MAX(Score) FROM posts)\t----- bird -----\tcodebase_community",
    "654": "SELECTusers.DisplayName, users.Location\nFROM users\nJOIN posts ON users.Id = posts.OwnerUserId\nJOIN tags ON tags.ExcerptPostId = posts.Id\nWHERE tags.TagName = 'hypothesis-testing'\t----- bird -----\tcodebase_community",
    "655": "SELECTposts.Title, postLinks.LinkTypeId\nFROM posts\nJOIN postLinks ON posts.Id = postLinks.PostId\nWHERE posts.Title = \"What are principal component scores?\"\t----- bird -----\tcodebase_community",
    "656": "SELECTp.OwnerDisplayName\nFROM posts p\nWHERE p.Id = (SELECT PostId\n              FROM votes\n              WHERE Score = (SELECT MAX(Score)\n                             FROM posts))\t----- bird -----\tcodebase_community",
    "657": "SELECTu.DisplayName, u.WebsiteUrl\nFROM votes v\nJOIN users u ON v.UserId = u.Id\nWHERE v.VoteTypeId = 8\nORDER BY v.BountyAmount DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "658": "SELECTposts.Title\nFROM posts\nORDER BY posts.ViewCount DESC\nLIMIT 5\t----- bird -----\tcodebase_community",
    "659": "SELECTCOUNT(*)\nFROM tags\nWHERE Count BETWEEN 5000 AND 7000\t----- bird -----\tcodebase_community",
    "660": "SELECTOwnerUserId\nFROM posts\nWHERE Score = (SELECT MAX(Score) FROM posts)\t----- bird -----\tcodebase_community",
    "661": "SELECTMAX(LastAccessDate) AS OldestLastAccessDate\nFROM users\t----- bird -----\tcodebase_community",
    "662": "SELECTCOUNT(*) \nFROM posts \nJOIN votes ON posts.Id = votes.PostId \nWHERE votes.CreationDate LIKE '2011%' \nAND votes.BountyAmount = 50\t----- bird -----\tcodebase_community",
    "663": "SELECTId\nFROM users\nORDER BY Age ASC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "664": "SELECTSUM(Score)\nFROM posts\nWHERE CreationDate = '2010-07-19'\t----- bird -----\tcodebase_community",
    "665": "SELECTAVG(COUNT(pl.Id)) AS AverageMonthlyLinks\nFROM postLinks pl\nJOIN posts p ON pl.PostId = p.Id\nWHERE p.CreationDate BETWEEN '2010-01-01' AND '2010-12-31'\nAND p.AnswerCount <= 2\nGROUP BY strftime('%m', p.CreationDate)\t----- bird -----\tcodebase_community",
    "666": "SELECTPostId, MAX(BountyAmount) \nFROM votes \nWHERE UserId = 1465\t----- bird -----\tcodebase_community",
    "667": "SELECTposts.Title\nFROM posts\nJOIN postLinks ON posts.Id = postLinks.PostId\nORDER BY postLinks.CreationDate ASC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "668": "SELECTu.DisplayName\nFROM users u\nJOIN badges b ON u.Id = b.UserId\nGROUP BY u.Id\nORDER BY COUNT(b.Id) DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "669": "SELECTMIN(CreationDate) \nFROM votes \nJOIN users ON votes.UserId = users.Id \nWHERE DisplayName = 'chl'\t----- bird -----\tcodebase_community",
    "670": "SELECTMIN(users.CreationDate) AS \"Date of Youngest User's First Post\"\nFROM users\nJOIN posts ON users.Id = posts.OwnerUserId\t----- bird -----\tcodebase_community",
    "671": "SELECTu.DisplayName\nFROM users u\nJOIN badges b ON u.Id = b.UserId\nWHERE b.Name = 'Autobiographer'\nORDER BY b.Date\nLIMIT 1\t----- bird -----\tcodebase_community",
    "672": "SELECTCOUNT(DISTINCT u.Id)\nFROM users u\nJOIN posts p ON u.Id = p.OwnerUserId\nWHERE u.Location = 'United Kingdom'\nAND p.FavoriteCount >= 4\t----- bird -----\tcodebase_community",
    "673": "SELECTAVG(votes.PostId)\nFROM votes\nJOIN users ON votes.UserId = users.Id\nWHERE users.Age = (SELECT MAX(Age) FROM users)\t----- bird -----\tcodebase_community",
    "674": "SELECTDisplayName\nFROM users\nORDER BY Reputation DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "675": "SELECTCOUNT(*)\nFROM users\nWHERE Reputation > 2000 AND Views > 1000\t----- bird -----\tcodebase_community",
    "676": "SELECTDisplayName\nFROM users\nWHERE Age >= 18\t----- bird -----\tcodebase_community",
    "677": "SELECTCOUNT(*)\nFROM posts\nJOIN users ON posts.OwnerUserId = users.Id\nWHERE users.DisplayName = 'Jay Stevens'\nAND strftime('%Y', posts.CreaionDate) = '2010'\t----- bird -----\tcodebase_community",
    "678": "SELECTp.Id, p.Title\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE u.DisplayName = 'Harvey Motulsky'\nORDER BY p.ViewCount DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "679": "SELECTId, Title\nFROM posts\nORDER BY Score DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "680": "SELECTAVG(p.Score)\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE u.DisplayName = 'Stephen Turner'\t----- bird -----\tcodebase_community",
    "681": "SELECTusers.DisplayName\nFROM users\nJOIN posts ON users.Id = posts.OwnerUserId\nWHERE posts.ViewCount > 20000\nAND strftime('%Y', posts.CreaionDate) = '2011'\t----- bird -----\tcodebase_community",
    "682": "SELECTp.Id, u.DisplayName\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE p.CreationDate BETWEEN '2010-01-01' AND '2010-12-31'\nORDER BY p.Score DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "683": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM posts WHERE OwnerUserId IN (SELECT Id FROM users WHERE Reputation > 1000 AND strftime('%Y', CreationDate) = '2011')) FROM posts WHERE OwnerUserId IN (SELECT Id FROM users WHERE Reputation > 1000 AND strftime('%Y', CreationDate) = '2011')\t----- bird -----\tcodebase_community",
    "684": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM users) AS PercentageTeenageUsers\nFROM users\nWHERE Age >= 13 AND Age <= 19\t----- bird -----\tcodebase_community",
    "685": "SELECTSUM(ViewCount) AS TotalViews, \n       u.DisplayName AS LastPoster\nFROM posts p\nJOIN users u ON p.OwnerUserId = u.Id\nWHERE p.Title = 'Computer Game Datasets'\t----- bird -----\tcodebase_community",
    "686": "SELECTCOUNT(*)\nFROM posts\nWHERE ViewCount > (SELECT AVG(ViewCount) FROM posts)\t----- bird -----\tcodebase_community",
    "687": "SELECTCOUNT(*)\nFROM comments\nWHERE PostId = (SELECT Id\n                FROM posts\n                WHERE Score = (SELECT MAX(Score)\n                               FROM posts))\t----- bird -----\tcodebase_community",
    "688": "SELECTCOUNT(*)\nFROM posts\nWHERE ViewCount > 35000\nAND Id NOT IN (SELECT PostId FROM comments)\t----- bird -----\tcodebase_community",
    "689": "SELECTusers.DisplayName, users.Location\nFROM posts\nJOIN users ON posts.LastEditorUserId = users.Id\nWHERE posts.Id = 183\t----- bird -----\tcodebase_community",
    "690": "SELECTb.Name\nFROM badges b\nJOIN users u ON b.UserId = u.Id\nWHERE u.DisplayName = 'Emmett'\nORDER BY b.Date DESC\nLIMIT 1\t----- bird -----\tcodebase_community",
    "691": "SELECTCOUNT(*) \nFROM users \nWHERE Age >= 18 \nAND UpVotes > 5000\t----- bird -----\tcodebase_community",
    "692": "SELECT\n    b.Date - u.CreationDate AS TimeToGetBadge\nFROM\n    badges b\nJOIN users u ON b.UserId = u.Id\nWHERE\n    u.DisplayName = 'Zolomon'\t----- bird -----\tcodebase_community",
    "693": "SELECTu.DisplayName, COUNT(p.Id) AS NumPosts, COUNT(c.Id) AS NumComments\nFROM users u\nLEFT JOIN posts p ON u.Id = p.OwnerUserId\nLEFT JOIN comments c ON u.Id = c.UserId\nWHERE u.CreationDate = (SELECT MAX(CreationDate) FROM users)\nGROUP BY u.Id\t----- bird -----\tcodebase_community",
    "694": "SELECTcomments.Text, users.DisplayName\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nJOIN users ON comments.UserId = users.Id\nWHERE posts.Title = 'Analysing wind data with R'\nORDER BY comments.CreationDate DESC\nLIMIT 10\t----- bird -----\tcodebase_community",
    "695": "SELECTCOUNT(*)\nFROM badges\nWHERE Name = 'Citizen Patrol'\t----- bird -----\tcodebase_community",
    "696": "SELECTCOUNT(*)\nFROM posts\nWHERE Tags LIKE '%careers%'\t----- bird -----\tcodebase_community",
    "697": "SELECTReputation, ViewCount\nFROM users\nWHERE DisplayName = 'Jarrod Dixon'\t----- bird -----\tcodebase_community",
    "698": "SELECTCOUNT(*) \nFROM comments \nWHERE PostId = (SELECT Id FROM posts WHERE Title = 'Clustering 1D data') \nOR PostId = (SELECT Id FROM posts WHERE ParentId = (SELECT Id FROM posts WHERE Title = 'Clustering 1D data'))\t----- bird -----\tcodebase_community",
    "699": "SELECTCreationDate\nFROM users\nWHERE DisplayName = 'IrishStat'\t----- bird -----\tcodebase_community",
    "700": "SELECTCOUNT(*)\nFROM votes\nWHERE BountyAmount > 30\t----- bird -----\tcodebase_community",
    "701": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM posts WHERE OwnerUserId = (SELECT Id FROM users ORDER BY Reputation DESC LIMIT 1) AND Score > 50) \nFROM posts \nWHERE OwnerUserId = (SELECT Id FROM users ORDER BY Reputation DESC LIMIT 1) AND Score > 50\t----- bird -----\tcodebase_community",
    "702": "SELECTCOUNT(*)\nFROM posts\nWHERE Score < 20\t----- bird -----\tcodebase_community",
    "703": "SELECTCOUNT(*)\nFROM tags\nWHERE Id < 15 AND Count <= 20\t----- bird -----\tcodebase_community",
    "704": "SELECTExcerptPostId, WikiPostId\nFROM tags\nWHERE TagName = 'sample'\t----- bird -----\tcodebase_community",
    "705": "SELECTusers.Reputation, users.UpVotes\nFROM users\nJOIN comments ON users.Id = comments.UserId\nWHERE comments.Text = \"fine, you win :)\"\t----- bird -----\tcodebase_community",
    "706": "SELECTposts.Body\nFROM posts\nWHERE posts.Title = 'Linear Regression'\t----- bird -----\tcodebase_community",
    "707": "SELECTcomments.Text, MAX(comments.Score) AS HighestScore\nFROM comments\nJOIN posts ON comments.PostId = posts.Id\nWHERE posts.ViewCount BETWEEN 100 AND 150\t----- bird -----\tcodebase_community",
    "708": "SELECTusers.CreationDate, users.Age\nFROM comments\nJOIN users ON comments.UserId = users.Id\nWHERE users.WebsiteUrl IS NOT NULL\t----- bird -----\tcodebase_community",
    "709": "SELECTCOUNT(*)\nFROM posts\nWHERE PostTypeId = 1\nAND CommentCount = 0\nAND Score = 0\nAND ViewCount < 5\t----- bird -----\tcodebase_community",
    "710": "SELECTCOUNT(*)\nFROM posts\nJOIN comments ON posts.Id = comments.PostId\nWHERE posts.CommentCount = 1\nAND comments.Score = 0\t----- bird -----\tcodebase_community",
    "711": "SELECTCOUNT(DISTINCT u.Id) AS TotalUsersAge40\nFROM comments c\nJOIN users u ON c.UserId = u.Id\nWHERE c.Score = 0\nAND u.Age = 40\t----- bird -----\tcodebase_community",
    "712": "SELECTposts.Id, comments.Text\nFROM posts\nJOIN comments ON posts.Id = comments.PostId\nWHERE posts.Title = \"Group differences on a five point Likert item\"\t----- bird -----\tcodebase_community",
    "713": "SELECTUpVotes\nFROM users\nWHERE Id IN (SELECT UserId FROM comments WHERE Text = 'R is also lazy evaluated.')\t----- bird -----\tcodebase_community",
    "714": "SELECTcomments.Text\nFROM comments\nJOIN users ON comments.UserId = users.Id\nWHERE users.DisplayName = 'Harvey Motulsky'\t----- bird -----\tcodebase_community",
    "715": "SELECTusers.DisplayName\nFROM users\nWHERE users.DownVotes = 0\nORDER BY users.DisplayName\t----- bird -----\tcodebase_community",
    "716": "SELECTCOUNT(DISTINCT c.UserId) * 100.0 / (SELECT COUNT(DISTINCT c.UserId) FROM comments c WHERE c.Score BETWEEN 5 AND 10) \nFROM comments c \nJOIN users u ON c.UserId = u.Id \nWHERE c.Score BETWEEN 5 AND 10 AND u.UpVotes = 0\t----- bird -----\tcodebase_community",
    "717": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = '3-D Man'\t----- bird -----\tsuperhero",
    "718": "SELECTCOUNT(*) \nFROM superhero \nJOIN hero_power ON superhero.id = hero_power.hero_id \nJOIN superpower ON hero_power.power_id = superpower.id \nWHERE superpower.power_name = \"Super Strength\"\t----- bird -----\tsuperhero",
    "719": "SELECTCOUNT(*) \nFROM superhero \nJOIN hero_power ON superhero.id = hero_power.hero_id \nJOIN superpower ON hero_power.power_id = superpower.id \nWHERE superpower.power_name = \"Super Strength\" \nAND superhero.height_cm > 200\t----- bird -----\tsuperhero",
    "720": "SELECTsuperhero.full_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nGROUP BY superhero.id\nHAVING COUNT(hero_power.power_id) > 15\t----- bird -----\tsuperhero",
    "721": "SELECTCOUNT(*) \nFROM superhero \nWHERE eye_colour_id = (SELECT id FROM colour WHERE colour = 'blue')\t----- bird -----\tsuperhero",
    "722": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.skin_colour_id = colour.id\nWHERE superhero.superhero_name = 'Apocalypse'\t----- bird -----\tsuperhero",
    "723": "SELECTCOUNT(*) \nFROM superhero \nJOIN colour ON superhero.eye_colour_id = colour.id \nJOIN hero_power ON superhero.id = hero_power.hero_id \nJOIN superpower ON hero_power.power_id = superpower.id \nWHERE colour.colour = 'blue' \nAND superpower.power_name = 'Agility'\t----- bird -----\tsuperhero",
    "724": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN colour AS eye_colour ON superhero.eye_colour_id = eye_colour.id\nJOIN colour AS hair_colour ON superhero.hair_colour_id = hair_colour.id\nWHERE eye_colour.colour = 'blue' AND hair_colour.colour = 'blond'\t----- bird -----\tsuperhero",
    "725": "SELECTCOUNT(*)\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE publisher.publisher_name = 'Marvel Comics'\t----- bird -----\tsuperhero",
    "726": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE publisher.publisher_name = 'Marvel Comics'\nORDER BY superhero.height_cm DESC\t----- bird -----\tsuperhero",
    "727": "SELECTpublisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.superhero_name = 'Sauron'\t----- bird -----\tsuperhero",
    "728": "SELECTcolour.colour, COUNT(superhero.id) as eye_color_count\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE publisher.publisher_name = 'Marvel Comics'\nGROUP BY colour.colour\nORDER BY eye_color_count DESC\t----- bird -----\tsuperhero",
    "729": "SELECTAVG(height_cm)\nFROM superhero\nWHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')\t----- bird -----\tsuperhero",
    "730": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE publisher.publisher_name = 'Marvel Comics' AND superpower.power_name = 'Super Strength'\t----- bird -----\tsuperhero",
    "731": "SELECTCOUNT(*)\nFROM superhero\nWHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'DC Comics')\t----- bird -----\tsuperhero",
    "732": "SELECTpublisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.id = (\n    SELECT id\n    FROM superhero\n    ORDER BY weight_kg DESC\n    LIMIT 1\n)\t----- bird -----\tsuperhero",
    "733": "SELECTCOUNT(*) \nFROM superhero \nJOIN colour ON superhero.eye_colour_id = colour.id \nJOIN publisher ON superhero.publisher_id = publisher.id \nWHERE colour.colour = 'gold' \nAND publisher.publisher_name = 'Marvel Comics'\t----- bird -----\tsuperhero",
    "734": "SELECTpublisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.superhero_name = 'Blue Beetle II'\t----- bird -----\tsuperhero",
    "735": "SELECTCOUNT(*) \nFROM superhero \nWHERE hair_colour_id = (SELECT id FROM colour WHERE colour = 'blonde')\t----- bird -----\tsuperhero",
    "736": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE attribute.attribute_name = 'intelligence'\nORDER BY hero_attribute.attribute_value\nLIMIT 1\t----- bird -----\tsuperhero",
    "737": "SELECTrace.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE superhero.superhero_name = 'Copycat'\t----- bird -----\tsuperhero",
    "738": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE attribute.attribute_name = 'durability' AND hero_attribute.attribute_value < 50\t----- bird -----\tsuperhero",
    "739": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'death touch'\t----- bird -----\tsuperhero",
    "740": "SELECTCOUNT(*) \nFROM superhero \nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id \nJOIN attribute ON hero_attribute.attribute_id = attribute.id \nJOIN gender ON superhero.gender_id = gender.id \nWHERE gender.gender = 'female' \nAND attribute.attribute_name = 'strength' \nAND hero_attribute.attribute_value = 100\t----- bird -----\tsuperhero",
    "741": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nGROUP BY superhero.id\nORDER BY COUNT(hero_power.power_id) DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "742": "SELECTCOUNT(*) \nFROM superhero \nWHERE race_id = (SELECT id FROM race WHERE race = 'Vampire')\t----- bird -----\tsuperhero",
    "743": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero) AS percentage\nFROM superhero\nJOIN alignment ON superhero.alignment_id = alignment.id\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE alignment.alignment = 'Neutral' OR alignment.alignment = 'Chaotic Neutral'\nAND publisher.publisher_name = 'Marvel Comics'\t----- bird -----\tsuperhero",
    "744": "SELECTpublisher_name, COUNT(superhero.id) AS total_superheroes\nFROM publisher\nJOIN superhero ON publisher.id = superhero.publisher_id\nGROUP BY publisher_name\nORDER BY total_superheroes DESC\t----- bird -----\tsuperhero",
    "745": "SELECTid\nFROM publisher\nWHERE publisher_name = 'Star Trek'\t----- bird -----\tsuperhero",
    "746": "SELECTAVG(attribute_value) AS average_attribute_value\nFROM hero_attribute\t----- bird -----\tsuperhero",
    "747": "SELECTCOUNT(*)\nFROM superhero\nWHERE full_name IS NULL\t----- bird -----\tsuperhero",
    "748": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.id = 75\t----- bird -----\tsuperhero",
    "749": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = 'Deathlok'\t----- bird -----\tsuperhero",
    "750": "SELECTAVG(weight_kg)\nFROM superhero\nWHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female')\t----- bird -----\tsuperhero",
    "751": "SELECTsuperhero.superhero_name, superpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nJOIN gender ON superhero.gender_id = gender.id\nWHERE gender.gender = 'male'\nLIMIT 5\t----- bird -----\tsuperhero",
    "752": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE race.race = 'Alien'\t----- bird -----\tsuperhero",
    "753": "SELECTsuperhero.superhero_name\nFROM superhero\nWHERE superhero.height_cm >= 170 AND superhero.height_cm <= 190\nAND superhero.eye_colour_id IS NULL\t----- bird -----\tsuperhero",
    "754": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.id = 56\t----- bird -----\tsuperhero",
    "755": "SELECTsuperhero.superhero_name, superhero.full_name\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE race.race = 'Demi-God'\t----- bird -----\tsuperhero",
    "756": "SELECTCOUNT(*)\nFROM superhero\nWHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'bad')\t----- bird -----\tsuperhero",
    "757": "SELECTrace.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE superhero.weight_kg = 169\t----- bird -----\tsuperhero",
    "758": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.hair_colour_id = colour.id\nWHERE superhero.height_cm = 185\nAND superhero.race_id = (SELECT id FROM race WHERE race = 'Human')\t----- bird -----\tsuperhero",
    "759": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.weight_kg = (SELECT MAX(weight_kg) FROM superhero)\t----- bird -----\tsuperhero",
    "760": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE height_cm BETWEEN 150 AND 180) \nFROM superhero \nWHERE height_cm BETWEEN 150 AND 180 \nAND publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')\t----- bird -----\tsuperhero",
    "761": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN gender ON superhero.gender_id = gender.id\nWHERE gender.gender = 'Male'\nAND superhero.weight_kg > (SELECT 0.79 * AVG(weight_kg) FROM superhero)\t----- bird -----\tsuperhero",
    "762": "SELECTpower_name, COUNT(hero_id) AS total_heroes\nFROM superpower\nJOIN hero_power ON superpower.id = hero_power.power_id\nGROUP BY power_name\nORDER BY total_heroes DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "763": "SELECTattribute.attribute_name, hero_attribute.attribute_value\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE superhero.superhero_name = 'Abomination'\t----- bird -----\tsuperhero",
    "764": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.id = 1\t----- bird -----\tsuperhero",
    "765": "SELECTCOUNT(DISTINCT superhero.id)\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'stealth'\t----- bird -----\tsuperhero",
    "766": "SELECTsuperhero.full_name\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE attribute.attribute_name = 'strength'\nORDER BY hero_attribute.attribute_value DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "767": "SELECTAVG(height_cm) \nFROM superhero \nWHERE skin_colour_id IS NULL\t----- bird -----\tsuperhero",
    "768": "SELECTCOUNT(*) \nFROM superhero \nWHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Dark Horse Comics')\t----- bird -----\tsuperhero",
    "769": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE publisher.publisher_name = 'Dark Horse Comics'\nAND attribute.attribute_name = 'Durability'\nORDER BY hero_attribute.attribute_value DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "770": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.superhero_name = 'Abraham Sapien'\t----- bird -----\tsuperhero",
    "771": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'flight'\t----- bird -----\tsuperhero",
    "772": "SELECTcolour.colour AS eye_colour, \n       hair.colour AS hair_colour, \n       skin.colour AS skin_colour\nFROM superhero\nJOIN gender ON superhero.gender_id = gender.id\nJOIN colour AS eye ON superhero.eye_colour_id = eye.id\nJOIN colour AS hair ON superhero.hair_colour_id = hair.id\nJOIN colour AS skin ON superhero.skin_colour_id = skin.id\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE gender.gender = 'female'\nAND publisher.publisher_name = 'Dark Horse Comics'\t----- bird -----\tsuperhero",
    "773": "SELECTs.superhero_name, p.publisher_name\nFROM superhero s\nJOIN colour c1 ON s.eye_colour_id = c1.id\nJOIN colour c2 ON s.hair_colour_id = c2.id\nJOIN colour c3 ON s.skin_colour_id = c3.id\nJOIN publisher p ON s.publisher_id = p.id\nWHERE c1.colour = c2.colour\nAND c2.colour = c3.colour\t----- bird -----\tsuperhero",
    "774": "SELECTpublisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.superhero_name = 'A-Bomb'\t----- bird -----\tsuperhero",
    "775": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female')) \nFROM superhero \nWHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female') \nAND eye_colour_id = (SELECT id FROM colour WHERE colour = 'Blue')\t----- bird -----\tsuperhero",
    "776": "SELECTsuperhero.superhero_name, race.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE superhero.superhero_name = 'Charles Chandler'\t----- bird -----\tsuperhero",
    "777": "SELECTgender.gender\nFROM superhero\nJOIN gender ON superhero.gender_id = gender.id\nWHERE superhero.superhero_name = 'Agent 13'\t----- bird -----\tsuperhero",
    "778": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'Adaptation'\t----- bird -----\tsuperhero",
    "779": "SELECTCOUNT(*) \nFROM superhero \nJOIN hero_power ON superhero.id = hero_power.hero_id \nJOIN superpower ON hero_power.power_id = superpower.id \nWHERE superhero.superhero_name = 'Amazo'\t----- bird -----\tsuperhero",
    "780": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = 'Hunter Zolomon'\t----- bird -----\tsuperhero",
    "781": "SELECTsuperhero.superhero_name, superhero.height_cm\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE colour.colour = 'amber'\t----- bird -----\tsuperhero",
    "782": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN colour AS eye_colour ON superhero.eye_colour_id = eye_colour.id\nJOIN colour AS hair_colour ON superhero.hair_colour_id = hair_colour.id\nWHERE eye_colour.colour = 'black' AND hair_colour.colour = 'black'\t----- bird -----\tsuperhero",
    "783": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.skin_colour_id = (SELECT id FROM colour WHERE colour = 'gold')\t----- bird -----\tsuperhero",
    "784": "SELECTsuperhero.full_name\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE race.race = 'Vampire'\t----- bird -----\tsuperhero",
    "785": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN alignment ON superhero.alignment_id = alignment.id\nWHERE alignment.alignment = 'Neutral'\t----- bird -----\tsuperhero",
    "786": "SELECTCOUNT(hero_id)\nFROM hero_attribute\nWHERE attribute_id = (SELECT id FROM attribute WHERE attribute_name = 'strength')\nAND attribute_value = (SELECT MAX(attribute_value) FROM hero_attribute WHERE attribute_id = (SELECT id FROM attribute WHERE attribute_name = 'strength'))\t----- bird -----\tsuperhero",
    "787": "SELECTrace.race, alignment.alignment\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nJOIN alignment ON superhero.alignment_id = alignment.id\nWHERE superhero.superhero_name = 'Cameron Hicks'\t----- bird -----\tsuperhero",
    "788": "SELECTROUND((COUNT(*) * 100.0) / (SELECT COUNT(*) FROM superhero WHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female') AND publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')), 2) AS percentage_female_heroes_published_by_marvel\nFROM superhero\nWHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female') AND publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')\t----- bird -----\tsuperhero",
    "789": "SELECTAVG(weight_kg)\nFROM superhero\nWHERE race_id = (SELECT id FROM race WHERE race = 'alien')\t----- bird -----\tsuperhero",
    "790": "SELECT(s1.weight_kg - s2.weight_kg) AS weight_difference\nFROM superhero s1\nJOIN superhero s2 ON s1.superhero_name = 'Emil Blonsky' AND s2.superhero_name = 'Charles Chandler'\t----- bird -----\tsuperhero",
    "791": "SELECTsuperhero.superhero_name, AVG(superhero.height_cm) AS average_height\nFROM superhero\nGROUP BY superhero.superhero_name\t----- bird -----\tsuperhero",
    "792": "SELECTsuperhero.superhero_name, superpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = 'Abomination'\t----- bird -----\tsuperhero",
    "793": "SELECTCOUNT(*) \nFROM superhero \nWHERE race_id = (SELECT id FROM race WHERE race = 'god/eternal') \nAND gender_id = (SELECT id FROM gender WHERE gender = 'male')\t----- bird -----\tsuperhero",
    "794": "SELECT superhero.superhero_name\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE attribute.attribute_name = 'Speed'\nORDER BY hero_attribute.attribute_value DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "795": "SELECTCOUNT(*)\nFROM superhero\nWHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'Neutral')\t----- bird -----\tsuperhero",
    "796": "SELECTattribute.attribute_name, hero_attribute.attribute_value\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE superhero.superhero_name = '3-D Man'\t----- bird -----\tsuperhero",
    "797": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN colour AS eye_colour ON superhero.eye_colour_id = eye_colour.id\nJOIN colour AS hair_colour ON superhero.hair_colour_id = hair_colour.id\nWHERE eye_colour.colour = 'blue' AND hair_colour.colour = 'brown'\t----- bird -----\tsuperhero",
    "798": "SELECT superhero.superhero_name, publisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.superhero_name IN ('Hawkman', 'Karate Kid', 'Speedy')\t----- bird -----\tsuperhero",
    "799": "SELECTCOUNT(*) \nFROM superhero \nWHERE publisher_id IS NULL\t----- bird -----\tsuperhero",
    "800": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE eye_colour_id = (SELECT id FROM colour WHERE colour = 'blue')) \nFROM superhero \nWHERE eye_colour_id = (SELECT id FROM colour WHERE colour = 'blue')\t----- bird -----\tsuperhero",
    "801": "SELECTgender.gender, COUNT(superhero.id) as count\nFROM superhero\nJOIN gender ON superhero.gender_id = gender.id\nGROUP BY gender.gender\t----- bird -----\tsuperhero",
    "802": "SELECTsuperhero_name\nFROM superhero\nORDER BY height_cm DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "803": "SELECTid\nFROM superpower\nWHERE power_name = 'cryokinesis'\t----- bird -----\tsuperhero",
    "804": "SELECTsuperhero_name\nFROM superhero\nWHERE id = 294\t----- bird -----\tsuperhero",
    "805": "SELECTsuperhero.full_name\nFROM superhero\nWHERE superhero.weight_kg IS NULL\t----- bird -----\tsuperhero",
    "806": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.full_name = 'Karen Beecher-Duncan'\t----- bird -----\tsuperhero",
    "807": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.full_name = \"Helen Parr\"\t----- bird -----\tsuperhero",
    "808": "SELECTrace.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE superhero.weight_kg = 108\nAND superhero.height_cm = 188\t----- bird -----\tsuperhero",
    "809": "SELECTpublisher.publisher_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE superhero.id = 38\t----- bird -----\tsuperhero",
    "810": "SELECTrace.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nWHERE hero_attribute.attribute_value = (SELECT MAX(attribute_value) FROM hero_attribute)\t----- bird -----\tsuperhero",
    "811": "SELECTalignment.alignment, superpower.power_name\nFROM superhero\nJOIN alignment ON superhero.alignment_id = alignment.id\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = 'Atom IV'\t----- bird -----\tsuperhero",
    "812": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN colour eye_colour ON superhero.eye_colour_id = eye_colour.id\nWHERE eye_colour.colour = 'blue'\t----- bird -----\tsuperhero",
    "813": "SELECTAVG(attribute_value)\nFROM hero_attribute\nWHERE hero_id IN (SELECT id FROM superhero WHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'neutral'))\t----- bird -----\tsuperhero",
    "814": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.skin_colour_id = colour.id\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nWHERE hero_attribute.attribute_value = 100\t----- bird -----\tsuperhero",
    "815": "SELECTCOUNT(*)\nFROM superhero\nWHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female')\nAND alignment_id = (SELECT id FROM alignment WHERE alignment = 'Good')\t----- bird -----\tsuperhero",
    "816": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nWHERE hero_attribute.attribute_value BETWEEN 75 AND 80\t----- bird -----\tsuperhero",
    "817": "SELECTrace.race\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nJOIN colour AS hair_colour ON superhero.hair_colour_id = hair_colour.id\nJOIN gender ON superhero.gender_id = gender.id\nWHERE hair_colour.colour = 'blue' AND gender.gender = 'male'\t----- bird -----\tsuperhero",
    "818": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female')) \nFROM superhero \nWHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'Bad')\t----- bird -----\tsuperhero",
    "819": "SELECTCOUNT(*) \nFROM superhero \nWHERE weight_kg IS NULL \nAND (eye_colour_id IS NULL OR eye_colour_id = 0) - \n(SELECT COUNT(*) \nFROM superhero \nWHERE eye_colour_id = 1) as difference\t----- bird -----\tsuperhero",
    "820": "SELECTsuperhero.superhero_name, hero_attribute.attribute_value\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE superhero.superhero_name = 'Hulk' AND attribute.attribute_name = 'Strength'\t----- bird -----\tsuperhero",
    "821": "SELECTsuperhero.superhero_name, superpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.superhero_name = 'Ajax'\t----- bird -----\tsuperhero",
    "822": "SELECTCOUNT(*) \nFROM superhero \nWHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'villain') \nAND skin_colour_id = (SELECT id FROM colour WHERE colour = 'green')\t----- bird -----\tsuperhero",
    "823": "SELECTCOUNT(*) \nFROM superhero \nWHERE gender_id = (SELECT id FROM gender WHERE gender = 'Female') \nAND publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')\t----- bird -----\tsuperhero",
    "824": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'control wind'\nORDER BY superhero.superhero_name ASC\t----- bird -----\tsuperhero",
    "825": "SELECTgender.gender\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nJOIN gender ON superhero.gender_id = gender.id\nWHERE superpower.power_name = 'Phoenix Force'\t----- bird -----\tsuperhero",
    "826": "SELECTsuperhero.superhero_name\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE publisher.publisher_name = 'DC Comics'\nORDER BY superhero.weight_kg DESC\nLIMIT 1\t----- bird -----\tsuperhero",
    "827": "SELECTAVG(height_cm)\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nJOIN publisher ON superhero.publisher_id = publisher.id\nWHERE race.race <> 'Human' AND publisher.publisher_name = 'Dark Horse Comics'\t----- bird -----\tsuperhero",
    "828": "SELECTsuperhero.superhero_name, superhero.height_cm\nFROM superhero\nORDER BY superhero.height_cm DESC\nLIMIT 5\t----- bird -----\tsuperhero",
    "829": "SELECTpublisher.publisher_name, COUNT(superhero.id) AS num_superheroes\nFROM superhero\nJOIN publisher ON superhero.publisher_id = publisher.id\nGROUP BY publisher.publisher_name\t----- bird -----\tsuperhero",
    "830": "SELECTsuperhero.superhero_name, attribute.attribute_name, hero_attribute.attribute_value\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE superhero.superhero_name = 'Black Panther'\t----- bird -----\tsuperhero",
    "831": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.superhero_name = 'Abomination'\t----- bird -----\tsuperhero",
    "832": "SELECTsuperhero.superhero_name\nFROM superhero\nWHERE superhero.height_cm = (SELECT MAX(height_cm) FROM superhero)\t----- bird -----\tsuperhero",
    "833": "SELECTsuperhero_name\nFROM superhero\nWHERE full_name = 'Charles Chandler'\t----- bird -----\tsuperhero",
    "834": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'George Lucas') AND gender_id = (SELECT id FROM gender WHERE gender = 'Female')) FROM superhero WHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'George Lucas')\t----- bird -----\tsuperhero",
    "835": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM superhero WHERE publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')) \nFROM superhero \nWHERE alignment_id = (SELECT id FROM alignment WHERE alignment = 'good') \nAND publisher_id = (SELECT id FROM publisher WHERE publisher_name = 'Marvel Comics')\t----- bird -----\tsuperhero",
    "836": "SELECTCOUNT(*)\nFROM superhero\nWHERE superhero_name LIKE 'John%'\t----- bird -----\tsuperhero",
    "837": "SELECThero_id\nFROM hero_attribute\nWHERE attribute_value = (SELECT MIN(attribute_value) FROM hero_attribute)\t----- bird -----\tsuperhero",
    "838": "SELECTsuperhero.full_name\nFROM superhero\nWHERE superhero.superhero_name = 'Alien'\t----- bird -----\tsuperhero",
    "839": "SELECTsuperhero.full_name\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.weight_kg < 100\nAND colour.colour = 'brown'\t----- bird -----\tsuperhero",
    "840": "SELECTattribute.attribute_name, hero_attribute.attribute_value\nFROM superhero\nJOIN hero_attribute ON superhero.id = hero_attribute.hero_id\nJOIN attribute ON hero_attribute.attribute_id = attribute.id\nWHERE superhero.superhero_name = 'Aquababy'\t----- bird -----\tsuperhero",
    "841": "SELECTrace.race, superhero.weight_kg\nFROM superhero\nJOIN race ON superhero.race_id = race.id\nWHERE superhero.id = 40\t----- bird -----\tsuperhero",
    "842": "SELECTAVG(height_cm)\nFROM superhero\nJOIN alignment ON superhero.alignment_id = alignment.id\nWHERE alignment.alignment = 'neutral'\t----- bird -----\tsuperhero",
    "843": "SELECThero_id\nFROM hero_power\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superpower.power_name = 'intelligence'\t----- bird -----\tsuperhero",
    "844": "SELECTcolour.colour\nFROM superhero\nJOIN colour ON superhero.eye_colour_id = colour.id\nWHERE superhero.superhero_name = 'Blackwulf'\t----- bird -----\tsuperhero",
    "845": "SELECTsuperpower.power_name\nFROM superhero\nJOIN hero_power ON superhero.id = hero_power.hero_id\nJOIN superpower ON hero_power.power_id = superpower.id\nWHERE superhero.height_cm > (SELECT AVG(height_cm) * 0.8 FROM superhero)\t----- bird -----\tsuperhero",
    "846": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nWHERE qualifying.raceId = 20\nAND qualifying.q1 = 'DNQ'\t----- bird -----\tformula_1",
    "847": "SELECTdrivers.surname\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE races.round = 19\nAND qualifying.q2 = (SELECT MIN(q2) FROM qualifying WHERE raceId = races.raceId AND q2 IS NOT NULL)\t----- bird -----\tformula_1",
    "848": "SELECTraces.year\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.location = 'Shanghai'\t----- bird -----\tformula_1",
    "849": "SELECTcircuits.name, circuits.location, circuits.country\nFROM circuits\nWHERE circuits.name = 'Circuit de Barcelona-Catalunya'\t----- bird -----\tformula_1",
    "850": "SELECTraces.name\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.country = 'Germany'\t----- bird -----\tformula_1",
    "851": "SELECTcircuits.name, circuits.location, circuits.country\nFROM circuits\nJOIN constructorResults ON circuits.circuitId = constructorResults.raceId\nJOIN constructors ON constructorResults.constructorId = constructors.constructorId\nWHERE constructors.name = 'Renault'\t----- bird -----\tformula_1",
    "852": "SELECTCOUNT(*)\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE races.year = 2010\nAND circuits.country NOT IN ('Asia', 'Europe')\t----- bird -----\tformula_1",
    "853": "SELECTraces.name\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.country = 'Spain'\t----- bird -----\tformula_1",
    "854": "SELECTlat, lng\nFROM circuits\nWHERE circuitRef = 'albert_park'\t----- bird -----\tformula_1",
    "855": "SELECTraces.name, races.date\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Sepang International Circuit'\t----- bird -----\tformula_1",
    "856": "SELECTraces.name, races.date, races.time\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Sepang International Circuit'\t----- bird -----\tformula_1",
    "857": "SELECTlat, lng\nFROM circuits\nWHERE name = 'Abu Dhabi Grand Prix'\t----- bird -----\tformula_1",
    "858": "SELECTc.country\nFROM constructors c\nJOIN constructorResults cr ON c.constructorId = cr.constructorId\nJOIN races r ON cr.raceId = r.raceId\nWHERE cr.points = 1 AND r.raceId = 24\t----- bird -----\tformula_1",
    "859": "SELECTq1\nFROM qualifying\nJOIN drivers ON qualifying.driverId = drivers.driverId\nWHERE drivers.forename = 'Bruno' AND drivers.surname = 'Senna' AND qualifying.raceId = 354\t----- bird -----\tformula_1",
    "860": "SELECTdrivers.nationality\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nWHERE qualifying.raceId = 355\nAND qualifying.q2 = '0:01:40'\t----- bird -----\tformula_1",
    "861": "SELECTdrivers.number\nFROM qualifying\nJOIN drivers ON qualifying.driverId = drivers.driverId\nWHERE qualifying.raceId = 903\nAND qualifying.q3 = '0:01:54'\t----- bird -----\tformula_1",
    "862": "SELECTCOUNT(*) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE name = 'Bahrain Grand Prix' AND year = 2007) \nAND statusId != (SELECT statusId FROM status WHERE status = 'Finished')\t----- bird -----\tformula_1",
    "863": "SELECTyear\nFROM races\nWHERE raceId = 901\t----- bird -----\tformula_1",
    "864": "SELECTCOUNT(driverId) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE date = '2015-11-29') \nAND position IS NOT NULL\t----- bird -----\tformula_1",
    "865": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE results.raceId = 592\nORDER BY drivers.dob ASC\nLIMIT 1\t----- bird -----\tformula_1",
    "866": "SELECTdrivers.forename, drivers.surname, drivers.url\nFROM lapTimes\nJOIN drivers ON lapTimes.driverId = drivers.driverId\nWHERE lapTimes.raceId = 161\nAND lapTimes.time = '0:01:27'\t----- bird -----\tformula_1",
    "867": "SELECTdrivers.nationality\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE results.raceId = 933\nAND results.fastestLapSpeed = (SELECT MAX(fastestLapSpeed) FROM results WHERE raceId = 933)\t----- bird -----\tformula_1",
    "868": "SELECTlocation, lat, lng\nFROM circuits\nWHERE name = 'Malaysian Grand Prix'\t----- bird -----\tformula_1",
    "869": "SELECTconstructors.url\nFROM constructorStandings\nJOIN constructors ON constructorStandings.constructorId = constructors.constructorId\nWHERE constructorStandings.raceId = 9\nORDER BY constructorStandings.points DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "870": "SELECTq1\nFROM qualifying\nWHERE raceId = 345\nAND driverId = (SELECT driverId FROM drivers WHERE forename = 'Lucas' AND surname = 'di Grassi')\t----- bird -----\tformula_1",
    "871": "SELECTdrivers.nationality\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE races.raceId = 347\nAND qualifying.q2 = '0:01:15'\t----- bird -----\tformula_1",
    "872": "SELECTdrivers.code\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE races.raceId = 45\nAND qualifying.q3 = '0:01:33'\t----- bird -----\tformula_1",
    "873": "SELECTresults.time\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.raceId = 743\nAND drivers.forename = 'Bruce'\nAND drivers.surname = 'McLaren'\t----- bird -----\tformula_1",
    "874": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.name = 'San Marino Grand Prix' AND races.year = 2006 AND results.position = 2\t----- bird -----\tformula_1",
    "875": "SELECTyear\nFROM races\nWHERE raceId = 901\t----- bird -----\tformula_1",
    "876": "SELECTCOUNT(*) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE date = '2015-11-29') \nAND position = -1\t----- bird -----\tformula_1",
    "877": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE results.raceId = 872\nORDER BY drivers.dob ASC\nLIMIT 1\t----- bird -----\tformula_1",
    "878": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nWHERE results.raceId = 348\nORDER BY results.fastestLapTime\nLIMIT 1\t----- bird -----\tformula_1",
    "879": "SELECTdrivers.nationality\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nWHERE results.fastestLapSpeed IS NOT NULL\nORDER BY results.fastestLapSpeed DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "880": "SELECTresults.driverId, \n       results.raceId, \n       results.fastestLapSpeed, \n       LEAD(results.fastestLapSpeed, 1) OVER (PARTITION BY results.driverId ORDER BY results.raceId) AS nextFastestLapSpeed\nFROM results\nWHERE results.driverId = (SELECT driverId FROM drivers WHERE forename = 'Paul' AND surname = 'di Resta')\nAND results.raceId = 853\t----- bird -----\tformula_1",
    "881": "SELECTdrivers.forename, drivers.surname, \n    (COUNT(results.resultId) * 100 / races.round) as completion_rate\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE races.date = '1983-07-16'\nGROUP BY drivers.driverId\t----- bird -----\tformula_1",
    "882": "SELECTraces.year\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Marina Bay Street Circuit'\nORDER BY races.year\nLIMIT 1\t----- bird -----\tformula_1",
    "883": "SELECTCOUNT(*) \nFROM races \nWHERE year = 2005;\t----- bird -----\tformula_1",
    "884": "SELECTraces.name\nFROM races\nWHERE year = (SELECT MIN(year) FROM seasons)\nORDER BY date\t----- bird -----\tformula_1",
    "885": "SELECTraces.name, races.date\nFROM races\nJOIN seasons ON races.year = seasons.year\nWHERE seasons.year = 1999\nORDER BY races.round DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "886": "SELECTyear, COUNT(raceId) as num_races\nFROM races\nGROUP BY year\nORDER BY num_races DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "887": "SELECTraces.name\nFROM races\nWHERE races.year = 2017\nAND races.year <> 2000\t----- bird -----\tformula_1",
    "888": "SELECTc.country, ci.name, ci.location\nFROM circuits ci\nJOIN races r ON ci.circuitId = r.circuitId\nJOIN seasons s ON r.year = s.year\nWHERE s.year = (SELECT MIN(year) FROM seasons WHERE url LIKE '%europe%')\nORDER BY r.date\nLIMIT 1\t----- bird -----\tformula_1",
    "889": "SELECTraces.date\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Brands Hatch'\nAND races.name = 'British Grand Prix'\nORDER BY races.year DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "890": "SELECTCOUNT(*) \nFROM circuits \nWHERE name = 'Silverstone Circuit' \nAND country = 'United Kingdom'\t----- bird -----\tformula_1",
    "891": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN driverStandings ON drivers.driverId = driverStandings.driverId\nJOIN races ON driverStandings.raceId = races.raceId\nWHERE races.name = 'Singapore Grand Prix' AND races.year = 2010\nORDER BY driverStandings.position\t----- bird -----\tformula_1",
    "892": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN driverStandings ON drivers.driverId = driverStandings.driverId\nGROUP BY drivers.driverId\nORDER BY SUM(driverStandings.points) DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "893": "SELECTdrivers.forename, drivers.surname, results.points\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE races.year = 2017\nAND races.name = 'Chinese Grand Prix'\nORDER BY results.points DESC\nLIMIT 3\t----- bird -----\tformula_1",
    "894": "SELECTdriverRef, races.name, lapTimes.time\nFROM lapTimes\nJOIN drivers ON lapTimes.driverId = drivers.driverId\nJOIN races ON lapTimes.raceId = races.raceId\nWHERE lapTimes.time = (SELECT MIN(time) FROM lapTimes)\t----- bird -----\tformula_1",
    "895": "SELECTAVG(milliseconds) \nFROM lapTimes \nJOIN races ON lapTimes.raceId = races.raceId \nJOIN drivers ON lapTimes.driverId = drivers.driverId \nWHERE drivers.forename = 'Lewis' \nAND drivers.surname = 'Hamilton' \nAND races.year = 2009 \nAND races.name = 'Malaysian Grand Prix'\t----- bird -----\tformula_1",
    "896": "SELECTROUND((COUNT(DISTINCT r.raceId) - COUNT(DISTINCT rs.raceId)) * 100.0 / COUNT(DISTINCT r.raceId), 2) AS percentage_not_first_track\nFROM races r\nLEFT JOIN results rs ON r.raceId = rs.raceId\nLEFT JOIN drivers d ON rs.driverId = d.driverId\nWHERE d.forename = 'Lewis' AND d.surname = 'Hamilton' AND r.year >= 2010\t----- bird -----\tformula_1",
    "897": "SELECTdrivers.forename, drivers.surname, drivers.nationality, MAX(driverStandings.points) as max_points\nFROM drivers\nJOIN driverStandings ON drivers.driverId = driverStandings.driverId\nWHERE driverStandings.wins = (SELECT MAX(wins) FROM driverStandings)\t----- bird -----\tformula_1",
    "898": "SELECTMIN(strftime('%Y', 'now') - strftime('%Y', dob)) AS age, forename, surname\nFROM drivers\nWHERE nationality = 'Japanese'\t----- bird -----\tformula_1",
    "899": "SELECTcircuits.name\nFROM circuits\nJOIN races ON circuits.circuitId = races.circuitId\nJOIN seasons ON races.year = seasons.year\nGROUP BY circuits.name\nHAVING COUNT(DISTINCT races.year) = 4\nAND seasons.year BETWEEN 1990 AND 2000\t----- bird -----\tformula_1",
    "900": "SELECTcircuits.name, circuits.location, races.name\nFROM circuits\nJOIN races ON circuits.circuitId = races.circuitId\nWHERE circuits.country = 'USA' AND races.year = 2006\t----- bird -----\tformula_1",
    "901": "SELECTraces.name, circuits.name, circuits.location\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nJOIN seasons ON races.year = seasons.year\nWHERE seasons.year = 2005\nAND strftime('%m', races.date) = '09'\t----- bird -----\tformula_1",
    "902": "SELECTraces.name\nFROM races\nJOIN results ON races.raceId = results.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Alex' AND drivers.surname = 'Yoong' AND results.positionOrder < 20\t----- bird -----\tformula_1",
    "903": "SELECTCOUNT(*) \nFROM results \nJOIN races ON results.raceId = races.raceId \nJOIN drivers ON results.driverId = drivers.driverId \nJOIN circuits ON races.circuitId = circuits.circuitId \nWHERE drivers.forename = 'Michael' \nAND drivers.surname = 'Schumacher' \nAND circuits.name = 'Sepang International Circuit' \nAND results.position = 1\t----- bird -----\tformula_1",
    "904": "SELECTraces.name, races.year\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Michael' AND drivers.surname = 'Schumacher'\nAND results.fastestLap = 1\t----- bird -----\tformula_1",
    "905": "SELECTAVG(points)\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE drivers.forename = 'Eddie' AND drivers.surname = 'Irvine'\nAND races.year = 2000\t----- bird -----\tformula_1",
    "906": "SELECTraces.name, results.points\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\nORDER BY races.date\nLIMIT 1\t----- bird -----\tformula_1",
    "907": "SELECTraces.name, circuits.country\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE races.year = 2017\nORDER BY races.date\t----- bird -----\tformula_1",
    "908": "SELECTraces.name, races.year, circuits.location\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nORDER BY races.laps DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "909": "SELECTROUND((COUNT(DISTINCT races.raceId) * 100.0) / (SELECT COUNT(DISTINCT races.raceId) FROM races INNER JOIN circuits ON races.circuitId = circuits.circuitId WHERE circuits.country = 'Germany' AND circuits.location = 'Europe'), 2) AS percentage\nFROM races\nINNER JOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.country = 'Germany' AND circuits.location = 'Europe'\t----- bird -----\tformula_1",
    "910": "SELECTlat, lng\nFROM circuits\nWHERE circuitRef = 'silverstone'\t----- bird -----\tformula_1",
    "911": "SELECTcircuitRef, name, lat\nFROM circuits\nWHERE circuitRef IN ('silverstone', 'hockenheimring', 'hungaroring')\nORDER BY lat DESC\t----- bird -----\tformula_1",
    "912": "SELECTcircuitRef\nFROM circuits\nWHERE name = 'Marina Bay Street Circuit'\t----- bird -----\tformula_1",
    "913": "SELECTcountry\nFROM circuits\nWHERE alt = (SELECT MAX(alt) FROM circuits)\t----- bird -----\tformula_1",
    "914": "SELECTCOUNT(*) \nFROM drivers \nWHERE code IS NULL\t----- bird -----\tformula_1",
    "915": "SELECTdrivers.nationality\nFROM drivers\nWHERE drivers.dob = (SELECT MIN(dob) FROM drivers)\t----- bird -----\tformula_1",
    "916": "SELECTsurname\nFROM drivers\nWHERE nationality = 'Italian'\t----- bird -----\tformula_1",
    "917": "SELECTurl\nFROM drivers\nWHERE forename = 'Anthony' AND surname = 'Davidson'\t----- bird -----\tformula_1",
    "918": "SELECTdriverRef\nFROM drivers\nWHERE forename = 'Lewis' AND surname = 'Hamilton'\t----- bird -----\tformula_1",
    "919": "SELECTcircuits.name\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE races.year = 2009\nAND races.name = 'Spanish Grand Prix'\t----- bird -----\tformula_1",
    "920": "SELECTraces.year\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Silverstone Circuit'\t----- bird -----\tformula_1",
    "921": "SELECTraces.name, races.date, circuits.name, circuits.location, circuits.country\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Silverstone'\t----- bird -----\tformula_1",
    "922": "SELECTraces.time\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE races.year >= 2010 AND races.year < 2020\nAND circuits.name = 'Abu Dhabi Circuit'\t----- bird -----\tformula_1",
    "923": "SELECTCOUNT(*) \nFROM races \nJOIN circuits ON races.circuitId = circuits.circuitId \nWHERE circuits.country = 'Italy'\t----- bird -----\tformula_1",
    "924": "SELECTraces.date\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Barcelona-Catalunya'\t----- bird -----\tformula_1",
    "925": "SELECTcircuits.url\nFROM circuits\nJOIN races ON circuits.circuitId = races.circuitId\nJOIN seasons ON races.year = seasons.year\nWHERE races.name = 'Spanish Grand Prix' AND seasons.year = 2009\t----- bird -----\tformula_1",
    "926": "SELECTresults.fastestLapTime\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\nORDER BY results.fastestLapTime\nLIMIT 1\t----- bird -----\tformula_1",
    "927": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE fastestLapSpeed = (SELECT MAX(fastestLapSpeed) FROM results)\t----- bird -----\tformula_1",
    "928": "SELECTdrivers.driverRef\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.name = 'Canadian Grand Prix' AND races.year = 2007\nORDER BY results.position\nLIMIT 1\t----- bird -----\tformula_1",
    "929": "SELECTraces.name\nFROM races\nJOIN results ON races.raceId = results.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "930": "SELECTraces.name\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\nORDER BY results.position\nLIMIT 1\t----- bird -----\tformula_1",
    "931": "SELECTMAX(fastestLapSpeed) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE year = 2009 AND name = 'Spanish Grand Prix')\t----- bird -----\tformula_1",
    "932": "SELECTraces.year\nFROM races\nJOIN results ON races.raceId = results.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "933": "SELECTresults.position\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.year = 2008\nAND races.name = 'Chinese Grand Prix'\nAND drivers.forename = 'Lewis'\nAND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "934": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.year = 1989\nAND races.name = 'Australian Grand Prix'\nAND results.grid = 4\t----- bird -----\tformula_1",
    "935": "SELECTCOUNT(driverId) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE year = 2008 AND name = 'Australian Grand Prix') \nAND position IS NOT NULL\t----- bird -----\tformula_1",
    "936": "SELECTresults.fastestLapTime\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\nAND races.year = 2008\nAND races.name = 'Australian Grand Prix'\t----- bird -----\tformula_1",
    "937": "SELECTresults.time\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.year = 2008\nAND races.name = 'AustChineseralian Grand Prix'\nAND results.position = 2\t----- bird -----\tformula_1",
    "938": "SELECTdrivers.forename, drivers.surname, drivers.url\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.name = 'Australian Grand Prix' AND races.year = 2008 AND results.position = 1\t----- bird -----\tformula_1",
    "939": "SELECTCOUNT(driverId)\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN races ON results.raceId = races.raceId\nWHERE races.year = 2008\nAND races.name = 'Australian Grand Prix'\nAND drivers.nationality = 'UN'\t----- bird -----\tformula_1",
    "940": "SELECTCOUNT(DISTINCT driverId) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE name = 'Chinese Grand Prix' AND year = 2008) \nAND position IS NOT NULL\t----- bird -----\tformula_1",
    "941": "SELECTSUM(points)\nFROM results\nWHERE driverId = (SELECT driverId FROM drivers WHERE forename = 'Lewis' AND surname = 'Hamilton')\t----- bird -----\tformula_1",
    "942": "SELECTAVG(strftime('%s', fastestLapTime)) \nFROM results \nJOIN drivers ON results.driverId = drivers.driverId \nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "943": "SELECTROUND(CAST(COUNT(results.resultId) AS REAL) / (SELECT COUNT(*) FROM races WHERE year = 2008 AND name = 'Australian Grand Prix') * 100, 2) AS completion_rate\nFROM results\nJOIN races ON results.raceId = races.raceId\nWHERE races.year = 2008\nAND races.name = 'Australian Grand Prix'\nAND results.laps = (SELECT MAX(laps) FROM results WHERE raceId = races.raceId)\t----- bird -----\tformula_1",
    "944": "SELECTresults.driverId,\n       results.position,\n       results.time\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.year = 2008\nAND races.name = 'Australian Grand Prix'\nORDER BY results.position ASC\t----- bird -----\tformula_1",
    "945": "SELECTCOUNT(*)\nFROM circuits\nWHERE location = 'Adelaide'\nAND country = 'Australia'\t----- bird -----\tformula_1",
    "946": "SELECTcircuits.name, circuits.location, circuits.lat, circuits.lng\nFROM circuits\nWHERE circuits.country = 'USA'\t----- bird -----\tformula_1",
    "947": "SELECTCOUNT(*) \nFROM drivers \nWHERE nationality = 'British' \nAND dob > '1980-01-01'\t----- bird -----\tformula_1",
    "948": "SELECTMAX(points) \nFROM constructorStandings \nWHERE constructorId IN (SELECT constructorId FROM constructors WHERE nationality = 'British')\t----- bird -----\tformula_1",
    "949": "SELECTconstructors.name, SUM(results.points) as total_points\nFROM constructors\nJOIN results ON constructors.constructorId = results.constructorId\nGROUP BY constructors.name\nORDER BY total_points DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "950": "SELECTconstructors.name\nFROM constructors\nJOIN constructorResults ON constructors.constructorId = constructorResults.constructorId\nWHERE constructorResults.raceId = 291\nAND constructorResults.points = 0\t----- bird -----\tformula_1",
    "951": "SELECTCOUNT(*) \nFROM constructorStandings cs\nJOIN constructors c ON cs.constructorId = c.constructorId\nJOIN races r ON cs.raceId = r.raceId\nWHERE c.nationality = 'Japanese' AND cs.points = 0\nGROUP BY c.constructorId\nHAVING COUNT(*) = 2\t----- bird -----\tformula_1",
    "952": "SELECTconstructors.name\nFROM constructors\nJOIN constructorStandings ON constructors.constructorId = constructorStandings.constructorId\nWHERE constructorStandings.position = 1\t----- bird -----\tformula_1",
    "953": "SELECTCOUNT(DISTINCT constructors.constructorId)\nFROM constructors\nJOIN constructorResults ON constructors.constructorId = constructorResults.constructorId\nJOIN races ON constructorResults.raceId = races.raceId\nJOIN lapTimes ON races.raceId = lapTimes.raceId\nJOIN drivers ON lapTimes.driverId = drivers.driverId\nWHERE constructors.nationality = 'French' AND lapTimes.lap > 50\t----- bird -----\tformula_1",
    "954": "SELECT\n(SELECT COUNT(*) \nFROM results \nJOIN races ON results.raceId = races.raceId \nJOIN drivers ON results.driverId = drivers.driverId \nWHERE drivers.nationality = 'Japanese' \nAND races.year BETWEEN 2007 AND 2009) \n/ \n(SELECT COUNT(*) \nFROM races \nWHERE year BETWEEN 2007 AND 2009) * 100 as race_completion_percentage\t----- bird -----\tformula_1",
    "955": "SELECTraces.year, AVG(strftime('%s', results.time)) as avg_time_seconds\nFROM races\nJOIN results ON races.raceId = results.raceId\nJOIN driverStandings ON races.raceId = driverStandings.raceId\nWHERE races.year < 1975\nGROUP BY races.year\t----- bird -----\tformula_1",
    "956": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN driverStandings ON drivers.driverId = driverStandings.driverId\nWHERE drivers.dob > '1975-01-01' AND driverStandings.position = 2\t----- bird -----\tformula_1",
    "957": "SELECTCOUNT(*) \nFROM results \nJOIN drivers ON results.driverId = drivers.driverId \nWHERE drivers.nationality = 'Italian' \nAND results.positionText NOT LIKE '%DNF%'\t----- bird -----\tformula_1",
    "958": "SELECTdrivers.forename, drivers.surname\nFROM results\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE results.fastestLapTime = (SELECT MIN(fastestLapTime) FROM results)\nLIMIT 1\t----- bird -----\tformula_1",
    "959": "SELECTresults.fastestLap\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN seasons ON races.year = seasons.year\nWHERE seasons.year = 2009\nAND results.position = 1\t----- bird -----\tformula_1",
    "960": "SELECTAVG(fastestLapSpeed) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE year = 2009 AND name = 'Spanish Grand Prix')\t----- bird -----\tformula_1",
    "961": "SELECTraces.name, races.year\nFROM races\nJOIN results ON races.raceId = results.raceId\nORDER BY results.milliseconds\nLIMIT 1\t----- bird -----\tformula_1",
    "962": "SELECT\n(SELECT COUNT(*) \nFROM drivers \nWHERE dob < '1985-01-01' \nAND driverId IN \n    (SELECT driverId \n    FROM lapTimes \n    WHERE lap > 50 \n    AND raceId IN \n        (SELECT raceId \n        FROM races \n        WHERE year BETWEEN 2000 AND 2005))) \n/ \n(SELECT COUNT(*) \nFROM drivers \nWHERE driverId IN \n    (SELECT driverId \n    FROM lapTimes \n    WHERE lap > 50 \n    AND raceId IN \n        (SELECT raceId \n        FROM races \n        WHERE year BETWEEN 2000 AND 2005))) * 100 as percentage\t----- bird -----\tformula_1",
    "963": "SELECTCOUNT(*) \nFROM drivers d\nJOIN lapTimes lt ON d.driverId = lt.driverId\nWHERE d.nationality = 'French' AND lt.time < '02:00.00'\t----- bird -----\tformula_1",
    "964": "SELECTdriverRef, forename, surname\nFROM drivers\nWHERE nationality = 'American'\t----- bird -----\tformula_1",
    "965": "SELECTraceId\nFROM races\nWHERE year = 2009\t----- bird -----\tformula_1",
    "966": "SELECTCOUNT(driverId) \nFROM results \nWHERE raceId = 18\t----- bird -----\tformula_1",
    "967": "SELECTdriverId, forename, surname, dob, nationality\nFROM drivers\nORDER BY dob DESC\nLIMIT 3\t----- bird -----\tformula_1",
    "968": "SELECTdriverRef\nFROM drivers\nWHERE forename = 'Robert' AND surname = 'Kubica'\t----- bird -----\tformula_1",
    "969": "SELECTCOUNT(*) \nFROM drivers \nWHERE nationality = 'British' \nAND dob LIKE '1980%'\t----- bird -----\tformula_1",
    "970": "SELECTdrivers.forename, drivers.surname, lapTimes.time\nFROM drivers\nJOIN lapTimes ON drivers.driverId = lapTimes.driverId\nWHERE drivers.nationality = 'German'\nAND drivers.dob BETWEEN '1980-01-01' AND '1990-12-31'\nORDER BY lapTimes.time\nLIMIT 3\t----- bird -----\tformula_1",
    "971": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nWHERE drivers.nationality = 'German'\nORDER BY drivers.dob\nLIMIT 1\t----- bird -----\tformula_1",
    "972": "SELECTdrivers.driverId, drivers.code\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nWHERE drivers.dob LIKE '1971%'\nAND results.fastestLap = 1\t----- bird -----\tformula_1",
    "973": "SELECTdrivers.forename, drivers.surname, lapTimes.time\nFROM drivers\nJOIN lapTimes ON drivers.driverId = lapTimes.driverId\nWHERE drivers.nationality = 'Spanish' \nAND drivers.dob < '1982-01-01'\nORDER BY lapTimes.time DESC\nLIMIT 10\t----- bird -----\tformula_1",
    "974": "SELECTraces.year\nFROM results\nJOIN races ON results.raceId = races.raceId\nWHERE results.fastestLapTime = (SELECT MIN(fastestLapTime) FROM results)\t----- bird -----\tformula_1",
    "975": "SELECTraces.year, results.fastestLapSpeed\nFROM races\nJOIN results ON races.raceId = results.raceId\nORDER BY results.fastestLapSpeed\nLIMIT 1\t----- bird -----\tformula_1",
    "976": "SELECTdriverId\nFROM lapTimes\nWHERE lap = 1\nORDER BY milliseconds\nLIMIT 5\t----- bird -----\tformula_1",
    "977": "SELECTCOUNT(*) \nFROM results \nWHERE raceId BETWEEN 50 AND 100 \nAND positionText = 'DSQ'\t----- bird -----\tformula_1",
    "978": "SELECTcircuitRef, name, location, lat, lng\nFROM circuits\nWHERE country = 'Austria'\t----- bird -----\tformula_1",
    "979": "SELECTr.round, COUNT(rs.resultId) as finishers\nFROM races r\nJOIN results rs ON r.raceId = rs.raceId\nWHERE rs.position IS NOT NULL\nGROUP BY r.round\nORDER BY finishers DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "980": "SELECTdrivers.forename, drivers.surname, drivers.nationality, drivers.dob\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nWHERE qualifying.raceId = 23\nAND qualifying.q2 IS NOT NULL\t----- bird -----\tformula_1",
    "981": "SELECTdrivers.forename, drivers.surname, races.year, races.name, races.date, races.time\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE drivers.dob = (SELECT MIN(dob) FROM drivers)\nORDER BY races.year\nLIMIT 1\t----- bird -----\tformula_1",
    "982": "SELECTCOUNT(DISTINCT drivers.driverId)\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN status ON results.statusId = status.statusId\nWHERE drivers.nationality = 'American' AND status.status = 'Puncture'\t----- bird -----\tformula_1",
    "983": "SELECTconstructors.name, constructors.url, sum(constructorStandings.points) as total_points\nFROM constructors\nJOIN constructorStandings ON constructors.constructorId = constructorStandings.constructorId\nWHERE constructors.nationality = 'Italian'\nGROUP BY constructors.name\nORDER BY total_points DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "984": "SELECTconstructors.url\nFROM constructors\nJOIN constructorStandings ON constructors.constructorId = constructorStandings.constructorId\nWHERE constructorStandings.wins = (SELECT MAX(wins) FROM constructorStandings)\t----- bird -----\tformula_1",
    "985": "SELECTdrivers.forename, drivers.surname, lapTimes.time\nFROM drivers\nJOIN lapTimes ON drivers.driverId = lapTimes.driverId\nJOIN races ON lapTimes.raceId = races.raceId\nWHERE races.name = 'French Grand Prix' AND lapTimes.lap = 3\nORDER BY lapTimes.milliseconds DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "986": "SELECTraces.name, results.fastestLapTime, results.milliseconds\nFROM races\nJOIN results ON races.raceId = results.raceId\nWHERE results.fastestLap = 1\nORDER BY results.milliseconds\nLIMIT 1\t----- bird -----\tformula_1",
    "987": "SELECTAVG(fastestLapTime) \nFROM results \nWHERE raceId = (SELECT raceId FROM races WHERE year = 2006 AND name = 'United States Grand Prix') \nORDER BY position \nLIMIT 10\t----- bird -----\tformula_1",
    "988": "SELECTdrivers.forename, drivers.surname, AVG(pitStops.milliseconds) as avg_pit_stop_duration\nFROM drivers\nJOIN pitStops ON drivers.driverId = pitStops.driverId\nWHERE drivers.nationality = 'German' \nAND drivers.dob BETWEEN '1980-01-01' AND '1985-12-31'\nGROUP BY drivers.driverId\nORDER BY avg_pit_stop_duration\nLIMIT 3\t----- bird -----\tformula_1",
    "989": "SELECTdrivers.forename, drivers.surname, results.time\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.name = 'Canadian Grand Prix' AND races.year = 2008 AND results.position = 1\t----- bird -----\tformula_1",
    "990": "SELECTconstructors.name, constructors.url\nFROM constructors\nJOIN constructorResults ON constructors.constructorId = constructorResults.constructorId\nJOIN races ON constructorResults.raceId = races.raceId\nWHERE races.name = 'Singapore Grand Prix' AND races.year = 2009\nORDER BY constructorResults.points DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "991": "SELECTdrivers.forename || ' ' || drivers.surname AS full_name, drivers.dob\nFROM drivers\nWHERE drivers.nationality = 'Austrian'\nAND drivers.dob BETWEEN '1981-01-01' AND '1991-12-31'\t----- bird -----\tformula_1",
    "992": "SELECTdrivers.forename || ' ' || drivers.surname AS full_name, drivers.url AS wikipedia_page, drivers.dob\nFROM drivers\nWHERE drivers.nationality = 'German' \nAND drivers.dob BETWEEN '1971-01-01' AND '1985-12-31'\nORDER BY drivers.dob DESC\t----- bird -----\tformula_1",
    "993": "SELECTlocation, country, lat, lng\nFROM circuits\nWHERE circuitRef = 'hungaroring'\t----- bird -----\tformula_1",
    "994": "SELECTconstructors.name, constructors.nationality, sum(constructorResults.points) as total_points\nFROM constructors\nJOIN constructorResults ON constructors.constructorId = constructorResults.constructorId\nJOIN races ON constructorResults.raceId = races.raceId\nWHERE races.name = 'Monaco Grand Prix' AND races.year BETWEEN 1980 AND 2010\nGROUP BY constructors.name\nORDER BY total_points DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "995": "SELECTAVG(points)\nFROM results\nJOIN races ON results.raceId = races.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE races.name = 'Turkish Grand Prix' AND drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "996": "SELECTAVG(races_per_year)\nFROM\n(\n    SELECT year, COUNT(raceId) as races_per_year\n    FROM races\n    WHERE year BETWEEN 2001 AND 2010\n    GROUP BY year\n) as subquery\t----- bird -----\tformula_1",
    "997": "SELECTnationality, count(*) as count\nFROM drivers\nGROUP BY nationality\nORDER BY count DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "998": "SELECTCOUNT(*) \nFROM results \nWHERE position = 91 \nAND points = (SELECT MAX(points) FROM results WHERE position = 91)\t----- bird -----\tformula_1",
    "999": "SELECTraces.name\nFROM races\nJOIN results ON races.raceId = results.raceId\nWHERE results.fastestLapTime = (SELECT MIN(results.fastestLapTime) FROM results)\t----- bird -----\tformula_1",
    "1000": "SELECTc.name, c.location, c.country\nFROM circuits c\nJOIN races r ON c.circuitId = r.circuitId\nWHERE r.date = (SELECT MAX(date) FROM races)\t----- bird -----\tformula_1",
    "1001": "SELECTdrivers.forename || ' ' || drivers.surname AS full_name\nFROM drivers\nJOIN qualifying ON drivers.driverId = qualifying.driverId\nJOIN races ON qualifying.raceId = races.raceId\nWHERE races.name = 'Marina Bay Street Circuit' \nAND races.year = 2008\nAND qualifying.position = 1\nAND qualifying.number = 3\t----- bird -----\tformula_1",
    "1002": "SELECTdrivers.forename || ' ' || drivers.surname AS full_name, drivers.nationality, races.name\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nJOIN races ON results.raceId = races.raceId\nORDER BY drivers.dob DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "1003": "SELECTCOUNT(*) \nFROM pitStops \nWHERE raceId = (SELECT raceId \n                FROM races \n                WHERE name = 'Canadian Grand Prix') \nAND driverId = (SELECT driverId \n                FROM (SELECT driverId, COUNT(*) as num_accidents \n                      FROM pitStops \n                      WHERE raceId = (SELECT raceId \n                                      FROM races \n                                      WHERE name = 'Canadian Grand Prix') \n                      GROUP BY driverId \n                      ORDER BY num_accidents DESC \n                      LIMIT 1)) \nAND stop > 0\t----- bird -----\tformula_1",
    "1004": "SELECTdrivers.forename, drivers.surname, driverStandings.wins\nFROM drivers\nJOIN driverStandings ON drivers.driverId = driverStandings.driverId\nWHERE drivers.dob = (SELECT MIN(dob) FROM drivers)\nORDER BY driverStandings.wins DESC\nLIMIT 1\t----- bird -----\tformula_1",
    "1005": "SELECTMAX(milliseconds) AS longest_pit_stop_time\nFROM pitStops\t----- bird -----\tformula_1",
    "1006": "SELECTMIN(milliseconds) as fastest_lap_time\nFROM lapTimes\t----- bird -----\tformula_1",
    "1007": "SELECTMAX(milliseconds) \nFROM pitStops \nWHERE driverId = (SELECT driverId FROM drivers WHERE forename = 'Lewis' AND surname = 'Hamilton')\t----- bird -----\tformula_1",
    "1008": "SELECTlap\nFROM pitStops\nJOIN races ON pitStops.raceId = races.raceId\nJOIN drivers ON pitStops.driverId = drivers.driverId\nWHERE races.name = 'Australian Grand Prix' \nAND races.year = 2011\nAND drivers.forename = 'Lewis'\nAND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "1009": "SELECTdrivers.forename, drivers.surname, pitStops.duration\nFROM drivers\nJOIN pitStops ON drivers.driverId = pitStops.driverId\nJOIN races ON pitStops.raceId = races.raceId\nWHERE races.year = 2011\nAND races.name = 'Australian Grand Prix'\t----- bird -----\tformula_1",
    "1010": "SELECTMIN(milliseconds) as lap_record\nFROM lapTimes\nJOIN drivers ON lapTimes.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton'\t----- bird -----\tformula_1",
    "1011": "SELECTdrivers.forename, drivers.surname\nFROM drivers\nJOIN results ON drivers.driverId = results.driverId\nWHERE results.fastestLap = 1\nORDER BY results.milliseconds\nLIMIT 20\t----- bird -----\tformula_1",
    "1012": "SELECTraces.name, results.position\nFROM races\nJOIN results ON races.raceId = results.raceId\nJOIN drivers ON results.driverId = drivers.driverId\nWHERE drivers.forename = 'Lewis' AND drivers.surname = 'Hamilton' AND results.fastestLap = 1\t----- bird -----\tformula_1",
    "1013": "SELECTMAX(milliseconds) as lap_record\nFROM lapTimes\nJOIN races ON lapTimes.raceId = races.raceId\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Austrian Grand Prix Circuit'\t----- bird -----\tformula_1",
    "1014": "SELECTcircuits.name, lapTimes.time\nFROM circuits\nJOIN races ON circuits.circuitId = races.circuitId\nJOIN lapTimes ON races.raceId = lapTimes.raceId\nJOIN drivers ON lapTimes.driverId = drivers.driverId\nWHERE circuits.country = 'Italy'\nORDER BY lapTimes.time\t----- bird -----\tformula_1",
    "1015": "SELECTraces.name\nFROM races\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.name = 'Red Bull Ring' AND races.date = (SELECT MAX(date) FROM races WHERE circuitId = circuits.circuitId)\t----- bird -----\tformula_1",
    "1016": "SELECTpitStops.duration\nFROM pitStops\nJOIN races ON pitStops.raceId = races.raceId\nJOIN circuits ON races.circuitId = circuits.circuitId\nJOIN drivers ON pitStops.driverId = drivers.driverId\nWHERE circuits.name = 'Austrian Grand Prix Circuit'\nAND drivers.surname = 'DriverSurname'\nAND drivers.forename = 'DriverForename'\nAND pitStops.stop = (SELECT MAX(stop) FROM pitStops WHERE raceId = races.raceId AND driverId = drivers.driverId)\nAND races.name = 'Austrian Grand Prix'\t----- bird -----\tformula_1",
    "1017": "SELECTcircuits.location, circuits.lat, circuits.lng\nFROM circuits\nJOIN races ON circuits.circuitId = races.circuitId\nJOIN lapTimes ON races.raceId = lapTimes.raceId\nWHERE lapTimes.time = '1:29.488'\t----- bird -----\tformula_1",
    "1018": "SELECTAVG(milliseconds)\nFROM pitStops\nWHERE driverId = (SELECT driverId FROM drivers WHERE forename = 'Lewis' AND surname = 'Hamilton')\t----- bird -----\tformula_1",
    "1019": "SELECTAVG(milliseconds)\nFROM lapTimes\nJOIN races ON lapTimes.raceId = races.raceId\nJOIN circuits ON races.circuitId = circuits.circuitId\nWHERE circuits.country = 'Italy'\t----- bird -----\tformula_1",
    "1020": "SELECTplayer_api_id\nFROM Player_Attributes\nORDER BY overall_rating DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1021": "SELECTMAX(height), player_name\nFROM Player\t----- bird -----\teuropean_football_2",
    "1022": "SELECTpreferred_foot\nFROM Player_Attributes\nWHERE potential = (SELECT MIN(potential) FROM Player_Attributes)\t----- bird -----\teuropean_football_2",
    "1023": "SELECTCOUNT(*) \nFROM Player_Attributes \nWHERE overall_rating BETWEEN 60 AND 65 \nAND attacking_work_rate = 'high' \nAND defensive_work_rate = 'high'\t----- bird -----\teuropean_football_2",
    "1024": "SELECT`player_api_id`, `player_name`\nFROM `Player_Attributes`\nORDER BY `crossing` DESC\nLIMIT 5\t----- bird -----\teuropean_football_2",
    "1025": "SELECTLeague.name\nFROM Match\nJOIN League ON Match.league_id = League.id\nWHERE Match.season = '2016'\nGROUP BY Match.league_id\nORDER BY SUM(Match.home_team_goal + Match.away_team_goal) DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1026": "SELECTTeam.team_long_name\nFROM Match\nJOIN Team ON Match.home_team_api_id = Team.team_api_id\nWHERE Match.season = '2016'\nGROUP BY Match.home_team_api_id\nORDER BY COUNT(CASE WHEN Match.home_team_goal < Match.away_team_goal THEN 1 END)\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1027": "SELECTPlayer.player_name, Player_Attributes.penalties\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nORDER BY Player_Attributes.penalties DESC\nLIMIT 10\t----- bird -----\teuropean_football_2",
    "1028": "SELECTTeam.team_long_name, COUNT(Match.id) AS away_wins\nFROM Match\nJOIN Team ON Match.away_team_api_id = Team.team_api_id\nJOIN League ON Match.league_id = League.id\nWHERE League.name = 'Scotland Premier League' AND Match.season = '2010'\nAND Match.away_team_goal > Match.home_team_goal\nGROUP BY Team.team_long_name\nORDER BY away_wins DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1029": "SELECTTeam.team_long_name, Team_Attributes.buildUpPlaySpeed\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nORDER BY Team_Attributes.buildUpPlaySpeed DESC\nLIMIT 4\t----- bird -----\teuropean_football_2",
    "1030": "SELECTLeague.name\nFROM Match\nJOIN League ON Match.league_id = League.id\nWHERE Match.season = '2016'\nAND Match.home_team_goal = Match.away_team_goal\nGROUP BY League.name\nORDER BY COUNT(*) DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1031": "SELECTstrftime('%Y', 'now') - strftime('%Y', p.birthday) - (strftime('%m-%d', 'now') < strftime('%m-%d', p.birthday)) AS age\nFROM Player p\nJOIN Player_Attributes pa ON p.player_api_id = pa.player_api_id\nWHERE pa.sprint_speed >= 97\nAND pa.date BETWEEN '2013-01-01' AND '2015-12-31'\t----- bird -----\teuropean_football_2",
    "1032": "SELECTLeague.name, COUNT(Match.id) AS total_matches\nFROM League\nJOIN Match ON League.id = Match.league_id\nGROUP BY League.name\nORDER BY total_matches DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1033": "SELECTAVG(height)\nFROM Player\nWHERE birthday BETWEEN '1990-01-01' AND '1995-12-31'\t----- bird -----\teuropean_football_2",
    "1034": "SELECT`player_api_id`\nFROM `Player_Attributes`\nWHERE `overall_rating` > (SELECT AVG(`overall_rating`) FROM `Player_Attributes` WHERE `date` LIKE '2010%')\nAND `date` LIKE '2010%'\t----- bird -----\teuropean_football_2",
    "1035": "SELECTteam_fifa_api_id\nFROM Team_Attributes\nWHERE buildUpPlaySpeed > 50 AND buildUpPlaySpeed < 60\t----- bird -----\teuropean_football_2",
    "1036": "SELECTTeam.team_long_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.date LIKE '2012%'\nAND Team_Attributes.buildUpPlayPassing > (SELECT AVG(buildUpPlayPassing) FROM Team_Attributes)\nORDER BY Team_Attributes.buildUpPlayPassing DESC\t----- bird -----\teuropean_football_2",
    "1037": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Player_Attributes WHERE preferred_foot = 'left' AND strftime('%Y', birthday) BETWEEN '1987' AND '1992') AS percentage\nFROM Player_Attributes\nWHERE preferred_foot = 'left' AND strftime('%Y', birthday) BETWEEN '1987' AND '1992'\t----- bird -----\teuropean_football_2",
    "1038": "SELECTLeague.name, SUM(Match.home_team_goal + Match.away_team_goal) AS total_goals\nFROM League\nJOIN Match ON League.id = Match.league_id\nGROUP BY League.name\nORDER BY total_goals ASC\nLIMIT 5\t----- bird -----\teuropean_football_2",
    "1039": "SELECT AVG(long_shots) \nFROM Player_Attributes \nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Ahmed Samir Farag')\t----- bird -----\teuropean_football_2",
    "1040": "SELECTPlayer.player_name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.height > 180\nORDER BY Player_Attributes.heading_accuracy DESC\nLIMIT 10\t----- bird -----\teuropean_football_2",
    "1041": "SELECTTeam.team_long_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.buildUpPlayDribblingClass = 'Normal'\nAND Team_Attributes.date LIKE '2014%'\nAND Team_Attributes.chanceCreationPassing < (SELECT AVG(chanceCreationPassing) FROM Team_Attributes)\nORDER BY Team_Attributes.chanceCreationPassing DESC\t----- bird -----\teuropean_football_2",
    "1042": "SELECTl.name\nFROM Match m\nJOIN League l ON m.league_id = l.id\nWHERE m.season = '2009/2010'\nGROUP BY l.name\nHAVING AVG(m.home_team_goal) > AVG(m.away_team_goal)\t----- bird -----\teuropean_football_2",
    "1043": "SELECTteam_short_name\nFROM Team\nWHERE team_long_name = 'Queens Park Rangers'\t----- bird -----\teuropean_football_2",
    "1044": "SELECT`player_name`\nFROM `Player`\nWHERE strftime('%Y', `birthday`) = '1970' AND strftime('%m', `birthday`) = '10'\t----- bird -----\teuropean_football_2",
    "1045": "SELECTattacking_work_rate\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Franco Zennaro'\t----- bird -----\teuropean_football_2",
    "1046": "SELECTbuildUpPlaySpeed, buildUpPlayDribbling, buildUpPlayPassing\nFROM Team_Attributes\nJOIN Team ON Team_Attributes.team_api_id = Team.team_api_id\nWHERE Team.team_long_name = 'ADO Den Haag'\t----- bird -----\teuropean_football_2",
    "1047": "SELECTPlayer_Attributes.heading_accuracy, Player_Attributes.finishing\nFROM Player_Attributes\nJOIN Player ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.player_name = 'Francois Affolter'\nAND Player_Attributes.date = '2014-09-18'\t----- bird -----\teuropean_football_2",
    "1048": "SELECToverall_rating\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Gabriel Tamas'\nAND Player_Attributes.date LIKE '2011%'\t----- bird -----\teuropean_football_2",
    "1049": "SELECTCOUNT(*) \nFROM Match \nWHERE season = '2015/2016' \nAND league_id = (SELECT id FROM League WHERE name = 'Scotland Premier League')\t----- bird -----\teuropean_football_2",
    "1050": "SELECTPlayer_Attributes.preferred_foot\nFROM Player_Attributes\nJOIN Player ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.birthday = (SELECT MIN(birthday) FROM Player)\t----- bird -----\teuropean_football_2",
    "1051": "SELECT`player_name`, `potential`\nFROM `Player`\nORDER BY `potential` DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1052": "SELECTCOUNT(*) \nFROM Player_Attributes \nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id \nWHERE Player.weight < 130 AND Player_Attributes.preferred_foot = 'left' AND Player_Attributes.attacking_work_rate = 'left'\t----- bird -----\teuropean_football_2",
    "1053": "SELECTTeam.team_short_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.chanceCreationPassingClass = 'Risky'\t----- bird -----\teuropean_football_2",
    "1054": "SELECTdefensive_work_rate\nFROM Player_Attributes\nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'David Wilson')\t----- bird -----\teuropean_football_2",
    "1055": "SELECTPlayer.player_name, Player.birthday\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player_Attributes.overall_rating = (SELECT MAX(overall_rating) FROM Player_Attributes)\t----- bird -----\teuropean_football_2",
    "1056": "SELECTLeague.name\nFROM League\nJOIN Country ON League.country_id = Country.id\nWHERE Country.name = 'Netherlands'\t----- bird -----\teuropean_football_2",
    "1057": "SELECTAVG(home_team_goal)\nFROM Match\nWHERE season = '2010/2011'\nAND country_id = (SELECT id FROM Country WHERE name = 'Poland')\t----- bird -----\teuropean_football_2",
    "1058": "SELECTPlayer.player_name, AVG(Player_Attributes.finishing) AS avg_finishing\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.height = (SELECT MAX(height) FROM Player) OR Player.height = (SELECT MIN(height) FROM Player)\nGROUP BY Player.player_name\nORDER BY avg_finishing DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1059": "SELECT`player_name`\nFROM `Player`\nWHERE `height` > 180\t----- bird -----\teuropean_football_2",
    "1060": "SELECTCOUNT(*) \nFROM Player\nWHERE strftime('%Y', birthday) > '1990'\t----- bird -----\teuropean_football_2",
    "1061": "SELECTCOUNT(*) \nFROM Player\nWHERE player_name LIKE 'Adam%' AND weight > 170\t----- bird -----\teuropean_football_2",
    "1062": "SELECTPlayer.player_name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player_Attributes.overall_rating > 80\nAND Player_Attributes.date BETWEEN '2008-01-01' AND '2010-12-31'\t----- bird -----\teuropean_football_2",
    "1063": "SELECTpotential\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE player_name = 'Aaron Doran'\t----- bird -----\teuropean_football_2",
    "1064": "SELECT`player_name`\nFROM `Player`\nWHERE `preferred_foot` = 'left'\t----- bird -----\teuropean_football_2",
    "1065": "SELECT`team_long_name`\nFROM `Team`\nWHERE `team_api_id` IN (\n    SELECT `team_api_id`\n    FROM `Team_Attributes`\n    WHERE `buildUpPlaySpeedClass` = 'Fast'\n)\t----- bird -----\teuropean_football_2",
    "1066": "SELECT`buildUpPlayPassingClass` \nFROM `Team_Attributes` \nWHERE `team_api_id` = (SELECT `team_api_id` FROM `Team` WHERE `team_long_name` = 'CLB')\t----- bird -----\teuropean_football_2",
    "1067": "SELECTTeam.team_short_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.buildUpPlayPassing > 70\t----- bird -----\teuropean_football_2",
    "1068": "SELECTAVG(overall_rating) \nFROM Player_Attributes \nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id \nWHERE height > 170 \nAND date BETWEEN '2010-01-01' AND '2015-12-31'\t----- bird -----\teuropean_football_2",
    "1069": "SELECT`player_name` \nFROM `Player` \nORDER BY `height` ASC \nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1070": "SELECTCountry.name\nFROM League\nJOIN Country ON League.country_id = Country.id\nWHERE League.name = 'Italy Serie A'\t----- bird -----\teuropean_football_2",
    "1071": "SELECTTeam.team_short_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.buildUpPlaySpeed = 31\nAND Team_Attributes.buildUpPlayDribbling = 53\nAND Team_Attributes.buildUpPlayPassing = 32\t----- bird -----\teuropean_football_2",
    "1072": "SELECTAVG(overall_rating) \nFROM Player_Attributes \nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Doran')\t----- bird -----\teuropean_football_2",
    "1073": "SELECTCOUNT(*) \nFROM Match \nWHERE league_id = (SELECT id FROM League WHERE name = 'Germany 1. Bundesliga') \nAND date BETWEEN '2008-08-01' AND '2008-10-31'\t----- bird -----\teuropean_football_2",
    "1074": "SELECTTeam.team_short_name\nFROM Match\nJOIN Team ON Match.home_team_api_id = Team.team_api_id\nWHERE Match.home_team_goal = 10\t----- bird -----\teuropean_football_2",
    "1075": "SELECTPlayer.player_name\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player_Attributes.balance = (SELECT MAX(balance) FROM Player_Attributes WHERE potential = 61) AND Player_Attributes.potential = 61\t----- bird -----\teuropean_football_2",
    "1076": "SELECTAVG(ball_control) FROM Player_Attributes WHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Abdou Diallo') - AVG(ball_control) FROM Player_Attributes WHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Appindangoye')\t----- bird -----\teuropean_football_2",
    "1077": "SELECTteam_long_name\nFROM Team\nWHERE team_short_name = 'GEN'\t----- bird -----\teuropean_football_2",
    "1078": "SELECTPlayer.player_name, Player.birthday\nFROM Player\nWHERE Player.player_name = 'Aaron Lennon' OR Player.player_name = 'Abdelaziz Barrada'\t----- bird -----\teuropean_football_2",
    "1079": "SELECTplayer_name\nFROM Player\nORDER BY height DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1080": "SELECTCOUNT(*) \nFROM Player_Attributes \nWHERE preferred_foot = 'left' \nAND attacking_work_rate = 'medium' \nAND defensive_work_rate = 'medium' \nAND positioning = 1\t----- bird -----\teuropean_football_2",
    "1081": "SELECTCountry.name\nFROM Country\nJOIN League ON Country.id = League.country_id\nWHERE League.name = 'Belgium Jupiler League'\t----- bird -----\teuropean_football_2",
    "1082": "SELECT`name`\nFROM `League`\nWHERE `country_id` = (SELECT `id` FROM `Country` WHERE `name` = 'Germany')\t----- bird -----\teuropean_football_2",
    "1083": "SELECTPlayer.player_name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nORDER BY Player_Attributes.strength DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1084": "SELECTCOUNT(*) \nFROM Player_Attributes \nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id \nWHERE strftime('%Y', Player.birthday) < '1986' \nAND Player_Attributes.defensive_work_rate = 'high' \nAND Player_Attributes.attacking_work_rate = 'medium'\t----- bird -----\teuropean_football_2",
    "1085": "SELECTPlayer.player_name, Player_Attributes.crossing\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.player_name IN ('Alexis', 'Ariel Borysiuk', 'Arouna Kone')\nORDER BY Player_Attributes.crossing DESC\t----- bird -----\teuropean_football_2",
    "1086": "SELECTheading_accuracy\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Ariel Borysiuk'\t----- bird -----\teuropean_football_2",
    "1087": "SELECTCOUNT(*) \nFROM Player_Attributes \nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id \nWHERE Player.height > 180 AND Player_Attributes.volleys > 70\t----- bird -----\teuropean_football_2",
    "1088": "SELECTPlayer.player_name\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player_Attributes.volleys > 70 AND Player_Attributes.dribbling > 70\t----- bird -----\teuropean_football_2",
    "1089": "SELECTCOUNT(*) \nFROM Match \nWHERE season = '2008/2009' \nAND country_id = (SELECT id FROM Country WHERE name = 'Belgium')\t----- bird -----\teuropean_football_2",
    "1090": "SELECTPlayer_Attributes.long_passing\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.birthday = (SELECT MIN(birthday) FROM Player)\t----- bird -----\teuropean_football_2",
    "1091": "SELECTCOUNT(*) \nFROM Match \nWHERE league_id = (SELECT id FROM League WHERE name = 'Belgium Jupiler League') \nAND date LIKE '2009-04%'\t----- bird -----\teuropean_football_2",
    "1092": "SELECTLeague.name, COUNT(Match.id) AS match_count\nFROM League\nJOIN Match ON League.id = Match.league_id\nWHERE Match.season = '2008/2009'\nGROUP BY League.name\nORDER BY match_count DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1093": "SELECTAVG(overall_rating) \nFROM Player_Attributes \nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id \nWHERE strftime('%Y', birthday) < '1986'\t----- bird -----\teuropean_football_2",
    "1094": "SELECT(Player_Attributes.overall_rating - Player_Attributes.overall_rating) * 100.0 / Player_Attributes.overall_rating AS percentage_difference\nFROM Player_Attributes\nJOIN Player AS player1 ON Player_Attributes.player_api_id = player1.player_api_id\nJOIN Player AS player2 ON Player_Attributes.player_api_id = player2.player_api_id\nWHERE player1.player_name = 'Ariel Borysiuk' AND player2.player_name = 'Paulin Puel'\t----- bird -----\teuropean_football_2",
    "1095": "SELECTAVG(buildUpPlaySpeed) \nFROM Team_Attributes \nWHERE team_api_id = (SELECT team_api_id FROM Team WHERE team_long_name = 'Heart of Midlothian')\t----- bird -----\teuropean_football_2",
    "1096": "SELECTAVG(overall_rating)\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Pietro Marino'\t----- bird -----\teuropean_football_2",
    "1097": "SELECT`crossing`\nFROM `Player_Attributes`\nWHERE `player_api_id` = (SELECT `player_api_id` FROM `Player` WHERE `player_name` = 'Aaron Lennox')\t----- bird -----\teuropean_football_2",
    "1098": "SELECTMAX(chanceCreationPassing) AS highest_chance_creation_passing, \n       chanceCreationPassingClass\nFROM Team_Attributes\nWHERE team_api_id = (SELECT team_api_id FROM Team WHERE team_long_name = 'Ajax')\t----- bird -----\teuropean_football_2",
    "1099": "SELECTpreferred_foot\nFROM Player_Attributes\nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Abdou Diallo')\t----- bird -----\teuropean_football_2",
    "1100": "SELECTMAX(overall_rating) \nFROM Player_Attributes \nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Dorlan Pabon')\t----- bird -----\teuropean_football_2",
    "1101": "SELECTAVG(away_team_goal)\nFROM \"Match\"\nWHERE away_team_api_id = (SELECT team_api_id FROM Team WHERE team_long_name = 'Parma')\nAND country_id = (SELECT id FROM Country WHERE name = 'Italy')\t----- bird -----\teuropean_football_2",
    "1102": "SELECTPlayer.player_name\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player_Attributes.overall_rating = 77\nAND Player_Attributes.date = '2016-06-23'\nORDER BY Player.birthday DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1103": "SELECToverall_rating\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Aaron Mooy' AND Player_Attributes.date = '2016-02-04'\t----- bird -----\teuropean_football_2",
    "1104": "SELECTpotential\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Francesco Parravicini'\nAND Player_Attributes.date = '2010-08-30'\t----- bird -----\teuropean_football_2",
    "1105": "SELECTattacking_work_rate\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Francesco Migliore'\nAND Player_Attributes.date = '2015-05-01'\t----- bird -----\teuropean_football_2",
    "1106": "SELECTdefensive_work_rate\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Kevin Berigaud'\nAND Player_Attributes.date = '2013-02-22'\t----- bird -----\teuropean_football_2",
    "1107": "SELECTMAX(date) \nFROM Player_Attributes \nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Kevin Constant') \nAND crossing = (SELECT MAX(crossing) FROM Player_Attributes WHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Kevin Constant'))\t----- bird -----\teuropean_football_2",
    "1108": "SELECTTeam.team_long_name, Team_Attributes.buildUpPlaySpeedClass\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team.team_long_name = \"Willem II\"\nAND Team_Attributes.date = \"2011-02-22\"\t----- bird -----\teuropean_football_2",
    "1109": "SELECTTeam.team_long_name, Team_Attributes.buildUpPlayDribblingClass\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team.team_short_name = \"LEI\"\nAND Team_Attributes.date = \"2015-09-10\"\t----- bird -----\teuropean_football_2",
    "1110": "SELECTTeam_Attributes.buildUpPlayPassingClass\nFROM Team_Attributes\nJOIN Team ON Team_Attributes.team_api_id = Team.team_api_id\nWHERE Team.team_long_name = \"FC Lorient\"\nAND Team_Attributes.date = \"2010-02-22\"\t----- bird -----\teuropean_football_2",
    "1111": "SELECT`chanceCreationPassingClass`\nFROM `Team_Attributes`\nJOIN `Team` ON `Team_Attributes`.`team_api_id` = `Team`.`team_api_id`\nWHERE `Team`.`team_long_name` = \"PEC Zwolle\"\nAND `Team_Attributes`.`date` = \"2013-09-20\"\t----- bird -----\teuropean_football_2",
    "1112": "SELECT`chanceCreationCrossingClass`\nFROM `Team_Attributes`\nJOIN `Team` ON `Team_Attributes`.`team_api_id` = `Team`.`team_api_id`\nWHERE `Team`.`team_long_name` = \"Hull City\"\nAND `Team_Attributes`.`date` = \"2010-02-22\"\t----- bird -----\teuropean_football_2",
    "1113": "SELECT`Team_Attributes`.`defenceAggressionClass`\nFROM `Team_Attributes`\nJOIN `Team` ON `Team_Attributes`.`team_api_id` = `Team`.`team_api_id`\nWHERE `Team`.`team_long_name` = 'Hannover 96'\nAND `Team_Attributes`.`date` = '2015-09-10'\t----- bird -----\teuropean_football_2",
    "1114": "SELECTAVG(overall_rating) \nFROM Player_Attributes \nWHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Marko Arnautovic') \nAND date BETWEEN '2007-02-22' AND '2016-04-21'\t----- bird -----\teuropean_football_2",
    "1115": "SELECT(Player_Attributes.overall_rating - (SELECT overall_rating FROM Player_Attributes WHERE player_api_id = (SELECT player_api_id FROM Player WHERE player_name = 'Jordan Bowery')))*100.0/(SELECT overall_rating FROM Player_Attributes WHERE player_name = 'Jordan Bowery') AS percentage_higher\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Landon Donovan'\nAND Player_Attributes.date = '2013-07-12'\t----- bird -----\teuropean_football_2",
    "1116": "SELECTPlayer.player_name\nFROM Player\nORDER BY Player.height DESC\nLIMIT 10\t----- bird -----\teuropean_football_2",
    "1117": "SELECTPlayer.player_api_id\nFROM Player\nORDER BY weight DESC\nLIMIT 10\t----- bird -----\teuropean_football_2",
    "1118": "SELECTplayer_name\nFROM Player\nWHERE strftime('%Y', 'now') - strftime('%Y', birthday) >= 35\t----- bird -----\teuropean_football_2",
    "1119": "SELECTSUM(home_team_goal) \nFROM Match \nWHERE home_player_1 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_2 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_3 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_4 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_5 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_6 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_7 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_8 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_9 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_10 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\nOR home_player_11 IN (SELECT player_api_id FROM Player WHERE player_name = 'Aaron Lennon')\t----- bird -----\teuropean_football_2",
    "1120": "SELECTSUM(M.away_team_goal)\nFROM Match M\nJOIN Player P ON M.away_player_1 = P.player_api_id\nWHERE P.player_name = 'Daan Smith'\nUNION\nSELECT SUM(M.away_team_goal)\nFROM Match M\nJOIN Player P ON M.away_player_1 = P.player_api_id\nWHERE P.player_name = 'Filipe Ferreira'\t----- bird -----\teuropean_football_2",
    "1121": "SELECTSUM(home_team_goal)\nFROM Match\nJOIN Player ON Match.home_player_1 = Player.player_api_id OR\n               Match.home_player_2 = Player.player_api_id OR\n               Match.home_player_3 = Player.player_api_id OR\n               Match.home_player_4 = Player.player_api_id OR\n               Match.home_player_5 = Player.player_api_id OR\n               Match.home_player_6 = Player.player_api_id OR\n               Match.home_player_7 = Player.player_api_id OR\n               Match.home_player_8 = Player.player_api_id OR\n               Match.home_player_9 = Player.player_api_id OR\n               Match.home_player_10 = Player.player_api_id OR\n               Match.home_player_11 = Player.player_api_id\nWHERE strftime('%Y', date) - strftime('%Y', birthday) <= 30\t----- bird -----\teuropean_football_2",
    "1122": "SELECTplayer_name\nFROM Player\nWHERE player_api_id = (\n    SELECT player_api_id\n    FROM Player_Attributes\n    WHERE overall_rating = (\n        SELECT MAX(overall_rating)\n        FROM Player_Attributes\n    )\n)\t----- bird -----\teuropean_football_2",
    "1123": "SELECTPlayer.player_name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nORDER BY Player_Attributes.potential DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1124": "SELECTPlayer.player_name\nFROM Player\nJOIN Match ON Player.player_api_id = Match.home_player_1 OR\n             Player.player_api_id = Match.home_player_2 OR\n             Player.player_api_id = Match.home_player_3 OR\n             Player.player_api_id = Match.home_player_4 OR\n             Player.player_api_id = Match.home_player_5 OR\n             Player.player_api_id = Match.home_player_6 OR\n             Player.player_api_id = Match.home_player_7 OR\n             Player.player_api_id = Match.home_player_8 OR\n             Player.player_api_id = Match.home_player_9 OR\n             Player.player_api_id = Match.home_player_10 OR\n             Player.player_api_id = Match.home_player_11\nWHERE Match.goal = '1' AND Match.shoton IS NOT NULL\t----- bird -----\teuropean_football_2",
    "1125": "SELECTPlayer.player_name\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player_Attributes.finishing = 1\nORDER BY strftime('%Y', Player.birthday) ASC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1126": "SELECTPlayer.player_name\nFROM Player\nJOIN Country ON Player.country_id = Country.id\nWHERE Country.name = 'Belgium'\t----- bird -----\teuropean_football_2",
    "1127": "SELECTPlayer.player_name, Country.name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nJOIN Country ON Player.country_id = Country.id\nWHERE Player_Attributes.vision >= 90\t----- bird -----\teuropean_football_2",
    "1128": "SELECTCountry.name, AVG(Player.weight) AS avg_weight\nFROM Country\nJOIN Player ON Country.id = Player.country_id\nGROUP BY Country.name\nORDER BY avg_weight DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1129": "SELECTTeam.team_long_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.buildUpPlaySpeedClass = 'Slow'\t----- bird -----\teuropean_football_2",
    "1130": "SELECTTeam.team_short_name\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team_Attributes.chanceCreationPassingClass = 'Safe'\t----- bird -----\teuropean_football_2",
    "1131": "SELECTAVG(height)\nFROM Player\nWHERE player_api_id IN (\n    SELECT player_api_id\n    FROM Player\n    WHERE player_fifa_api_id IN (\n        SELECT player_fifa_api_id\n        FROM Player\n        WHERE player_api_id IN (\n            SELECT player_api_id\n            FROM Player\n            WHERE player_fifa_api_id IN (\n                SELECT player_fifa_api_id\n                FROM Player\n                WHERE player_api_id IN (\n                    SELECT player_api_id\n                    FROM Player\n                    WHERE player_fifa_api_id IN (\n                        SELECT player_fifa_api_id\n                        FROM Player\n                        WHERE player_api_id IN (\n                            SELECT player_api_id\n                            FROM Player\n                            WHERE player_fifa_api_id IN (\n                                SELECT player_fifa_api_id\n                                FROM Player\n                                WHERE player_api_id IN (\n                                    SELECT player_api_id\n                                    FROM Player\n                                    WHERE player_fifa_api_id IN (\n                                        SELECT player_fifa_api_id\n                                        FROM Player\n                                        WHERE player_api_id IN (\n                                            SELECT player_api_id\n                                            FROM Player\n                                            WHERE player_fifa_api_id IN (\n                                                SELECT player_fifa_api_id\n                                                FROM Player\n                                                WHERE player_api_id IN (\n                                                    SELECT player_api_id\n                                                    FROM Player\n                                                    WHERE player_fifa\t----- bird -----\teuropean_football_2",
    "1132": "SELECTPlayer.player_name\nFROM Player\nWHERE Player.height > 180\nORDER BY Player.player_name\nLIMIT 3\t----- bird -----\teuropean_football_2",
    "1133": "SELECTCOUNT(*) \nFROM Player\nWHERE player_name LIKE 'Aaron%' AND strftime('%Y', birthday) > '1990'\t----- bird -----\teuropean_football_2",
    "1134": "SELECTABS(p1.jumping - p2.jumping) AS jumping_difference\nFROM Player_Attributes p1\nJOIN Player_Attributes p2 ON p1.id = 6 AND p2.id = 23\t----- bird -----\teuropean_football_2",
    "1135": "SELECT`player_api_id`\nFROM `Player_Attributes`\nWHERE `preferred_foot` = 'right'\nORDER BY `potential`\nLIMIT 5\t----- bird -----\teuropean_football_2",
    "1136": "SELECTCOUNT(*) \nFROM Player_Attributes \nWHERE crossing = (SELECT MAX(crossing) FROM Player_Attributes) \nAND preferred_foot = 'left' \nAND attacking_work_rate = 'high'\t----- bird -----\teuropean_football_2",
    "1137": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Player_Attributes WHERE strength > 80 AND stamina > 80) FROM Player_Attributes WHERE strength > 80 AND stamina > 80\t----- bird -----\teuropean_football_2",
    "1138": "SELECTCountry.name\nFROM Country\nJOIN League ON Country.id = League.country_id\nWHERE League.name = 'Poland Ekstraklasa'\t----- bird -----\teuropean_football_2",
    "1139": "SELECThome_team_goal, away_team_goal\nFROM Match\nWHERE date = '2008-09-24'\nAND league_id = (SELECT id FROM League WHERE name = 'Belgian Jupiler League')\t----- bird -----\teuropean_football_2",
    "1140": "SELECTsprint_speed, agility, acceleration\nFROM Player_Attributes\nJOIN Player ON Player_Attributes.player_api_id = Player.player_api_id\nWHERE Player.player_name = 'Alexis Blin'\t----- bird -----\teuropean_football_2",
    "1141": "SELECTTeam.team_long_name, Team_Attributes.buildUpPlaySpeedClass\nFROM Team\nJOIN Team_Attributes ON Team.team_api_id = Team_Attributes.team_api_id\nWHERE Team.team_long_name = 'KSV Cercle Brugge'\t----- bird -----\teuropean_football_2",
    "1142": "SELECTCOUNT(*) \nFROM Match \nWHERE league_id = (SELECT id FROM League WHERE name = 'Italy Serie A') \nAND season = '2015/2016'\t----- bird -----\teuropean_football_2",
    "1143": "SELECTMAX(home_team_goal)\nFROM Match\nWHERE league_id = (SELECT id FROM League WHERE name = 'Netherlands Eredivisie')\t----- bird -----\teuropean_football_2",
    "1144": "SELECTPlayer.player_name, Player.weight, Player_Attributes.finishing, Player_Attributes.curve\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nWHERE Player.weight = (SELECT MAX(weight) FROM Player)\t----- bird -----\teuropean_football_2",
    "1145": "SELECTLeague.name, COUNT(Match.id) AS num_games\nFROM League\nJOIN Match ON League.id = Match.league_id\nWHERE Match.season = '2015/2016'\nGROUP BY League.name\nORDER BY num_games DESC\nLIMIT 4\t----- bird -----\teuropean_football_2",
    "1146": "SELECTTeam.team_long_name\nFROM Match\nJOIN Team ON Match.away_team_api_id = Team.team_api_id\nWHERE Match.away_team_goal = (SELECT MAX(away_team_goal) FROM Match)\t----- bird -----\teuropean_football_2",
    "1147": "SELECTplayer_name\nFROM Player\nJOIN Player_Attributes ON Player.player_api_id = Player_Attributes.player_api_id\nORDER BY strength DESC\nLIMIT 1\t----- bird -----\teuropean_football_2",
    "1148": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Player_Attributes WHERE height < 180 AND strength > 70) \nFROM Player_Attributes \nWHERE height < 180 AND strength > 70\t----- bird -----\teuropean_football_2",
    "1149": "SELECTCOUNT(*) as Total,\n    SUM(CASE WHEN Admission = 'In-patient' THEN 1 ELSE 0 END) as Inpatient,\n    SUM(CASE WHEN Admission = 'Outpatient' THEN 1 ELSE 0 END) as Outpatient,\n    SUM(CASE WHEN SEX = 'Male' AND Admission = 'In-patient' THEN 1 ELSE 0 END) as MaleInpatient,\n    SUM(CASE WHEN SEX = 'Male' AND Admission = 'Outpatient' THEN 1 ELSE 0 END) as MaleOutpatient,\n    (MaleInpatient * 100.0 / Inpatient) - (MaleOutpatient * 100.0 / Outpatient) as Deviation\nFROM Patient\nWHERE SEX = 'Male' and (Admission = 'In-patient' OR Admission = 'Outpatient')\t----- bird -----\tthrombosis_prediction",
    "1150": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE SEX = 'Female' AND Birthday > '1930-01-01') FROM Patient WHERE SEX = 'Female' AND Birthday > '1930-01-01'\t----- bird -----\tthrombosis_prediction",
    "1151": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE Birthday BETWEEN '1930-01-01' AND '1940-12-31') \nFROM Patient \nWHERE Birthday BETWEEN '1930-01-01' AND '1940-12-31' AND Admission = 'Inpatient'\t----- bird -----\tthrombosis_prediction",
    "1152": "SELECTCOUNT(DISTINCT p.ID) AS TotalPatients,\n       COUNT(DISTINCT p.ID) FILTER (WHERE p.Admission = 'Outpatient') AS OutpatientPatients,\n       COUNT(DISTINCT p.ID) FILTER (WHERE p.Admission = 'Inpatient') AS InpatientPatients,\n       (COUNT(DISTINCT p.ID) FILTER (WHERE p.Admission = 'Outpatient') * 1.0) / (COUNT(DISTINCT p.ID) FILTER (WHERE p.Admission = 'Inpatient')) AS Ratio\nFROM Patient p\nJOIN Examination e ON p.ID = e.ID\nWHERE e.Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1153": "SELECTDiagnosis, Date\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.ID = 30609\t----- bird -----\tthrombosis_prediction",
    "1154": "SELECTPatient.SEX, Patient.Birthday, Examination.`Examination Date`, Examination.Symptoms\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Patient.ID = 163109\t----- bird -----\tthrombosis_prediction",
    "1155": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.LDH > 0\t----- bird -----\tthrombosis_prediction",
    "1156": "SELECTPatient.ID, \n    strftime('%Y', 'now') - strftime('%Y', Patient.Birthday) AS Age\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Examination.Thrombosis = 1\t----- bird -----\tthrombosis_prediction",
    "1157": "SELECTPatient.ID, Patient.SEX, Patient.Diagnosis\nFROM Examination\nJOIN Patient ON Examination.ID = Patient.ID\nWHERE Examination.Thrombosis = 'severe'\t----- bird -----\tthrombosis_prediction",
    "1158": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.Birthday LIKE '1937%'\nAND Laboratory.`T-CHO` > 200\t----- bird -----\tthrombosis_prediction",
    "1159": "SELECTPatient.ID, Patient.SEX, Patient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.ALB < 3.5\t----- bird -----\tthrombosis_prediction",
    "1160": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE SEX = 'Female') AS Percentage\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE SEX = 'Female' AND (TP < 6.4 OR TP > 8.3)\t----- bird -----\tthrombosis_prediction",
    "1161": "SELECTAVG(`aCL IgG`) \nFROM Examination \nWHERE ID IN (SELECT ID FROM Patient WHERE strftime('%Y', Birthday) <= strftime('%Y', 'now') - 50)\t----- bird -----\tthrombosis_prediction",
    "1162": "SELECTCOUNT(*)\nFROM Patient\nWHERE SEX = 'Female' AND Admission = 'Outpatient' AND strftime('%Y', `First Date`) = '1997'\t----- bird -----\tthrombosis_prediction",
    "1163": "SELECTMIN(strftime('%Y', 'now') - strftime('%Y', Birthday)) AS \"Age\"\nFROM Patient\nWHERE Admission = 'Yes'\t----- bird -----\tthrombosis_prediction",
    "1164": "SELECTCOUNT(*) \nFROM Examination \nWHERE Thrombosis = (SELECT MAX(Thrombosis) FROM Examination WHERE strftime('%Y', `Examination Date`) = '1997') \nAND ID IN (SELECT ID FROM Patient WHERE SEX = 'Female')\t----- bird -----\tthrombosis_prediction",
    "1165": "SELECTMAX(strftime('%Y', 'now') - strftime('%Y', Birthday)) - MIN(strftime('%Y', 'now') - strftime('%Y', Birthday)) AS AgeGap\nFROM Patient\nWHERE ID IN (SELECT ID FROM Laboratory WHERE TG < 150)\t----- bird -----\tthrombosis_prediction",
    "1166": "SELECTPatient.ID, Patient.Symptoms, Patient.Diagnosis\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Patient.Birthday = (SELECT MIN(Birthday) FROM Patient)\t----- bird -----\tthrombosis_prediction",
    "1167": "SELECTCOUNT(DISTINCT Patient.ID) / 12\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.SEX = 'Male'\nAND Laboratory.Date BETWEEN '1998-01-01' AND '1998-12-31'\t----- bird -----\tthrombosis_prediction",
    "1168": "SELECTMAX(L.Date) AS \"Oldest SJS Patient Lab Date\", \n       (strftime('%Y', P.First Date) - strftime('%Y', P.Birthday)) AS \"Age at Initial Hospital Arrival\"\nFROM Laboratory L\nJOIN Patient P ON L.ID = P.ID\nWHERE P.Diagnosis = 'SJS'\t----- bird -----\tthrombosis_prediction",
    "1169": "SELECTPatient.SEX, COUNT(*) as TotalCount\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.UA < 3.5 OR Laboratory.UA > 7.2\nGROUP BY Patient.SEX\t----- bird -----\tthrombosis_prediction",
    "1170": "SELECTCOUNT(*) \nFROM Patient \nWHERE `First Date` < DATE('now', '-1 year') \nAND ID NOT IN (SELECT ID FROM Examination)\t----- bird -----\tthrombosis_prediction",
    "1171": "SELECTCOUNT(*) \nFROM Patient \nWHERE Birthday BETWEEN '1990-01-01' AND '1993-12-31'\t----- bird -----\tthrombosis_prediction",
    "1172": "SELECTCOUNT(*) \nFROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nWHERE Patient.SEX = 'Male' AND Laboratory.`T-BIL` > 0\t----- bird -----\tthrombosis_prediction",
    "1173": "SELECTDiagnosis, COUNT(*) as DiagnosisCount\nFROM Examination\nWHERE ID IN (SELECT ID FROM Laboratory WHERE Date BETWEEN '1985-01-01' AND '1995-12-31')\nGROUP BY Diagnosis\nORDER BY DiagnosisCount DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1174": "SELECTROUND(AVG(strftime('%Y', '1999') - strftime('%Y', Birthday)), 2) AS \"Average Age\"\nFROM Patient\nWHERE ID IN (\n    SELECT ID\n    FROM Laboratory\n    WHERE strftime('%Y-%m', Date) = '1991-10'\n)\t----- bird -----\tthrombosis_prediction",
    "1175": "SELECTPatient.ID, Patient.Birthday, Examination.`Examination Date`, Examination.Diagnosis, Laboratory.HGB\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.HGB = (SELECT MAX(HGB) FROM Laboratory)\nORDER BY Patient.Birthday ASC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1176": "SELECTANA\nFROM Examination\nWHERE ID = 3605340\nAND `Examination Date` = '1996-12-02'\t----- bird -----\tthrombosis_prediction",
    "1177": "SELECT`T-CHO`\nFROM Laboratory\nWHERE ID = 2927464\nAND Date = '1995-09-04'\t----- bird -----\tthrombosis_prediction",
    "1178": "SELECTPatient.SEX\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Examination.Diagnosis = 'AORTITIS'\nORDER BY Patient.`First Date`\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1179": "SELECT`aCL IgG`, `aCL IgM`, `aCL IgA`\nFROM Examination\nWHERE ID = (SELECT ID FROM Patient WHERE Diagnosis = 'SLE' AND `First Date` = '1994-02-19')\nAND `Examination Date` = '1993-11-12'\t----- bird -----\tthrombosis_prediction",
    "1180": "SELECTPatient.SEX\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.GPT = 9 AND Laboratory.Date = '1992-06-12'\t----- bird -----\tthrombosis_prediction",
    "1181": "SELECTstrftime('%Y', '1991-10-21') - strftime('%Y', Birthday) AS Age\nFROM Patient\nWHERE ID IN (SELECT ID FROM Laboratory WHERE UA = 8.4 AND Date = '1991-10-21')\t----- bird -----\tthrombosis_prediction",
    "1182": "SELECTCOUNT(*)\nFROM Laboratory\nWHERE ID = (SELECT ID FROM Patient WHERE `First Date` = '1991-06-13' AND Diagnosis = 'SJS')\nAND Date BETWEEN '1995-01-01' AND '1995-12-31'\t----- bird -----\tthrombosis_prediction",
    "1183": "SELECTDiagnosis\nFROM Patient\nWHERE ID = (SELECT ID FROM Examination WHERE Diagnosis = 'SLE' AND `Examination Date` = '1997-01-27')\t----- bird -----\tthrombosis_prediction",
    "1184": "SELECTExamination.Symptoms\nFROM Examination\nJOIN Patient ON Examination.ID = Patient.ID\nWHERE Patient.Birthday = '1959-03-01'\nAND Examination.`Examination Date` = '1993-09-27'\t----- bird -----\tthrombosis_prediction",
    "1185": "SELECT\n    (l1.`T-CHO` - l2.`T-CHO`) / l1.`T-CHO` AS Decrease_Rate\nFROM\n    Laboratory l1\nJOIN\n    Laboratory l2 ON l1.ID = l2.ID\nWHERE\n    l1.Date = '1981-11-01' AND l2.Date = '1981-12-01'\n    AND EXISTS (SELECT 1 FROM Patient p WHERE p.ID = l1.ID AND p.Birthday = '1959-02-18')\t----- bird -----\tthrombosis_prediction",
    "1186": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Patient.Diagnosis = 'Behcet\\'s'\nAND Examination.`Examination Date` BETWEEN '1977-01-01' AND '1997-12-31'\t----- bird -----\tthrombosis_prediction",
    "1187": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Examination.`Examination Date` BETWEEN '1987-07-06' AND '1996-01-31'\nAND Laboratory.GPT > 30\nAND Laboratory.ALB < 4\t----- bird -----\tthrombosis_prediction",
    "1188": "SELECTPatient.ID\nFROM Patient\nWHERE Patient.SEX = 'Female'\nAND strftime('%Y', Patient.Birthday) = '1964'\nAND Patient.Admission IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1189": "SELECTCOUNT(*) \nFROM Examination \nWHERE Thrombosis = 2 \nAND `ANA Pattern` = 'S' \nAND `aCL IgM` > (SELECT AVG(`aCL IgM`) * 1.2 FROM Examination)\t----- bird -----\tthrombosis_prediction",
    "1190": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Laboratory WHERE `U-PRO` = 'Normal' AND UA < 5.5) \nFROM Laboratory \nWHERE `U-PRO` = 'Normal' AND UA < 5.5\t----- bird -----\tthrombosis_prediction",
    "1191": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE SEX = 'Male' AND strftime('%Y', `First Date`) = '1981' AND Diagnosis = 'BEHCET') \nFROM Patient \nWHERE SEX = 'Male' AND strftime('%Y', `First Date`) = '1981' AND Diagnosis = 'BEHCET'\t----- bird -----\tthrombosis_prediction",
    "1192": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.Date BETWEEN '1991-10-01' AND '1991-10-31'\nAND Laboratory.`T-BIL` >= 0.3 AND Laboratory.`T-BIL` <= 1.2\t----- bird -----\tthrombosis_prediction",
    "1193": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID NOT IN (\n    SELECT ID\n    FROM Examination\n    WHERE `ANA Pattern` = 'P'\n)\nAND SEX = 'Female'\nAND Birthday BETWEEN '1980-01-01' AND '1989-12-31'\t----- bird -----\tthrombosis_prediction",
    "1194": "SELECTPatient.SEX\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Examination.Diagnosis = 'PSS'\nAND Laboratory.CRP = '2+'\nAND Laboratory.CRE = 1\nAND Laboratory.LDH = 123\t----- bird -----\tthrombosis_prediction",
    "1195": "SELECTAVG(L.ALB)\nFROM Laboratory L\nJOIN Patient P ON L.ID = P.ID\nJOIN Examination E ON L.ID = E.ID\nWHERE P.SEX = 'Female'\nAND L.PLT > 400\nAND P.Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1196": "SELECTSymptoms\nFROM Examination\nWHERE Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1197": "SELECT`First Date`, Diagnosis\nFROM Patient\nWHERE ID = 48473\t----- bird -----\tthrombosis_prediction",
    "1198": "SELECTCOUNT(*) \nFROM Patient \nWHERE SEX = 'Female' AND Diagnosis LIKE '%APS%'\t----- bird -----\tthrombosis_prediction",
    "1199": "SELECTCOUNT(DISTINCT Patient.ID)\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE strftime('%Y', Examination.`Examination Date`) = '1997'\nAND (Laboratory.TP < 6.6 OR Laboratory.ALB < 3.5 OR Laboratory.UA > 7.2 OR Laboratory.UN > 20 OR Laboratory.CRE > 1.2 OR Laboratory.`T-BIL` > 1.2 OR Laboratory.`T-CHO` > 200 OR Laboratory.TG > 150 OR Laboratory.CPK > 200 OR Laboratory.GLU > 100 OR Laboratory.WBC < 4 OR Laboratory.WBC > 10 OR Laboratory.RBC < 4.2 OR Laboratory.RBC > 5.4 OR Laboratory.HGB < 13 OR Laboratory.HGB > 17 OR Laboratory.HCT < 38 OR Laboratory.HCT > 52 OR Laboratory.PLT < 150 OR Laboratory.PT > 14 OR Laboratory.APTT > 40 OR Laboratory.FG < 2 OR Laboratory.PIC > 5 OR Laboratory.TAT > 10 OR Laboratory.TAT2 > 10 OR Laboratory.IGG < 700 OR Laboratory.IGA <\t----- bird -----\tthrombosis_prediction",
    "1200": "SELECTCOUNT(DISTINCT Patient.ID)\nFROM Examination\nJOIN Patient ON Examination.ID = Patient.ID\nWHERE Examination.Thrombosis = 1\nAND Examination.Diagnosis LIKE '%SLE%'\t----- bird -----\tthrombosis_prediction",
    "1201": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE Birthday LIKE '1980%' AND Diagnosis = 'RA') AS Percentage\nFROM Patient\nWHERE Birthday LIKE '1980%' AND Diagnosis = 'RA' AND SEX = 'Female'\t----- bird -----\tthrombosis_prediction",
    "1202": "SELECTCOUNT(*) \nFROM Patient \nJOIN Examination ON Patient.ID = Examination.ID \nWHERE Patient.SEX = 'Male' \nAND Examination.`Examination Date` BETWEEN '1995-01-01' AND '1997-12-31' \nAND Examination.Diagnosis = 'Behcet disease' \nAND Patient.Admission IS NULL\t----- bird -----\tthrombosis_prediction",
    "1203": "SELECTCOUNT(*) \nFROM Patient p\nJOIN Laboratory l ON p.ID = l.ID\nWHERE p.SEX = 'female' AND l.WBC < 3.5\t----- bird -----\tthrombosis_prediction",
    "1204": "SELECTjulianday(Examination.`Examination Date`) - julianday(Patient.`First Date`) AS Evaluation_Duration\nFROM Examination\nJOIN Patient ON Examination.ID = Patient.ID\nWHERE Patient.ID = 821298\t----- bird -----\tthrombosis_prediction",
    "1205": "SELECTUA\nFROM Laboratory\nWHERE ID = 57266\t----- bird -----\tthrombosis_prediction",
    "1206": "SELECTLaboratory.Date\nFROM Laboratory\nWHERE Laboratory.ID = 48473\nAND Laboratory.GOT > 40\t----- bird -----\tthrombosis_prediction",
    "1207": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.Date LIKE '1994%'\nAND Laboratory.GOT BETWEEN 10 AND 40\t----- bird -----\tthrombosis_prediction",
    "1208": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.SEX = 'Male'\nAND Laboratory.GPT > 40\t----- bird -----\tthrombosis_prediction",
    "1209": "SELECTPatient.ID, Patient.SEX, Patient.Birthday, Patient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.GPT > 40\nORDER BY Patient.Birthday ASC\t----- bird -----\tthrombosis_prediction",
    "1210": "SELECTAVG(LDH) \nFROM Laboratory \nWHERE LDH >= 100 AND LDH <= 250\t----- bird -----\tthrombosis_prediction",
    "1211": "SELECTPatient.ID, \n    strftime('%Y', 'now') - strftime('%Y', Patient.Birthday) as Age\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE LDH > 300\nAND LDH < 1000\t----- bird -----\tthrombosis_prediction",
    "1212": "SELECTPatient.Admission\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.ALP >= 20 AND Laboratory.ALP <= 140\nAND Patient.Admission = 'Inpatient'\t----- bird -----\tthrombosis_prediction",
    "1213": "SELECTPatient.ID\nFROM Patient\nWHERE Birthday = '1982-04-01';\t----- bird -----\tthrombosis_prediction",
    "1214": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.TP < 6.4\t----- bird -----\tthrombosis_prediction",
    "1215": "SELECTPatient.ID, Patient.SEX, Laboratory.TP - 6.4 AS TP_Deviation\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.SEX = 'Female' AND Laboratory.TP > 6.4\t----- bird -----\tthrombosis_prediction",
    "1216": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.SEX = 'Male' AND (Laboratory.ALB < 3.5 OR Laboratory.ALB > 5.5)\nORDER BY Patient.Birthday DESC\t----- bird -----\tthrombosis_prediction",
    "1217": "SELECTPatient.ID, Patient.Birthday, Laboratory.ALB\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE strftime('%Y', Patient.Birthday) = '1982' \nAND Laboratory.ALB >= 3.5 AND Laboratory.ALB <= 5.5\t----- bird -----\tthrombosis_prediction",
    "1218": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM Patient WHERE SEX = 'Female') AS Percentage\nFROM Laboratory\nWHERE UA > 7.0\t----- bird -----\tthrombosis_prediction",
    "1219": "SELECTPatient.ID, MAX(Laboratory.Date) AS Latest_Date, Laboratory.UA\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.UA <= 7\nGROUP BY Patient.ID\nHAVING MAX(Laboratory.Date) = Laboratory.Date\nORDER BY Patient.ID\t----- bird -----\tthrombosis_prediction",
    "1220": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.UN >= 7 AND Laboratory.UN <= 20\t----- bird -----\tthrombosis_prediction",
    "1221": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.RA = 'RA' AND Laboratory.UN < 7.2\t----- bird -----\tthrombosis_prediction",
    "1222": "SELECTCOUNT(*) \nFROM Patient \nWHERE SEX = 'Male' \nAND ID IN (SELECT ID FROM Laboratory WHERE CRE NOT BETWEEN 0.5 AND 1.2)\t----- bird -----\tthrombosis_prediction",
    "1223": "SELECTCOUNT(*) \nFROM Patient \nWHERE SEX = 'Male' \nAND ID IN (SELECT ID FROM Laboratory WHERE CRE NOT BETWEEN 0.6 AND 1.2) \n> \n(SELECT COUNT(*) \nFROM Patient \nWHERE SEX = 'Female' \nAND ID IN (SELECT ID FROM Laboratory WHERE CRE NOT BETWEEN 0.6 AND 1.2))\t----- bird -----\tthrombosis_prediction",
    "1224": "SELECTMAX(`T-BIL`) AS Highest_Total_Bilirubin_Level, Patient.ID, Patient.SEX, Patient.Birthday\nFROM Laboratory\nJOIN Patient ON Laboratory.ID = Patient.ID\nWHERE `T-BIL` = (SELECT MAX(`T-BIL`) FROM Laboratory)\t----- bird -----\tthrombosis_prediction",
    "1225": "SELECTPatient.SEX, Laboratory.`T-BIL`\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.`T-BIL` NOT BETWEEN 0.2 AND 1.2\nGROUP BY Patient.SEX, Laboratory.`T-BIL`\t----- bird -----\tthrombosis_prediction",
    "1226": "SELECTPatient.ID, MAX(Laboratory.`T-CHO`) AS Highest_T_CHO\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nORDER BY Patient.Birthday ASC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1227": "SELECTROUND(AVG(strftime('%Y', 'now') - strftime('%Y', Birthday))\nFROM Patient\nWHERE SEX = 'Male'\nAND ID IN (SELECT ID FROM Laboratory WHERE `T-CHO` > 200)\t----- bird -----\tthrombosis_prediction",
    "1228": "SELECTPatient.ID, Patient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.TG > 100\t----- bird -----\tthrombosis_prediction",
    "1229": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE TG > 150 \n     AND ID IN \n         (SELECT ID \n          FROM Patient \n          WHERE Birthday < date('now', '-50 years')))\t----- bird -----\tthrombosis_prediction",
    "1230": "SELECTDISTINCT ID\nFROM Laboratory\nWHERE CPK >= 0 AND CPK <= 200\t----- bird -----\tthrombosis_prediction",
    "1231": "SELECTCOUNT(*) \nFROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nWHERE Patient.Birthday BETWEEN '1936-01-01' AND '1956-12-31' \nAND Patient.SEX = 'Male' \nAND Laboratory.CPK > 200\t----- bird -----\tthrombosis_prediction",
    "1232": "SELECTPatient.ID, Patient.SEX, \n    (strftime('%Y', 'now') - strftime('%Y', Patient.Birthday)) - \n    (strftime('%m-%d', 'now') < strftime('%m-%d', Patient.Birthday)) AS Age\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.GLU NOT BETWEEN 70 AND 100\nAND Laboratory.`T-CHO` BETWEEN 125 AND 200\t----- bird -----\tthrombosis_prediction",
    "1233": "SELECTPatient.ID, Laboratory.GLU\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.Date = (SELECT MIN(Date) FROM Laboratory WHERE Date LIKE '1991%')\nAND Laboratory.GLU >= 70 AND Laboratory.GLU <= 100\t----- bird -----\tthrombosis_prediction",
    "1234": "SELECTPatient.ID, Patient.SEX, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.WBC < 4 OR Laboratory.WBC > 11\nGROUP BY Patient.SEX, Patient.ID\nORDER BY Patient.Birthday ASC\t----- bird -----\tthrombosis_prediction",
    "1235": "SELECTPatient.ID, Patient.Birthday, Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.RBC < 4.5\nORDER BY Patient.ID\t----- bird -----\tthrombosis_prediction",
    "1236": "SELECTPatient.ID, Patient.SEX, Patient.Birthday, Patient.Admission\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.SEX = 'Female'\nAND strftime('%Y', 'now') - strftime('%Y', Patient.Birthday) >= 50\nAND (Laboratory.RBC < 4.2 OR Laboratory.RBC > 5.4)\nAND Patient.Admission IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1237": "SELECTPatient.ID, Patient.SEX\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.HGB < 12.0\t----- bird -----\tthrombosis_prediction",
    "1238": "SELECTPatient.ID, Patient.SEX\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Diagnosis = 'SLE' AND HGB >= 12\nORDER BY Birthday DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1239": "SELECTPatient.ID, \n       strftime('%Y', 'now') - strftime('%Y', Patient.Birthday) - (strftime('%m-%d', 'now') < strftime('%m-%d', Patient.Birthday)) AS Age\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.HCT > 45\nGROUP BY Patient.ID\nHAVING COUNT(*) >= 2\t----- bird -----\tthrombosis_prediction",
    "1240": "SELECTAVG(HCT) \nFROM Laboratory \nWHERE Date LIKE '1991%' \nAND HCT < 40\t----- bird -----\tthrombosis_prediction",
    "1241": "SELECTCOUNT(*) as `Number of Patients with Lower Than Normal Platelet Level`,\n       (SELECT COUNT(*) FROM Laboratory WHERE PLT > 150) as `Number of Patients with Higher Than Normal Platelet Level`\nFROM Laboratory\nWHERE PLT < 150\t----- bird -----\tthrombosis_prediction",
    "1242": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.Date = '1984-01-01'\nAND Patient.Birthday > date('now', '-50 years')\nAND Laboratory.PLT >= 150\nAND Laboratory.PLT <= 450\t----- bird -----\tthrombosis_prediction",
    "1243": "SELECTPatient.ID, Patient.SEX, Laboratory.PT\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.Birthday < date('now', '-55 years')\nAND Patient.SEX = 'Female'\nAND Laboratory.PT > 13.5\t----- bird -----\tthrombosis_prediction",
    "1244": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.`First Date` > '1992-01-01'\nAND Laboratory.PT < 14.5\t----- bird -----\tthrombosis_prediction",
    "1245": "SELECTCOUNT(*)\nFROM Examination\nWHERE `Examination Date` > '1997-01-01'\nAND KCT = 'inactivated partial prothrom bin time'\t----- bird -----\tthrombosis_prediction",
    "1246": "SELECTCOUNT(*) \nFROM Examination \nWHERE APTT <> 'Normal' AND Thrombosis = 0\t----- bird -----\tthrombosis_prediction",
    "1247": "SELECTCOUNT(*)\nFROM Patient p\nJOIN Laboratory l ON p.ID = l.ID\nWHERE p.SEX = 'Male'\nAND l.WBC >= 4.0 AND l.WBC <= 10.0\nAND (l.FG < 1.5 OR l.FG > 4.0)\t----- bird -----\tthrombosis_prediction",
    "1248": "SELECTCOUNT(*) \nFROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nWHERE Patient.Birthday > '1980-01-01' AND Laboratory.FG <> 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1249": "SELECTPatient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.`U-PRO` = 'High'\t----- bird -----\tthrombosis_prediction",
    "1250": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.`U-PRO` = 'Normal' AND Patient.Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1251": "SELECTCOUNT(*)\nFROM Examination\nWHERE `aCL IgG` > 0.0\t----- bird -----\tthrombosis_prediction",
    "1252": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Examination \n     WHERE `aCL IgG` <= 1.0 \n     AND Symptoms IS NOT NULL)\t----- bird -----\tthrombosis_prediction",
    "1253": "SELECTPatient.ID, Patient.Diagnosis\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Examination.`aCL IgA` = (SELECT MAX(`aCL IgA`) FROM Examination WHERE `aCL IgA` < 40)\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1254": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (\n    SELECT ID\n    FROM Examination\n    WHERE `aCL IgA` = 0\n)\nAND `First Date` > '1990-01-01'\t----- bird -----\tthrombosis_prediction",
    "1255": "SELECTDiagnosis, COUNT(*) as DiagnosisCount\nFROM Examination\nWHERE `aCL IgM` > 0\nGROUP BY Diagnosis\nORDER BY DiagnosisCount DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1256": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID NOT IN (SELECT ID FROM Laboratory WHERE CRP = 'abnormal')\t----- bird -----\tthrombosis_prediction",
    "1257": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (\n    SELECT ID\n    FROM Laboratory\n    WHERE CRE IS NOT NULL AND CRE <> 70\n)\t----- bird -----\tthrombosis_prediction",
    "1258": "SELECTCOUNT(*) \nFROM Patient p\nJOIN Examination e ON p.ID = e.ID\nWHERE RF = 'Normal' AND (KCT = 'Positive' OR RVVT = 'Positive' OR LAC = 'Positive')\t----- bird -----\tthrombosis_prediction",
    "1259": "SELECTPatient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.Birthday > '1985-01-01'\nAND Laboratory.RF = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1260": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Patient.Birthday < date('now', '-60 years')\nAND Laboratory.RF = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1261": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID NOT IN \n    (SELECT ID \n     FROM Examination \n     WHERE Thrombosis = 1) \nAND ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE RF = 'Normal')\t----- bird -----\tthrombosis_prediction",
    "1262": "SELECTCOUNT(*) \nFROM Patient p\nJOIN Examination e ON p.ID = e.ID\nWHERE e.`ANA Pattern` = 'P' AND e.C3 = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1263": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Examination.HCT < 39 OR Examination.HCT > 50\nORDER BY Examination.`aCL IgG` DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1264": "SELECTCOUNT(*) \nFROM Examination \nWHERE Thrombosis = 1 \nAND ID IN (SELECT ID FROM Laboratory WHERE C4 IS NULL OR C4 = 'Normal')\t----- bird -----\tthrombosis_prediction",
    "1265": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE RNP = 'Normal' \n     AND Admission = 'Yes')\t----- bird -----\tthrombosis_prediction",
    "1266": "SELECTPatient.ID, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.RNP = 'abnormal'\nORDER BY Patient.Birthday ASC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1267": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID NOT IN (\n    SELECT ID\n    FROM Examination\n    WHERE SM = 'Normal' AND Thrombosis = 0\n)\t----- bird -----\tthrombosis_prediction",
    "1268": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.SM = 'abnormal'\nORDER BY Patient.Birthday ASC\nLIMIT 3\t----- bird -----\tthrombosis_prediction",
    "1269": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE `Examination Date` > '1997-01-01'\nAND `aCL IgG` = 0\nAND `aCL IgM` = 0\nAND ANA = 0\nAND `ANA Pattern` = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1270": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (\n    SELECT ID\n    FROM Examination\n    WHERE `aCL IgG` < 20\n    AND `aCL IgM` < 20\n    AND `aCL IgA` < 20\n    AND ANA != 1\n    AND Symptoms IS NULL\n    )\nAND SEX = 'Female'\t----- bird -----\tthrombosis_prediction",
    "1271": "SELECTCOUNT(*)\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.Date < '2000-01-01'\nAND Laboratory.SSA = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1272": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.SSA = 'abnormal'\nORDER BY Patient.`First Date`\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1273": "SELECTCOUNT(*) \nFROM Examination \nWHERE `SSB` = 'Normal' \nAND Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1274": "SELECTCOUNT(*) \nFROM Examination \nWHERE `SSB` = 'Normal' \nAND Symptoms IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1275": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (\n    SELECT ID\n    FROM Laboratory\n    WHERE CENTROMEA = 'Normal' AND SSB = 'Normal'\n)\nAND SEX = 'Male'\t----- bird -----\tthrombosis_prediction",
    "1276": "SELECTPatient.ID, Patient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.DNA = 'abnormal'\t----- bird -----\tthrombosis_prediction",
    "1277": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID NOT IN (SELECT ID FROM Laboratory WHERE DNA = 'Normal')\t----- bird -----\tthrombosis_prediction",
    "1278": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE IGG = 'Normal' \n     AND ID IN \n         (SELECT ID \n          FROM Patient \n          WHERE Admission = 'Yes'))\t----- bird -----\tthrombosis_prediction",
    "1279": "SELECTCOUNT(DISTINCT Patient.ID) * 100.0 / (SELECT COUNT(DISTINCT Patient.ID) FROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nJOIN Examination ON Patient.ID = Examination.ID \nWHERE Laboratory.GOT > 40 AND Examination.Diagnosis = 'SLE') as Percentage\nFROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nJOIN Examination ON Patient.ID = Examination.ID \nWHERE Laboratory.GOT > 40 AND Examination.Diagnosis = 'SLE'\t----- bird -----\tthrombosis_prediction",
    "1280": "SELECTCOUNT(*)\nFROM Patient p\nJOIN Laboratory l ON p.ID = l.ID\nWHERE p.SEX = 'Male' AND l.GOT >= 10 AND l.GOT <= 40\t----- bird -----\tthrombosis_prediction",
    "1281": "SELECTMIN(Birthday) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE GPT > 0)\t----- bird -----\tthrombosis_prediction",
    "1282": "SELECTPatient.ID, Patient.Birthday\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.GPT <= 40\nORDER BY Laboratory.GPT DESC\nLIMIT 3\t----- bird -----\tthrombosis_prediction",
    "1283": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (SELECT ID FROM Laboratory WHERE GPT <= 40)\nAND SEX = 'Male'\t----- bird -----\tthrombosis_prediction",
    "1284": "SELECTPatient.ID, Patient.`First Date`\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.LDH = (SELECT MAX(LDH) FROM Laboratory WHERE LDH <= 225)\nORDER BY Patient.`First Date` ASC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1285": "SELECTMAX(Date) \nFROM Laboratory \nWHERE LDH IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1286": "SELECTCOUNT(*)\nFROM Patient\nWHERE ID IN (SELECT ID FROM Laboratory WHERE ALP IS NOT NULL AND ALP <> 0)\nAND Admission IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1287": "SELECTCOUNT(*) \nFROM Laboratory \nWHERE ALP >= 40 AND ALP <= 129\t----- bird -----\tthrombosis_prediction",
    "1288": "SELECTPatient.ID, Patient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.TP < 6.0\t----- bird -----\tthrombosis_prediction",
    "1289": "SELECTCOUNT(*) \nFROM Patient \nWHERE Diagnosis = 'SJS' \nAND ID IN (SELECT ID FROM Laboratory WHERE TP >= 6.4 AND TP <= 8.3)\t----- bird -----\tthrombosis_prediction",
    "1290": "SELECTPatient.`First Date`\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nWHERE Examination.`ALB` = (SELECT MAX(ALB) FROM Laboratory WHERE ALB >= 3.5)\t----- bird -----\tthrombosis_prediction",
    "1291": "SELECTCOUNT(*) \nFROM Patient \nWHERE SEX = 'Male' \nAND ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE ALB >= 3.5 \n     AND TP >= 6.0)\t----- bird -----\tthrombosis_prediction",
    "1292": "SELECT`aCL IgG`, `aCL IgM`, UA\nFROM Examination\nJOIN Patient ON Examination.ID = Patient.ID\nWHERE Patient.SEX = 'Female' AND UA <= 7.0\nORDER BY UA DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1293": "SELECTMAX(`ANA`) \nFROM Examination \nWHERE `aCL IgG` < 1.0 \nAND `aCL IgM` < 1.0 \nAND `aCL IgA` < 1.0 \nAND CRE < 1.0\t----- bird -----\tthrombosis_prediction",
    "1294": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.CRE < 1.0\nORDER BY Examination.`aCL IgG` DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1295": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE `T-BIL` > normal_range \n     AND ID IN \n         (SELECT ID \n          FROM Examination \n          WHERE `ANA Pattern` = 'peripheral'))\t----- bird -----\tthrombosis_prediction",
    "1296": "SELECT`ANA Pattern`\nFROM Examination\nWHERE ID = (\n    SELECT ID\n    FROM Laboratory\n    WHERE `T-BIL` = (\n        SELECT MAX(`T-BIL`)\n        FROM Laboratory\n        WHERE `T-BIL` < 1.2\n    )\n)\t----- bird -----\tthrombosis_prediction",
    "1297": "SELECTCOUNT(*) \nFROM Patient \nJOIN Laboratory ON Patient.ID = Laboratory.ID \nWHERE `T-CHO` > 200 AND APTT < 30\t----- bird -----\tthrombosis_prediction",
    "1298": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE `T-CHO` >= 200 AND `T-CHO` <= 239 \n     AND ID IN \n         (SELECT ID \n          FROM Examination \n          WHERE `ANA Pattern` = 'P'))\t----- bird -----\tthrombosis_prediction",
    "1299": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE TG <= 150 \n     AND ID IN \n         (SELECT ID \n          FROM Examination \n          WHERE Symptoms IS NOT NULL))\t----- bird -----\tthrombosis_prediction",
    "1300": "SELECTPatient.Diagnosis\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.TG <= 150\nORDER BY Laboratory.TG DESC\nLIMIT 1\t----- bird -----\tthrombosis_prediction",
    "1301": "SELECTPatient.ID\nFROM Patient\nJOIN Examination ON Patient.ID = Examination.ID\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Examination.Thrombosis = 0\nAND Laboratory.CPK > 0\t----- bird -----\tthrombosis_prediction",
    "1302": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE CPK <= 200 \n     AND (PT > 12 OR APTT > 30))\t----- bird -----\tthrombosis_prediction",
    "1303": "SELECTMAX(Birthday) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE GLU > 100)\t----- bird -----\tthrombosis_prediction",
    "1304": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID NOT IN \n    (SELECT ID \n     FROM Examination \n     WHERE Symptoms LIKE '%normal blood glucose%' \n     AND Thrombosis = 1)\t----- bird -----\tthrombosis_prediction",
    "1305": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN (SELECT ID FROM Laboratory WHERE WBC >= 4 AND WBC <= 10)\t----- bird -----\tthrombosis_prediction",
    "1306": "SELECTCOUNT(*) \nFROM Patient \nWHERE Diagnosis = 'SLE' \nAND ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE WBC >= 4 AND WBC <= 10)\t----- bird -----\tthrombosis_prediction",
    "1307": "SELECTPatient.ID\nFROM Patient\nJOIN Laboratory ON Patient.ID = Laboratory.ID\nWHERE Laboratory.RBC < 4.2\nAND Patient.Admission = 'Outpatient Clinic'\t----- bird -----\tthrombosis_prediction",
    "1308": "SELECTCOUNT(*) \nFROM Patient \nWHERE ID IN \n    (SELECT ID \n     FROM Laboratory \n     WHERE PLT >= 150) \nAND Symptoms IS NOT NULL\t----- bird -----\tthrombosis_prediction",
    "1309": "SELECTPLT\nFROM Laboratory\nJOIN Patient ON Laboratory.ID = Patient.ID\nWHERE Diagnosis = 'MCTD'\nAND PLT >= 150\nAND PLT <= 450\t----- bird -----\tthrombosis_prediction",
    "1310": "SELECTAVG(PT)\nFROM Laboratory\nWHERE ID IN (SELECT ID FROM Patient WHERE SEX = 'Male')\nAND PT <= 13.5\t----- bird -----\tthrombosis_prediction",
    "1311": "SELECTCOUNT(*) \nFROM Examination \nWHERE Thrombosis = 1 \nAND PT = 'Normal'\t----- bird -----\tthrombosis_prediction",
    "1312": "SELECTmajor.major_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.first_name = 'Angela' AND member.last_name = 'Sanders'\t----- bird -----\tstudent_club",
    "1313": "SELECTCOUNT(*) \nFROM member \nJOIN major ON member.link_to_major = major.major_id \nWHERE major.college = 'College of Engineering'\t----- bird -----\tstudent_club",
    "1314": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN major ma ON m.link_to_major = ma.major_id\nWHERE ma.department = 'Art and Design'\t----- bird -----\tstudent_club",
    "1315": "SELECTCOUNT(*) \nFROM member \nJOIN attendance ON member.member_id = attendance.link_to_member \nJOIN event ON attendance.link_to_event = event.event_id \nWHERE event.event_name = 'Women\\'s Soccer'\t----- bird -----\tstudent_club",
    "1316": "SELECTmember.phone\nFROM member\nJOIN attendance ON member.member_id = attendance.link_to_member\nJOIN event ON attendance.link_to_event = event.event_id\nWHERE event.event_name = \"Women's Soccer\"\t----- bird -----\tstudent_club",
    "1317": "SELECTCOUNT(*) \nFROM member \nJOIN attendance ON member.member_id = attendance.link_to_member \nJOIN event ON attendance.link_to_event = event.event_id \nWHERE event.event_name = 'Women\\'s Soccer' AND member.t_shirt_size = 'Medium'\t----- bird -----\tstudent_club",
    "1318": "SELECTevent.event_id, event.event_name, COUNT(attendance.link_to_member) AS attendance_count\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nGROUP BY event.event_id, event.event_name\nORDER BY attendance_count DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1319": "SELECTmajor.college\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.position = 'Vice President'\t----- bird -----\tstudent_club",
    "1320": "SELECTevent.event_name\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nJOIN member ON attendance.link_to_member = member.member_id\nWHERE member.first_name = 'Maya' AND member.last_name = 'Mclean'\t----- bird -----\tstudent_club",
    "1321": "SELECTCOUNT(*) \nFROM attendance \nJOIN event ON attendance.link_to_event = event.event_id \nJOIN member ON attendance.link_to_member = member.member_id \nWHERE member.first_name = 'Sacha' AND member.last_name = 'Harrison' AND event.event_date LIKE '%2019%'\t----- bird -----\tstudent_club",
    "1322": "SELECTCOUNT(*)\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nGROUP BY event.event_id\nHAVING COUNT(attendance.link_to_member) > 10\nAND event.type = 'meeting'\t----- bird -----\tstudent_club",
    "1323": "SELECTevent_name\nFROM event\nWHERE event_id IN (\n    SELECT link_to_event\n    FROM attendance\n    GROUP BY link_to_event\n    HAVING COUNT(link_to_member) > 20\n)\nAND type != 'fundraiser'\t----- bird -----\tstudent_club",
    "1324": "SELECTAVG(COUNT(link_to_member))\nFROM attendance\nJOIN event ON attendance.link_to_event = event.event_id\nWHERE event.event_date LIKE '%2020%'\t----- bird -----\tstudent_club",
    "1325": "SELECTMAX(cost) AS most_expensive_item\nFROM expense\t----- bird -----\tstudent_club",
    "1326": "SELECTCOUNT(*) \nFROM member \nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Environmental Engineering')\t----- bird -----\tstudent_club",
    "1327": "SELECTmember.first_name, member.last_name\nFROM member\nJOIN attendance ON member.member_id = attendance.link_to_member\nJOIN event ON attendance.link_to_event = event.event_id\nWHERE event.event_name = \"Laugh Out Loud\"\t----- bird -----\tstudent_club",
    "1328": "SELECTm.last_name\nFROM member m\nJOIN major ma ON m.link_to_major = ma.major_id\nWHERE ma.major_name = 'Law and Constitutional Studies'\t----- bird -----\tstudent_club",
    "1329": "SELECTzip_code.county\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Sherri' AND member.last_name = 'Ramsey'\t----- bird -----\tstudent_club",
    "1330": "SELECTcollege\nFROM major\nWHERE major_name = 'Tyler Hewitt'\t----- bird -----\tstudent_club",
    "1331": "SELECTSUM(amount) \nFROM income \nWHERE link_to_member = (SELECT member_id FROM member WHERE position = 'Vice President')\t----- bird -----\tstudent_club",
    "1332": "SELECTSUM(cost)\nFROM expense\nJOIN budget ON expense.link_to_budget = budget.budget_id\nJOIN event ON budget.link_to_event = event.event_id\nWHERE event.event_name = 'September Meeting'\nAND budget.category = 'Food'\t----- bird -----\tstudent_club",
    "1333": "SELECTzip_code.city, zip_code.state\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.position = 'President'\t----- bird -----\tstudent_club",
    "1334": "SELECTm.first_name || ' ' || m.last_name AS full_name\nFROM member m\nJOIN zip_code z ON m.zip = z.zip_code\nWHERE z.state = 'Illinois'\t----- bird -----\tstudent_club",
    "1335": "SELECTSUM(cost) \nFROM expense \nWHERE expense_date = 'September Meeting' \nAND expense_description = 'advertisement' \nAND link_to_member IN (SELECT member_id FROM member WHERE position = 'Student_Club')\t----- bird -----\tstudent_club",
    "1336": "SELECTdepartment\nFROM major\nWHERE major_name = 'Pierce' OR major_name = 'Guidi'\t----- bird -----\tstudent_club",
    "1337": "SELECTSUM(amount) AS total_budgeted_amount\nFROM budget\nWHERE event_status = 'October Speaker'\t----- bird -----\tstudent_club",
    "1338": "SELECTexpense_id, approved\nFROM expense\nWHERE expense_date = 'October 8, 2019' \nAND link_to_budget = (SELECT budget_id FROM budget WHERE event_status = 'October Meeting') \nAND approved = 'Yes'\t----- bird -----\tstudent_club",
    "1339": "SELECTAVG(cost)\nFROM expense\nWHERE link_to_member = (SELECT member_id FROM member WHERE first_name = 'Elijah' AND last_name = 'Allen')\nAND expense_date BETWEEN '2022-09-01' AND '2022-10-31'\t----- bird -----\tstudent_club",
    "1340": "SELECTSUM(spent) AS total_spent_2019\nFROM budget\nWHERE event_status = 'completed' AND event_date LIKE '%2019';\t----- bird -----\tstudent_club",
    "1341": "SELECTevent.location\nFROM event\nWHERE event.event_name = \"Spring Budget Review\"\t----- bird -----\tstudent_club",
    "1342": "SELECTcost\nFROM expense\nWHERE expense_description = 'Posters' AND expense_date = '2019/9/4'\t----- bird -----\tstudent_club",
    "1343": "SELECTremaining\nFROM budget\nWHERE category = 'Food'\nORDER BY amount DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1344": "SELECTnotes\nFROM event\nWHERE event_date = '2019/9/14'\nAND type = 'fundraising'\t----- bird -----\tstudent_club",
    "1345": "SELECTCOUNT(*)\nFROM major\nWHERE college = 'College of Humanities and Social Sciences'\t----- bird -----\tstudent_club",
    "1346": "SELECTphone\nFROM member\nWHERE first_name = 'Carlo' AND last_name = 'Jacobs'\t----- bird -----\tstudent_club",
    "1347": "SELECTzip_code.county\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Adela' AND member.last_name = 'O'Gallagher'\t----- bird -----\tstudent_club",
    "1348": "SELECTCOUNT(*)\nFROM budget\nWHERE event_status = 'November Meeting' AND spent > amount\t----- bird -----\tstudent_club",
    "1349": "SELECTSUM(amount) \nFROM budget \nWHERE link_to_event = 'September Speaker'\t----- bird -----\tstudent_club",
    "1350": "SELECTstatus\nFROM event\nWHERE event_name = 'Post Cards, Posters'\nAND event_date = '2019/8/20'\t----- bird -----\tstudent_club",
    "1351": "SELECTmajor_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE first_name = 'Brent' AND last_name = 'Thomason'\t----- bird -----\tstudent_club",
    "1352": "SELECTCOUNT(*)\nFROM member\nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Business')\nAND t_shirt_size = 'Medium'\t----- bird -----\tstudent_club",
    "1353": "SELECTzip_code.type\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Christof' AND member.last_name = 'Nielson'\t----- bird -----\tstudent_club",
    "1354": "SELECTmajor.major_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.position = 'Vice President'\t----- bird -----\tstudent_club",
    "1355": "SELECTzip_code.state\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Sacha' AND member.last_name = 'Harrison'\t----- bird -----\tstudent_club",
    "1356": "SELECTdepartment\nFROM major\nWHERE major_id = (SELECT link_to_major FROM member WHERE position = 'President')\t----- bird -----\tstudent_club",
    "1357": "SELECTincome.date_received\nFROM income\nJOIN member ON income.link_to_member = member.member_id\nWHERE member.first_name = 'Connor' AND member.last_name = 'Hilton'\t----- bird -----\tstudent_club",
    "1358": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN income i ON m.member_id = i.link_to_member\nORDER BY i.date_received\nLIMIT 1\t----- bird -----\tstudent_club",
    "1359": "SELECTCOUNT(*) \nFROM budget \nWHERE category = 'Advertisement' \nAND event_status = 'Yearly Kickoff' \nAND amount > (SELECT amount FROM budget WHERE category = 'Advertisement' AND event_status = 'October Meeting')\t----- bird -----\tstudent_club",
    "1360": "SELECT(b.spent / b.amount) * 100 AS percentage\nFROM budget b\nJOIN event e ON b.link_to_event = e.event_id\nWHERE e.event_name = \"November Speaker\"\nAND b.category = \"Parking\"\t----- bird -----\tstudent_club",
    "1361": "SELECTSUM(cost)\nFROM expense\nWHERE expense_description LIKE '%pizza%'\t----- bird -----\tstudent_club",
    "1362": "SELECTCOUNT(DISTINCT city) \nFROM zip_code \nWHERE county = 'Orange' AND state = 'Virginia'\t----- bird -----\tstudent_club",
    "1363": "SELECTdepartment\nFROM major\nWHERE college = 'College of Humanities and Social Sciences'\t----- bird -----\tstudent_club",
    "1364": "SELECTzip_code.city\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Amy' AND member.last_name = 'Firth'\t----- bird -----\tstudent_club",
    "1365": "SELECTexpense_id, expense_description, cost\nFROM expense\nWHERE link_to_budget = (\n    SELECT budget_id\n    FROM budget\n    ORDER BY remaining\n    LIMIT 1\n)\t----- bird -----\tstudent_club",
    "1366": "SELECTmember.first_name, member.last_name\nFROM member\nJOIN attendance ON member.member_id = attendance.link_to_member\nJOIN event ON attendance.link_to_event = event.event_id\nWHERE event.event_name = \"October Meeting\"\t----- bird -----\tstudent_club",
    "1367": "SELECTmajor.college, COUNT(member.member_id) AS total_members\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nGROUP BY major.college\nORDER BY total_members DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1368": "SELECTmajor.major_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.phone = '809-555-3360'\t----- bird -----\tstudent_club",
    "1369": "SELECTevent_id, event_name, MAX(amount) AS highest_budget_amount\nFROM budget\nJOIN event ON budget.link_to_event = event.event_id\t----- bird -----\tstudent_club",
    "1370": "SELECTexpense_id, expense_description, expense_date, cost, approved\nFROM expense\nWHERE link_to_member IN (SELECT member_id FROM member WHERE position = 'Vice President')\t----- bird -----\tstudent_club",
    "1371": "SELECTCOUNT(*) \nFROM attendance \nWHERE link_to_event = (SELECT event_id FROM event WHERE event_name = 'Women\\'s Soccer')\t----- bird -----\tstudent_club",
    "1372": "SELECTincome.date_received\nFROM member\nJOIN income ON member.member_id = income.link_to_member\nWHERE member.first_name = 'Casey' AND member.last_name = 'Mason'\t----- bird -----\tstudent_club",
    "1373": "SELECTCOUNT(*) \nFROM member \nJOIN zip_code ON member.zip = zip_code.zip_code \nWHERE zip_code.state = 'Maryland'\t----- bird -----\tstudent_club",
    "1374": "SELECTCOUNT(*) \nFROM attendance \nWHERE link_to_member = (SELECT member_id FROM member WHERE phone = '954-555-6240')\t----- bird -----\tstudent_club",
    "1375": "SELECTmember_id, first_name, last_name\nFROM member\nWHERE link_to_major IN (SELECT major_id FROM major WHERE department = 'School of Applied Sciences, Technology and Education')\t----- bird -----\tstudent_club",
    "1376": "SELECTevent_id, event_name, (spent/amount) as spend_to_budget_ratio\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nWHERE event.status = 'closed'\nORDER BY spend_to_budget_ratio DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1377": "SELECTCOUNT(*)\nFROM member\nWHERE position = 'president'\t----- bird -----\tstudent_club",
    "1378": "SELECTMAX(spent) \nFROM budget\t----- bird -----\tstudent_club",
    "1379": "SELECTCOUNT(*)\nFROM event\nWHERE event_date LIKE '%2020%'\t----- bird -----\tstudent_club",
    "1380": "SELECTSUM(cost) \nFROM expense \nWHERE expense_description LIKE '%food%'\t----- bird -----\tstudent_club",
    "1381": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN attendance a ON m.member_id = a.link_to_member\nGROUP BY m.member_id\nHAVING COUNT(a.link_to_event) > 7\t----- bird -----\tstudent_club",
    "1382": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN major ma ON m.link_to_major = ma.major_id\nJOIN attendance a ON m.member_id = a.link_to_member\nJOIN event e ON a.link_to_event = e.event_id\nWHERE ma.major_name = 'Interior Design'\nAND e.event_name = 'Community Theater'\t----- bird -----\tstudent_club",
    "1383": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN zip_code z ON m.zip = z.zip_code\nWHERE z.city = 'Georgetown' AND z.state = 'South Carolina'\t----- bird -----\tstudent_club",
    "1384": "SELECTCOUNT(*) \nFROM income \nWHERE link_to_member = (SELECT member_id FROM member WHERE first_name = 'Grant' AND last_name = 'Gilmour')\t----- bird -----\tstudent_club",
    "1385": "SELECTm.first_name, m.last_name\nFROM member m\nJOIN income i ON m.member_id = i.link_to_member\nWHERE i.amount > 40\t----- bird -----\tstudent_club",
    "1386": "SELECTSUM(cost) AS total_expense\nFROM expense\nWHERE link_to_budget IN (SELECT budget_id FROM budget WHERE link_to_event = 'Yearly Kickoff')\t----- bird -----\tstudent_club",
    "1387": "SELECTmember.first_name, member.last_name\nFROM member\nJOIN budget ON member.member_id = budget.link_to_event\nJOIN event ON budget.link_to_event = event.event_id\nWHERE event.event_name = 'Yearly Kickoff'\t----- bird -----\tstudent_club",
    "1388": "SELECTm.first_name || ' ' || m.last_name AS full_name, i.source\nFROM member m\nJOIN income i ON m.member_id = i.link_to_member\nORDER BY i.amount DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1389": "SELECTevent_id, event_name, MIN(cost) AS lowest_cost\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nJOIN expense ON budget.budget_id = expense.link_to_budget\nGROUP BY event_id\nORDER BY lowest_cost ASC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1390": "SELECTSUM(cost) as total_cost\nFROM expense\nWHERE link_to_budget IN (SELECT budget_id FROM budget WHERE event_status = 'Yearly Kickoff')\t----- bird -----\tstudent_club",
    "1391": "SELECT\n    (SELECT COUNT(*) FROM member WHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Finance')) /\n    (SELECT COUNT(*) FROM member WHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Physics')) as ratio_students\t----- bird -----\tstudent_club",
    "1392": "SELECTincome.source, SUM(income.amount) AS total_amount\nFROM income\nWHERE strftime('%Y-%m', income.date_received) = '2019-09'\nGROUP BY income.source\nORDER BY total_amount DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1393": "SELECTmember.first_name || ' ' || member.last_name AS full_name, member.email AS email_address\nFROM member\nWHERE member.position = 'Secretary'\t----- bird -----\tstudent_club",
    "1394": "SELECTCOUNT(*) \nFROM member \nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Physics Teaching')\t----- bird -----\tstudent_club",
    "1395": "SELECTCOUNT(*) \nFROM attendance \nWHERE link_to_event = 'Community Theater' \nAND link_to_member IN \n    (SELECT member_id \n     FROM member \n     WHERE member_id IN \n         (SELECT link_to_member \n          FROM attendance \n          WHERE link_to_event = 'Community Theater' \n          AND link_to_event IN \n              (SELECT event_id \n               FROM event \n               WHERE event_name = 'Community Theater' \n               AND event_date LIKE '%2019%')))\t----- bird -----\tstudent_club",
    "1396": "SELECTCOUNT(*) AS events_attended, major_name\nFROM member\nJOIN attendance ON member.member_id = attendance.link_to_member\nJOIN event ON attendance.link_to_event = event.event_id\nJOIN major ON member.link_to_major = major.major_id\nWHERE first_name = 'Luisa' AND last_name = 'Guidi'\t----- bird -----\tstudent_club",
    "1397": "SELECTAVG(cost)\nFROM expense\nWHERE expense_description = 'food'\t----- bird -----\tstudent_club",
    "1398": "SELECTevent_name\nFROM event\nWHERE event_id = (\n    SELECT link_to_event\n    FROM budget\n    WHERE category = 'advertisement'\n    ORDER BY spent DESC\n    LIMIT 1\n)\t----- bird -----\tstudent_club",
    "1399": "SELECT* \nFROM member \nJOIN attendance ON member.member_id = attendance.link_to_member \nJOIN event ON attendance.link_to_event = event.event_id \nWHERE member.first_name = 'Maya' AND member.last_name = 'Mclean' AND event.event_name = 'Women\\'s Soccer'\t----- bird -----\tstudent_club",
    "1400": "SELECT\n    COUNT(*) * 100.0 / (SELECT COUNT(*) FROM event WHERE event_date LIKE '%2019%' ) AS percentage\nFROM event\nWHERE type = 'Community Service' AND event_date LIKE '%2019%'\t----- bird -----\tstudent_club",
    "1401": "SELECTcost\nFROM expense\nWHERE expense_description = 'Posters'\nAND link_to_budget = (\n    SELECT budget_id\n    FROM budget\n    WHERE link_to_event = 'September Speaker'\n)\t----- bird -----\tstudent_club",
    "1402": "SELECTt_shirt_size, COUNT(*) AS count\nFROM member\nGROUP BY t_shirt_size\nORDER BY count DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1403": "SELECTevent.event_name\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nJOIN expense ON budget.budget_id = expense.link_to_budget\nWHERE budget.event_status = 'Closed'\nORDER BY (expense.cost - budget.amount) DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1404": "SELECTexpense.expense_description, SUM(expense.cost) as total_approved_value\nFROM expense\nJOIN budget ON expense.link_to_budget = budget.budget_id\nJOIN event ON budget.link_to_event = event.event_id\nWHERE event.event_name = 'October Meeting' AND expense.approved = 'Yes'\nGROUP BY expense.expense_description\t----- bird -----\tstudent_club",
    "1405": "SELECTSUM(amount) AS total_budget\nFROM budget\nWHERE event_status = 'April Speaker';\t----- bird -----\tstudent_club",
    "1406": "SELECT* \nFROM budget\nWHERE category = 'Food'\nORDER BY amount DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1407": "SELECTcategory, amount\nFROM budget\nWHERE category = 'Advertising'\nORDER BY amount DESC\nLIMIT 3\t----- bird -----\tstudent_club",
    "1408": "SELECTSUM(cost) AS total_cost_spent\nFROM expense\nWHERE expense_description LIKE '%Parking%'\t----- bird -----\tstudent_club",
    "1409": "SELECTSUM(cost) \nFROM expense \nWHERE expense_date = '8/20/2019'\t----- bird -----\tstudent_club",
    "1410": "SELECTm.first_name || ' ' || m.last_name AS full_name, SUM(e.cost) AS total_cost\nFROM member m\nJOIN expense e ON m.member_id = e.link_to_member\nWHERE m.member_id = 'rec4BLdZHS2Blfp4v'\nGROUP BY m.first_name, m.last_name\t----- bird -----\tstudent_club",
    "1411": "SELECT expense_description\nFROM expense\nWHERE link_to_member = 'Sacha Harrison'\t----- bird -----\tstudent_club",
    "1412": "SELECTexpense.expense_description\nFROM member\nJOIN expense ON member.member_id = expense.link_to_member\nWHERE member.t_shirt_size = 'X-Large'\t----- bird -----\tstudent_club",
    "1413": "SELECTzip\nFROM member\nWHERE member_id IN (\n    SELECT link_to_member\n    FROM expense\n    WHERE cost < 50\n)\t----- bird -----\tstudent_club",
    "1414": "SELECTmajor.major_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.first_name = 'Phillip' AND member.last_name = 'Cullen'\t----- bird -----\tstudent_club",
    "1415": "SELECTposition\nFROM member\nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Business')\t----- bird -----\tstudent_club",
    "1416": "SELECTCOUNT(*) \nFROM member \nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Business') \nAND t_shirt_size = 'Medium'\t----- bird -----\tstudent_club",
    "1417": "SELECTevent_name, type\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nWHERE budget.remaining > 30\t----- bird -----\tstudent_club",
    "1418": "SELECTevent_name, type\nFROM event\nWHERE location = 'MU 215'\t----- bird -----\tstudent_club",
    "1419": "SELECTtype\nFROM event\nWHERE event_date = '2020-03-24T12:00:00'\t----- bird -----\tstudent_club",
    "1420": "SELECTmajor_name\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.position = 'Vice President'\t----- bird -----\tstudent_club",
    "1421": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM member) \nFROM member \nWHERE link_to_major = (SELECT major_id FROM major WHERE major_name = 'Business')\t----- bird -----\tstudent_club",
    "1422": "SELECTevent_name\nFROM event\nWHERE location = 'MU 215'\t----- bird -----\tstudent_club",
    "1423": "SELECTCOUNT(*)\nFROM income\nWHERE amount = 50\t----- bird -----\tstudent_club",
    "1424": "SELECTCOUNT(*)\nFROM member\nWHERE t_shirt_size = 'Extra Large'\t----- bird -----\tstudent_club",
    "1425": "SELECTCOUNT(major_id)\nFROM major\nWHERE college = 'College of Agriculture and Applied Sciences'\nAND department = 'School of Applied Sciences, Technology and Education'\t----- bird -----\tstudent_club",
    "1426": "SELECTmember.last_name, major.department, major.college\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE major.major_name = 'Environmental Engineering'\t----- bird -----\tstudent_club",
    "1427": "SELECTbudget.category\nFROM budget\nJOIN event ON budget.link_to_event = event.event_id\nWHERE event.location = 'MU 215' AND event.type = 'guest speaker' AND budget.spent = 0\t----- bird -----\tstudent_club",
    "1428": "SELECTzip_code.city, zip_code.state\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE major.department = 'electrical and computer engineering'\t----- bird -----\tstudent_club",
    "1429": "SELECTevent.event_name\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nJOIN member ON attendance.link_to_member = member.member_id\nJOIN major ON member.link_to_major = major.major_id\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.position = 'Vice President'\nAND major.major_name = 'Student_Club'\nAND zip_code.city = '900 E. Washington St.'\t----- bird -----\tstudent_club",
    "1430": "SELECTm.last_name, m.position\nFROM member m\nJOIN expense e ON m.member_id = e.link_to_member\nWHERE e.expense_description = 'pizza' AND e.expense_date = '09/10/2019'\t----- bird -----\tstudent_club",
    "1431": "SELECTmember.last_name\nFROM member\nJOIN attendance ON member.member_id = attendance.link_to_member\nJOIN event ON attendance.link_to_event = event.event_id\nWHERE event.event_name = 'women's soccer'\t----- bird -----\tstudent_club",
    "1432": "SELECT\n    (SELECT COUNT(*) \n     FROM member \n     WHERE t_shirt_size = 'medium') * 50 / \n    (SELECT SUM(amount) \n     FROM income \n     WHERE source = 'Student_Club') * 100 as percentage_amount_received\t----- bird -----\tstudent_club",
    "1433": "SELECTDISTINCT state\nFROM zip_code\nWHERE type = 'PO Box'\t----- bird -----\tstudent_club",
    "1434": "SELECTzip_code\nFROM zip_code\nWHERE type = 'PO BOX'\nAND city = 'San Juan'\nAND county = 'San Juan Municipio'\nAND state = 'Puerto Rico'\t----- bird -----\tstudent_club",
    "1435": "SELECTevent_name\nFROM event\nWHERE type = 'game'\nAND event_date BETWEEN '3/15/2019' AND '3/20/2020'\nAND status = 'closed'\t----- bird -----\tstudent_club",
    "1436": "SELECTevent.event_id, event.event_name, event.event_date, event.type, event.notes, event.location, event.status\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nJOIN member ON attendance.link_to_member = member.member_id\nJOIN income ON member.member_id = income.link_to_member\nWHERE income.amount > 50\t----- bird -----\tstudent_club",
    "1437": "SELECTm.first_name, m.last_name, e.event_id\nFROM member m\nJOIN attendance a ON m.member_id = a.link_to_member\nJOIN event e ON a.link_to_event = e.event_id\nJOIN expense ex ON m.member_id = ex.link_to_member\nWHERE ex.approved = 'Yes'\nAND ex.expense_date BETWEEN '1/10/2019' AND '11/19/2019'\t----- bird -----\tstudent_club",
    "1438": "SELECTmajor.college\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.first_name = 'Katy' AND member.link_to_major = 'rec1N0upiVLy5esTO'\t----- bird -----\tstudent_club",
    "1439": "SELECTphone\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE major.major_name = 'Business' AND major.college = 'College of Agriculture and Applied Sciences'\t----- bird -----\tstudent_club",
    "1440": "SELECTm.email\nFROM member m\nJOIN income i ON m.member_id = i.link_to_member\nWHERE i.amount > 20\nAND i.date_received BETWEEN '2019-09-10' AND '2019-11-19'\t----- bird -----\tstudent_club",
    "1441": "SELECTCOUNT(*) \nFROM member \nWHERE link_to_major IN (SELECT major_id FROM major WHERE major_name = 'Education' AND college = 'College of Education & Human Services')\t----- bird -----\tstudent_club",
    "1442": "SELECT\n    (COUNT(*) FILTER (WHERE spent > amount) * 100.0 / COUNT(*)) AS percentage_over_budget\nFROM budget\t----- bird -----\tstudent_club",
    "1443": "SELECTevent_id, location, status\nFROM event\nWHERE event_date BETWEEN '2019-11-01' AND '2020-03-31'\t----- bird -----\tstudent_club",
    "1444": "SELECTexpense_id, expense_description, cost\nFROM expense\nWHERE cost > 50\t----- bird -----\tstudent_club",
    "1445": "SELECTfirst_name || ' ' || last_name AS full_name\nFROM member\nWHERE t_shirt_size = 'extra large'\t----- bird -----\tstudent_club",
    "1446": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM zip_code) AS percentage_of_po_boxes\nFROM zip_code\nWHERE type = 'PO Box'\t----- bird -----\tstudent_club",
    "1447": "SELECTevent_name, location\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nWHERE budget.spent < budget.amount\t----- bird -----\tstudent_club",
    "1448": "SELECTevent_name, event_date\nFROM event\nWHERE event_id IN (\n    SELECT link_to_event\n    FROM expense\n    WHERE expense_description = 'pizza'\n    AND cost > 50\n    AND cost < 100\n)\t----- bird -----\tstudent_club",
    "1449": "SELECTm.first_name, m.last_name, ma.major_name\nFROM member m\nJOIN expense e ON m.member_id = e.link_to_member\nJOIN budget b ON e.link_to_budget = b.budget_id\nJOIN major ma ON m.link_to_major = ma.major_id\nWHERE e.cost > 100\t----- bird -----\tstudent_club",
    "1450": "SELECTzip_code.city, zip_code.county\nFROM event\nJOIN attendance ON event.event_id = attendance.link_to_event\nJOIN income ON attendance.link_to_member = income.link_to_member\nJOIN zip_code ON event.location = zip_code.zip_code\nGROUP BY event.event_id\nHAVING COUNT(income.income_id) > 40\t----- bird -----\tstudent_club",
    "1451": "SELECTm.first_name, m.last_name, SUM(e.cost) AS total_cost\nFROM member m\nJOIN expense ex ON m.member_id = ex.link_to_member\nGROUP BY m.member_id\nHAVING COUNT(DISTINCT ex.link_to_event) > 1\nORDER BY total_cost DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1452": "SELECTAVG(amount)\nFROM income\nWHERE link_to_member IN (SELECT member_id FROM member WHERE position != 'member')\t----- bird -----\tstudent_club",
    "1453": "SELECTevent_name\nFROM event\nWHERE event_id IN (\n    SELECT link_to_event\n    FROM budget\n    WHERE category = 'Parking'\n    GROUP BY link_to_event\n    HAVING SUM(amount) < (SELECT AVG(amount) FROM budget WHERE category = 'Parking')\n)\t----- bird -----\tstudent_club",
    "1454": "SELECTSUM(cost) as total_cost, \n       SUM(amount) as total_budget_amount,\n       (SUM(cost) / SUM(amount)) * 100 as percentage_cost\nFROM expense\nJOIN budget ON expense.link_to_budget = budget.budget_id\nWHERE budget.event_status = 'meeting'\t----- bird -----\tstudent_club",
    "1455": "SELECTbudget_id\nFROM budget\nWHERE category = 'water, chips, and cookies'\nORDER BY amount DESC\nLIMIT 1\t----- bird -----\tstudent_club",
    "1456": "SELECTm.first_name || ' ' || m.last_name AS full_name, SUM(e.cost) AS total_spent\nFROM member m\nJOIN expense ex ON m.member_id = ex.link_to_member\nGROUP BY m.member_id\nORDER BY total_spent DESC\nLIMIT 5\t----- bird -----\tstudent_club",
    "1457": "SELECTm.first_name || ' ' || m.last_name AS full_name, m.phone\nFROM member m\nJOIN expense e ON m.member_id = e.link_to_member\nWHERE e.cost > (SELECT AVG(cost) FROM expense)\nORDER BY e.cost DESC\t----- bird -----\tstudent_club",
    "1458": "SELECT\n    (SELECT COUNT(*) FROM member WHERE zip IN (SELECT zip_code FROM zip_code WHERE state = 'NJ')) -\n    (SELECT COUNT(*) FROM member WHERE zip IN (SELECT zip_code FROM zip_code WHERE state = 'VT'))\n    AS percentage_difference\t----- bird -----\tstudent_club",
    "1459": "SELECTmajor_name, department\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE first_name = 'Garrett' AND last_name = 'Gerke'\t----- bird -----\tstudent_club",
    "1460": "SELECTm.first_name || ' ' || m.last_name AS full_name, e.cost\nFROM member m\nJOIN expense ex ON m.member_id = ex.link_to_member\nJOIN budget b ON ex.link_to_budget = b.budget_id\nWHERE ex.expense_description IN ('water', 'veggie tray', 'supplies')\t----- bird -----\tstudent_club",
    "1461": "SELECTmember.last_name, member.phone\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE major.major_name = 'Elementary Education'\t----- bird -----\tstudent_club",
    "1462": "SELECTcategory, amount\nFROM budget\nWHERE link_to_event = 'January Speaker'\t----- bird -----\tstudent_club",
    "1463": "SELECTevent_name\nFROM event\nWHERE event_id IN (SELECT link_to_event FROM budget WHERE category = 'food')\t----- bird -----\tstudent_club",
    "1464": "SELECTm.first_name || ' ' || m.last_name AS full_name, i.amount\nFROM member m\nJOIN income i ON m.member_id = i.link_to_member\nWHERE i.date_received = '9/9/2019'\t----- bird -----\tstudent_club",
    "1465": "SELECTbudget.category\nFROM budget\nJOIN expense ON budget.budget_id = expense.link_to_budget\nWHERE expense.expense_description = 'Posters'\t----- bird -----\tstudent_club",
    "1466": "SELECTmember.first_name || ' ' || member.last_name AS full_name, member.position, major.college\nFROM member\nJOIN major ON member.link_to_major = major.major_id\nWHERE member.position = 'Secretary'\t----- bird -----\tstudent_club",
    "1467": "SELECTevent.event_name, SUM(expense.cost) AS total_spent\nFROM event\nJOIN budget ON event.event_id = budget.link_to_event\nJOIN expense ON budget.budget_id = expense.link_to_budget\nWHERE budget.category = 'speaker gifts'\nGROUP BY event.event_name\t----- bird -----\tstudent_club",
    "1468": "SELECTzip_code.city\nFROM member\nJOIN zip_code ON member.zip = zip_code.zip_code\nWHERE member.first_name = 'Garrett' AND member.last_name = 'Gerke'\t----- bird -----\tstudent_club",
    "1469": "SELECTm.first_name, m.last_name, m.position\nFROM member m\nJOIN zip_code z ON m.zip = z.zip_code\nWHERE z.city = 'Lincolnton' AND z.state = 'North Carolina' AND z.zip_code = 28092\t----- bird -----\tstudent_club",
    "1470": "SELECTCOUNT(*)\nFROM gasstations\nWHERE Country = 'CZE' AND Segment = 'Premium'\t----- bird -----\tdebit_card_specializing",
    "1471": "SELECT\n    Currency,\n    COUNT(CustomerID) AS CustomerCount\nFROM customers\nGROUP BY Currency\t----- bird -----\tdebit_card_specializing",
    "1472": "SELECTcustomers.CustomerID, customers.Segment, SUM(yearmonth.Consumption) AS TotalConsumption\nFROM customers\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nWHERE yearmonth.Date LIKE '2012%' AND customers.Segment = 'LAM'\nGROUP BY customers.CustomerID\nORDER BY TotalConsumption\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1473": "SELECTcustomers.CustomerID, customers.Segment, yearmonth.Date, AVG(yearmonth.Consumption) AS AvgMonthlyConsumption\nFROM customers\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nWHERE customers.Segment = 'SME' AND yearmonth.Date LIKE '2013%'\nGROUP BY customers.CustomerID, customers.Segment, yearmonth.Date\t----- bird -----\tdebit_card_specializing",
    "1474": "SELECTcustomers.CustomerID, customers.Segment, customers.Currency, SUM(transactions_1k.Amount) AS TotalConsumption\nFROM customers\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nJOIN gasstations ON transactions_1k.GasStationID = gasstations.GasStationID\nWHERE customers.Currency = 'CZK' AND strftime('%Y', transactions_1k.Date) = '2011'\nGROUP BY customers.CustomerID\nORDER BY TotalConsumption DESC\t----- bird -----\tdebit_card_specializing",
    "1475": "SELECTCOUNT(CustomerID)\nFROM yearmonth\nWHERE Date LIKE '2012%'\nAND Consumption < 30000\t----- bird -----\tdebit_card_specializing",
    "1476": "SELECTc.Currency, SUM(y.Consumption) AS Total_Consumption\nFROM customers c\nJOIN yearmonth y ON c.CustomerID = y.CustomerID\nWHERE y.Date LIKE '2012%'\nGROUP BY c.Currency\t----- bird -----\tdebit_card_specializing",
    "1477": "SELECTstrftime('%Y', Date) AS Year, SUM(Amount * Price) AS Total_EUR\nFROM transactions_1k\nJOIN products ON transactions_1k.ProductID = products.ProductID\nWHERE products.Description = 'Gas'\nGROUP BY Year\nORDER BY Total_EUR DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1478": "SELECTSegment, SUM(Consumption) AS TotalConsumption\nFROM yearmonth\nJOIN customers ON yearmonth.CustomerID = customers.CustomerID\nGROUP BY Segment\nORDER BY TotalConsumption\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1479": "SELECTstrftime('%Y', Date) AS Year, SUM(Amount) AS TotalConsumption\nFROM transactions_1k\nJOIN products ON transactions_1k.ProductID = products.ProductID\nJOIN customers ON transactions_1k.CustomerID = customers.CustomerID\nJOIN gasstations ON transactions_1k.GasStationID = gasstations.GasStationID\nWHERE Currency = 'CZK'\nGROUP BY Year\nORDER BY TotalConsumption DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1480": "SELECTDate, SUM(Consumption) AS Total_Consumption\nFROM yearmonth\nWHERE Date LIKE '2013%'\nAND CustomerID IN (SELECT CustomerID FROM customers WHERE Segment = 'SME')\nGROUP BY Date\nORDER BY Total_Consumption DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1481": "SELECTc1.CustomerID,\n       AVG(c1.Consumption) as Avg_Consumption,\n       c1.Currency\nFROM yearmonth c1\nJOIN customers c2 ON c1.CustomerID = c2.CustomerID\nWHERE c1.Date LIKE '2013%'\nAND c1.Currency = 'CZK'\nGROUP BY c1.CustomerID\nORDER BY Avg_Consumption\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1482": "SELECTSegment,\n       (SUM(CASE WHEN strftime('%Y', Date) = '2013' THEN Consumption ELSE 0 END) - \n        SUM(CASE WHEN strftime('%Y', Date) = '2012' THEN Consumption ELSE 0 END) ) / \n       SUM(CASE WHEN strftime('%Y', Date) = '2012' THEN Consumption ELSE 0 END) * 100 AS PercentageIncrease\nFROM yearmonth\nJOIN customers ON yearmonth.CustomerID = customers.CustomerID\nWHERE Currency = 'EUR'\nGROUP BY Segment\nORDER BY PercentageIncrease DESC\t----- bird -----\tdebit_card_specializing",
    "1483": "SELECTSUM(Consumption) \nFROM yearmonth \nWHERE CustomerID = 6 \nAND Date BETWEEN '2013-08-01' AND '2013-11-30'\t----- bird -----\tdebit_card_specializing",
    "1484": "SELECTCOUNT(*) \nFROM gasstations \nWHERE Country = 'Czech Republic' AND Segment = 'discount'\t----- bird -----\tdebit_card_specializing",
    "1485": "SELECTSUM(y1.Consumption) - SUM(y2.Consumption) AS Consumption_Difference\nFROM yearmonth y1\nJOIN yearmonth y2 ON y1.CustomerID = 7 AND y2.CustomerID = 5\nWHERE y1.Date = '2013-04' AND y2.Date = '2013-04'\t----- bird -----\tdebit_card_specializing",
    "1486": "SELECTCOUNT(CustomerID) AS Count_Czech_Koruna, \n       Currency\nFROM customers\nWHERE Currency = 'Czech koruna'\nGROUP BY Currency\t----- bird -----\tdebit_card_specializing",
    "1487": "SELECTcustomers.CustomerID, customers.Currency, yearmonth.Consumption\nFROM customers\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nWHERE customers.Currency = 'Euro' AND yearmonth.Date = '2013-10'\nORDER BY yearmonth.Consumption DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1488": "SELECTcustomers.CustomerID, customers.Segment, SUM(yearmonth.Consumption) AS TotalConsumption\nFROM customers\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nGROUP BY customers.CustomerID\nORDER BY TotalConsumption DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1489": "SELECTSUM(Consumption) \nFROM yearmonth \nWHERE Date LIKE '2013-05%' \nAND CustomerID IN (SELECT CustomerID FROM customers WHERE Segment = 'KAM')\t----- bird -----\tdebit_card_specializing",
    "1490": "SELECTCOUNT(*) * 100.0 / (SELECT COUNT(*) FROM yearmonth WHERE CustomerID = (SELECT CustomerID FROM customers WHERE Segment = 'LAM') AND Consumption > 46.73) FROM yearmonth WHERE CustomerID = (SELECT CustomerID FROM customers WHERE Segment = 'LAM') AND Consumption > 46.73\t----- bird -----\tdebit_card_specializing",
    "1491": "SELECTCountry, COUNT(GasStationID) AS TotalValueForMoneyGasStations\nFROM gasstations\nWHERE Segment = 'value for money'\nGROUP BY Country\t----- bird -----\tdebit_card_specializing",
    "1492": "SELECTCOUNT(CustomerID) * 100.0 / (SELECT COUNT(CustomerID) FROM customers WHERE Currency = 'EUR') \nFROM customers \nWHERE Segment = 'KAM' AND Currency = 'EUR'\t----- bird -----\tdebit_card_specializing",
    "1493": "SELECTCOUNT(CustomerID) as TotalCustomers,\n       COUNT(CASE WHEN Consumption > 528.3 THEN CustomerID END) as CustomersAboveThreshold\nFROM yearmonth\nWHERE Date LIKE '2012-02%'\t----- bird -----\tdebit_card_specializing",
    "1494": "SELECTROUND(CAST(COUNT(*) AS REAL) / (SELECT COUNT(*) FROM gasstations WHERE Country = 'Slovakia') * 100, 2) AS PremiumGasStationsPercentage\nFROM gasstations\nWHERE Country = 'Slovakia'\nAND Segment = 'Premium'\t----- bird -----\tdebit_card_specializing",
    "1495": "SELECTCustomerID\nFROM yearmonth\nWHERE Date = '2013-09'\nORDER BY Consumption DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1496": "SELECTSegment, SUM(Consumption) AS TotalConsumption\nFROM yearmonth\nWHERE Date = '2013-09'\nGROUP BY Segment\nORDER BY TotalConsumption\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1497": "SELECTCustomerID, MIN(Consumption)\nFROM yearmonth\nWHERE Date = '2012-06'\nGROUP BY CustomerID\nORDER BY MIN(Consumption)\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1498": "SELECTMAX(Consumption) \nFROM yearmonth \nWHERE Date LIKE '2012%'\t----- bird -----\tdebit_card_specializing",
    "1499": "SELECTMAX(Consumption) \nFROM yearmonth \nJOIN customers ON yearmonth.CustomerID = customers.CustomerID \nWHERE customers.Currency = 'Euro'\t----- bird -----\tdebit_card_specializing",
    "1500": "SELECTproducts.Description\nFROM transactions_1k\nJOIN products ON transactions_1k.ProductID = products.ProductID\nWHERE strftime('%Y-%m', transactions_1k.Date) = '2013-09'\t----- bird -----\tdebit_card_specializing",
    "1501": "SELECTDISTINCT gasstations.Country\nFROM gasstations\nJOIN \"transactions_1k\" ON gasstations.GasStationID = \"transactions_1k\".GasStationID\nWHERE \"transactions_1k\".Date LIKE '2013-06%'\t----- bird -----\tdebit_card_specializing",
    "1502": "SELECT DISTINCT gasstations.ChainID\nFROM gasstations\nJOIN \"transactions_1k\" ON gasstations.GasStationID = \"transactions_1k\".GasStationID\nJOIN customers ON \"transactions_1k\".CustomerID = customers.CustomerID\nWHERE customers.Currency = 'Euro'\t----- bird -----\tdebit_card_specializing",
    "1503": "SELECTproducts.Description\nFROM transactions_1k\nJOIN products ON transactions_1k.ProductID = products.ProductID\nWHERE transactions_1k.Currency = 'Euro'\t----- bird -----\tdebit_card_specializing",
    "1504": "SELECTAVG(Price * Amount) AS AverageTotalPrice\nFROM transactions_1k\nWHERE Date LIKE '2012-01%'\t----- bird -----\tdebit_card_specializing",
    "1505": "SELECTCOUNT(DISTINCT c.CustomerID)\nFROM customers c\nJOIN transactions_1k t ON c.CustomerID = t.CustomerID\nJOIN yearmonth y ON c.CustomerID = y.CustomerID\nWHERE c.Currency = 'Euro'\nAND y.Consumption > 1000\t----- bird -----\tdebit_card_specializing",
    "1506": "SELECTproducts.Description\nFROM transactions_1k\nJOIN gasstations ON transactions_1k.GasStationID = gasstations.GasStationID\nJOIN products ON transactions_1k.ProductID = products.ProductID\nWHERE gasstations.Country = 'Czech Republic'\t----- bird -----\tdebit_card_specializing",
    "1507": "SELECTtransactions_1k.Time\nFROM transactions_1k\nJOIN gasstations ON transactions_1k.GasStationID = gasstations.GasStationID\nWHERE gasstations.ChainID = 11\t----- bird -----\tdebit_card_specializing",
    "1508": "SELECTCOUNT(*)\nFROM transactions_1k t\nJOIN gasstations g ON t.GasStationID = g.GasStationID\nWHERE g.Country = 'Czech Republic' AND t.Price > 1000\t----- bird -----\tdebit_card_specializing",
    "1509": "SELECTCOUNT(*)\nFROM transactions_1k t\nJOIN gasstations g ON t.GasStationID = g.GasStationID\nWHERE g.Country = 'Czech Republic' AND t.Date > '2012-01-01'\t----- bird -----\tdebit_card_specializing",
    "1510": "SELECTAVG(Price) \nFROM transactions_1k \nJOIN gasstations ON transactions_1k.GasStationID = gasstations.GasStationID \nWHERE gasstations.Country = 'Czech Republic'\t----- bird -----\tdebit_card_specializing",
    "1511": "SELECTcustomers.CustomerID, AVG(transactions_1k.Price) AS AvgTotalPrice\nFROM customers\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nWHERE customers.Currency = 'Euro'\nGROUP BY customers.CustomerID\t----- bird -----\tdebit_card_specializing",
    "1512": "SELECTcustomers.CustomerID, SUM(transactions_1k.Amount * transactions_1k.Price) AS TotalPaid\nFROM customers\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nWHERE transactions_1k.Date = '2012-08-25'\nGROUP BY customers.CustomerID\nORDER BY TotalPaid DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1513": "SELECTCountry\nFROM gasstations\nWHERE GasStationID = (\n    SELECT GasStationID\n    FROM transactions_1k\n    WHERE Date = '2012-08-25'\n    ORDER BY TransactionID\n    LIMIT 1\n)\t----- bird -----\tdebit_card_specializing",
    "1514": "SELECTcustomers.Currency\nFROM transactions_1k\nJOIN customers ON transactions_1k.CustomerID = customers.CustomerID\nWHERE transactions_1k.Time = '16:25:00' AND transactions_1k.Date = '2012-08-24'\t----- bird -----\tdebit_card_specializing",
    "1515": "SELECTSegment\nFROM customers\nWHERE CustomerID = (\n    SELECT CustomerID\n    FROM \"yearmonth\"\n    WHERE Date = '2012-08-23 21:20:00'\n)\t----- bird -----\tdebit_card_specializing",
    "1516": "SELECTCOUNT(*)\nFROM transactions_1k\nWHERE Date = '2012-08-26' AND Time < '12:00' AND Currency = 'CZK'\t----- bird -----\tdebit_card_specializing",
    "1517": "SELECTSegment\nFROM customers\nORDER BY CustomerID\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1518": "SELECTCountry\nFROM gasstations\nJOIN transactions_1k ON gasstations.GasStationID = transactions_1k.GasStationID\nWHERE transactions_1k.Date = '2012-08-24' AND transactions_1k.Time = '12:42:00'\t----- bird -----\tdebit_card_specializing",
    "1519": "SELECTProductID\nFROM transactions_1k\nWHERE Date = '2012-08-23' AND Time = '21:20:00'\t----- bird -----\tdebit_card_specializing",
    "1520": "SELECTSUM(Price) AS TotalExpenses\nFROM transactions_1k\nWHERE CustomerID = (SELECT CustomerID FROM customers WHERE CustomerID = 124.05)\nAND Date BETWEEN '2012-01-01' AND '2012-01-31'\t----- bird -----\tdebit_card_specializing",
    "1521": "SELECTCOUNT(*)\nFROM transactions_1k t\nJOIN gasstations g ON t.GasStationID = g.GasStationID\nWHERE t.Date = '2012-08-26' \nAND t.Time >= '08:00' \nAND t.Time < '09:00'\nAND g.Country = 'CZE'\t----- bird -----\tdebit_card_specializing",
    "1522": "SELECTcustomers.Currency\nFROM customers\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nWHERE yearmonth.Date = '2013-06-01' AND transactions_1k.Amount = 214582.17\t----- bird -----\tdebit_card_specializing",
    "1523": "SELECTCountry\nFROM transactions_1k\nJOIN customers ON transactions_1k.CustomerID = customers.CustomerID\nWHERE CardID = 667467\t----- bird -----\tdebit_card_specializing",
    "1524": "SELECTcustomers.Country\nFROM customers\nJOIN \"transactions_1k\" ON customers.CustomerID = \"transactions_1k\".CustomerID\nWHERE \"transactions_1k\".Date = '2012-08-24' AND \"transactions_1k\".Amount = 548.4\t----- bird -----\tdebit_card_specializing",
    "1525": "SELECTCOUNT(DISTINCT CustomerID) * 100.0 / (SELECT COUNT(DISTINCT CustomerID) FROM yearmonth WHERE Date = '2012/8/25' AND Currency = 'EUR') as Percentage\nFROM yearmonth\nWHERE Date = '2012/8/25' AND Currency = 'EUR'\t----- bird -----\tdebit_card_specializing",
    "1526": "SELECTc1.CustomerID,\n       c1.Segment,\n       c1.Currency,\n       ym1.Consumption AS Consumption2012,\n       ym2.Consumption AS Consumption2013,\n       (ym1.Consumption - ym2.Consumption) / ym1.Consumption AS DecreaseRate\nFROM customers c1\nJOIN yearmonth ym1 ON c1.CustomerID = ym1.CustomerID\nJOIN yearmonth ym2 ON c1.CustomerID = ym2.CustomerID\nWHERE ym1.Date = '2012-08'\nAND ym2.Date = '2013-08'\nAND (ym1.Consumption * (SELECT Price FROM transactions_1k WHERE CustomerID = c1.CustomerID AND Date = '2012-08-25')) = 634.8\t----- bird -----\tdebit_card_specializing",
    "1527": "SELECTGasStationID, SUM(Amount * Price) AS Revenue\nFROM transactions_1k\nGROUP BY GasStationID\nORDER BY Revenue DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1528": "SELECT\n    (COUNT(*) * 100.0) / (SELECT COUNT(*) FROM gasstations WHERE Country = \"SVK\") AS PremiumPercentage\nFROM gasstations\nWHERE Country = \"SVK\" AND Segment = \"premium\"\t----- bird -----\tdebit_card_specializing",
    "1529": "SELECTSUM(t.Amount * t.Price) AS TotalSpent\nFROM transactions_1k t\nJOIN customers c ON t.CustomerID = c.CustomerID\nJOIN gasstations g ON t.GasStationID = g.GasStationID\nWHERE c.CustomerID = 38508\t----- bird -----\tdebit_card_specializing",
    "1530": "SELECTproducts.Description, SUM(transactions_1k.Amount) as TotalAmount\nFROM transactions_1k\nJOIN products ON transactions_1k.ProductID = products.ProductID\nGROUP BY products.Description\nORDER BY TotalAmount DESC\nLIMIT 5\t----- bird -----\tdebit_card_specializing",
    "1531": "SELECTcustomers.CustomerID, customers.Currency, SUM(transactions_1k.Price) AS TotalSpent\nFROM customers\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nGROUP BY customers.CustomerID\nORDER BY TotalSpent DESC\nLIMIT 1\t----- bird -----\tdebit_card_specializing",
    "1532": "SELECTCountry\nFROM gasstations\nWHERE GasStationID = (SELECT GasStationID FROM transactions_1k WHERE ProductID = 2 ORDER BY Price DESC LIMIT 1)\t----- bird -----\tdebit_card_specializing",
    "1533": "SELECTcustomers.CustomerID, yearmonth.Consumption\nFROM customers\nJOIN yearmonth ON customers.CustomerID = yearmonth.CustomerID\nJOIN transactions_1k ON customers.CustomerID = transactions_1k.CustomerID\nJOIN products ON transactions_1k.ProductID = products.ProductID\nWHERE products.ProductID = 5\nAND transactions_1k.Price > 29.00\nAND yearmonth.Date = '2012-08'\t----- bird -----\tdebit_card_specializing"
}