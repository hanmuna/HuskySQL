# cp error_analysis/.env.example error_analysis/.env  then fill in your AIML key
# AIML API is OpenAI-compatible; the OpenAI SDK is pointed at AIML's base_url.

OPENAI_API_KEY=your-aiml-api-key
OPENAI_BASE_URL=https://api.aimlapi.com/v1

# GPT-5.2 model id on AIML. Chat-optimized variant by default.
# Alternatives: gpt-5.2-2025-12-11 (reasoning) | gpt-5.2-pro-2025-12-11 (flagship)
OPENAI_MODEL=gpt-5.2-chat-latest
